{
  "version": 1,
  "launch": {
    "command": "npm",
    "args": ["start", "--", "--data-dir", "{dataDir}", "--width", "{width}", "--height", "{height}", "--remote-debugging-port={port}"],
    "cwd": "."
  },
  "mainWindow": { "title": "Nested OS" },
  "bench": {
    "context": "主桌面渲染上下文 window.bench（版本 1）",
    "methods": ["version", "ready()", "reset()", "inspect()"],
    "access": "通过 Electron --remote-debugging-port 提供的 CDP，在主页面执行 window.bench.*"
  },
  "conventions": {
    "systemIds": "根系统为 outer；所有非根实例按全局创建顺序命名 inner-1、inner-2 ...",
    "kernelFile": "每个子系统的内核源文件是父系统文件系统中的普通程序文件，路径为 /Kernels/<实例名>.npl；创建实例时由模板复制生成。可在父系统编辑器中打开修改，重启该实例后生效。",
    "browser": "根系统浏览器为应用窗口内的 <webview>，标签项 data-tab-id；外站内容不添加自制标识。",
    "dataDir": "快照与本机的保存/导入文件写入 --data-dir 指定的目录，不写回源码目录。"
  },
  "fixtures": {
    "outer": {
      "workbook": "/Demo/sample.sheet",
      "chartRange": "A1:D4",
      "helicopter": "/Demo/helicopter-24.scene",
      "documents": "/Documents",
      "downloads": "/Downloads",
      "programs": "/Programs",
      "compiler": "/System/compiler.npl",
      "kernelTemplate": "/Kernels/kernel.npl",
      "wallpapers": "/Wallpapers"
    },
    "inner": {
      "helicopter": "/Demo/helicopter-24.scene",
      "documents": "/Documents",
      "programs": "/Programs",
      "compiler": "/System/compiler.npl",
      "kernelTemplate": "/Kernels/kernel.npl",
      "controller": "/Programs/controller.npl",
      "scene": "/Demo/helicopter-24.scene"
    },
    "programFiles": [
      "/Programs/accumulator.npl",
      "/Programs/sender.npl",
      "/Programs/receiver.npl",
      "/Programs/busy.npl",
      "/Programs/timeline.npl",
      "/Programs/flight.npl",
      "/Programs/effects.npl",
      "/Programs/controller.npl"
    ]
  }
}
