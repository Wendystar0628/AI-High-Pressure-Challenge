;; 默认演出的导演程序（构建时运行一次）：用脚本化的驾驶员驾驶同一套飞行模型，
;; 记录每个控制周期写入的控制量与检查点，生成场景资源中的飞行记录 records.show。
(include "/System/lib/core.nest")
(include "/System/lib/flight.nest")

(var P ARGS.physics)
(var S (new-state P ARGS.init))
(put! S "fault-warn" ARGS.faultWarn) (put! S "fault-at" ARGS.faultAt)
(put! S "wind-x" (nth ARGS.wind 0)) (put! S "wind-z" (nth ARGS.wind 1))
(var H0 ARGS.init.yaw)
(var YI 0)
(defn wrap (a) (- a (* 6.283185307 (floor (/ (+ a 3.14159265) 6.283185307)))))

(defn plan (t)
  ;; 返回 [离地高度 速度 航向]
  (cond ((< t 2.2) [0 0 H0])
        ((< t 4.2) [8 0 H0])
        ((< t ARGS.faultAt) [(+ 8 (* 3 (- t 4.2))) (* 13 (smooth01 (/ (- t 4.2) 2.2))) (- H0 (* ARGS.turn (smooth01 (/ (- t 4.6) 3.2))))])
        (else [-6 8 (- H0 ARGS.turn)])))

(defn pilot (s t)
  (when (< t 2.2) (return {:c 0 :p 0 :r 0 :y 0 :throttle 1}))
  (var pl (plan t))
  (var alt-t (nth pl 0)) (var sp (nth pl 1)) (var head-t (nth pl 2))
  (var vtx (* sp (cos head-t))) (var vtz (* sp (- (sin head-t))))
  (var tilt (max 0.5 (* (cos s.roll) (cos s.pitch))))
  (var hover (/ P.g (* P.thrustMax (max 0.3 (* s.rpm s.rpm)) tilt)))
  (var vyt (clamp (* 0.9 (- alt-t s.alt)) -4 3))
  (var c (clamp (+ hover (* 0.06 (- vyt s.vy))) 0 1))
  (when (>= t ARGS.faultAt) (set! c (* hover ARGS.dropC)))
  (var ax (clamp (* 0.9 (- vtx s.vx)) -4 4)) (var az (clamp (* 0.9 (- vtz s.vz)) -4 4))
  (var h s.heading)
  (var af (- (* ax (cos h)) (* az (sin h)))) (var ar (+ (* ax (sin h)) (* az (cos h))))
  (var p (clamp (- (* 2.8 (- (clamp (/ (- af) P.g) -0.32 0.32) s.pitch)) (* 1.2 s.q)) -1 1))
  (var r (clamp (- (* 2.8 (- (clamp (/ ar P.g) -0.32 0.32) s.roll)) (* 1.2 s.p)) -1 1))
  (when (>= t ARGS.faultAt)
    ;; 尾桨失效后驾驶员失去控制：周期变距大幅、错乱地修正
    (var k (* ARGS.chaos (smooth01 (/ (- t ARGS.faultAt) 0.8))))
    (set! p (clamp (+ (* p (- 1 k)) (* k 0.7 (sin (+ (* 4.3 t) 0.6)))) -1 1))
    (set! r (clamp (+ (* r (- 1 k)) (* k 0.8 (sin (* 3.1 t)))) -1 1)))
  (var e (wrap (- head-t s.heading)))
  (set! YI (clamp (+ YI (* 0.6 e 0.02) (* 0.25 (- s.r) 0.02)) -0.6 0.6))
  (var y (clamp (+ (* 1.1 e) (* -0.9 s.r) YI (* 0.234 c)) -1 1))
  {:c c :p p :r r :y y :throttle 1})

(var controls []) (var checkpoints []) (var path [])
(var ctl nil)
(var N (floor (/ ARGS.duration DT)))
(for (i 0 N)
  (when (= (% i 50) 0) (push! checkpoints [S.t (copy S)]))
  (when (= (% i 2) 0)
    (set! ctl (pilot (sensors S P) S.t))
    (push! controls [S.step (fmt ctl.c 4) (fmt ctl.p 4) (fmt ctl.r 4) (fmt ctl.y 4) ctl.throttle]))
  (step S P ctl)
  (when (= (% i 25) 0) (push! path [(fmt S.t 2) (fmt S.px 1) (fmt S.py 1) (fmt S.pz 1) S.crashed])))
{:controls controls :checkpoints checkpoints :events S.events :path path :impact S.impact}
