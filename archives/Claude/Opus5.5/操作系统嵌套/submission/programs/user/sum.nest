// 累加计算：把 1..N 加起来，分批让出执行权，报告进度。改动 N 后重新运行即可。
function main(args) {
  let N = 200000;
  let total = 0;
  let t0 = sys("time");
  for (let i = 1; i <= N; i++) {
    total = total + i;
    if (i % 20000 == 0) {
      sys("work", N - i);
      sys("print", "已累加到 " + str(i) + "，当前和 " + str(total));
      sys("sleep", 0.05);
    }
  }
  sys("work", 0);
  sys("print", "1 到 " + str(N) + " 的和 = " + str(total) + "（虚拟时间用了 " + fmt(sys("time") - t0, 2) + " 秒）");
  return total;
}
