// 二维图形：按虚拟时间更新柱形和曲线。提交的是绘图指令（可复制的数据），经内核分发到显示设备。
function main(args) {
  for (;;) {
    let t = sys("time");
    let ops = [["clear", "#101426"]];
    for (let i = 0; i < 12; i++) {
      let h = 60 + 50 * sin(t * 1.5 + i * 0.6);
      push(ops, ["rect", 24 + i * 40, 190 - h, 30, h, i % 2 == 0 ? "#f5c542" : "#8f6bff"]);
    }
    let pts = [];
    for (let x = 0; x < 500; x = x + 10) {
      push(pts, x + 10);
      push(pts, 60 + 30 * sin(x * 0.03 + t * 2));
    }
    push(ops, ["polyline", pts, "#6ee7d8", 2]);
    push(ops, ["text", 24, 26, "虚拟时间 " + fmt(t, 2) + " 秒", "#e8ecff", 15]);
    sys("draw", ops);
    sys("sleep", 0.05);
  }
}
