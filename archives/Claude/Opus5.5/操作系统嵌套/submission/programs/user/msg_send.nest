// 消息发送：启动一个接收进程，按顺序发 COUNT 条消息并等待回执。改 COUNT 或内容后重新运行。
const COUNT = 5;
const TEXT = "你好，嵌套系统";
function main(args) {
  let me = sys("self");
  let peer = sys("spawn", "/Programs/msg_recv.nest", null, { inherit_stdout: true, name: "msg_recv", join_group: true });
  if (type(peer) == "map") { sys("print", "启动接收进程失败：" + str(peer.error)); return 1; }
  sys("print", "发送进程 " + str(me.pid) + " → 接收进程 " + str(peer));
  for (let i = 1; i <= COUNT; i++) {
    let payload = { seq: i, text: TEXT, reply: true };
    let r = sys("send", peer, payload);
    payload.text = "发送后被改动";       // 接收方得到的是发送时的值
    sys("print", "发送第 " + str(i) + " 条：" + str(r));
    let ack = sys("recv", 2);
    sys("print", ack == null ? "等待回执超时" : "回执：" + str(ack.data));
  }
  sys("send", peer, "结束");
  sys("sleep", 0.2);
  let gone = sys("send", 999999, "没有这个进程");
  sys("print", "发给不存在的进程：" + str(gone));
  return 0;
}
