// Nest 子系统内核 —— 一份普通的 Nest 程序。
//
// 每个非根系统都由父系统文件 /Systems/<实例>/kernel.nest 里的这份程序运行；它在父系统里是一个
// “承载进程”，受父系统调度。本系统的进程表、调度、等待与唤醒、消息投递、文件系统、系统调用分发、
// 子系统承载全部写在这里。宿主只提供执行环境（vm_* 内建）和显示、输入设备。
//
// 修改方法：在父系统编辑器里打开本文件（kernel-open），改动后保存，重启该子系统即按新逻辑运行。
// 最常改的三个钩子在文件最前面：pick_next（调度策略）、message_filter（消息规则）、
// fs_write_filter（文件行为）；增加系统调用只需在 init_syscalls 里登记一个函数。

// ———————— 可修改的策略 ————————
const STEP_DT = 1 / 60;          // 父系统发起“单步”时给出的固定逻辑时间步（秒）
let QUANTUM_DIV = 2;             // 时间片 = 本系统总预算 / QUANTUM_DIV。越小，持续计算对其他进程的影响越大

// 调度策略：从就绪队列取下一个进程。默认先进先出轮转；唤醒的进程排到队尾。
function pick_next() {
  return shift(RUNQ);
}
function quantum_for(p) {
  let q = floor(CFG.budget / QUANTUM_DIV);
  if (q < 500) q = 500;
  return q;
}
// 消息规则：每条消息投递前经过这里，返回值就是接收方得到的内容。
function message_filter(from, to, data) {
  return data;
}
// 文件行为：写入用户文件前经过这里，返回值就是落盘内容。
function fs_write_filter(path, text) {
  return text;
}

// ———————— 全局状态 ————————
let SELF = null;        // { id, path, name, depth, parent_path, ... } 启动参数
let CFG = {};           // budget / mem / storage / child_* 配置
let VTIME = 0;          // 本系统虚拟时间（秒）
let TICKS = 0;
let PROCS = {};         // pid -> 进程控制块
let NEXT_PID = 1;
let RUNQ = [];          // 就绪队列（pid）
let THROTTLED = [];     // 本步额度已用尽的进程
let SLEEPERS = [];      // 有定时等待的 pid
let DEAD = [];          // 已结束进程（保留一段时间供进程管理器查看）
let SC = {};            // 系统调用表：名字 -> 函数
let HC = {};            // 只有承载进程（直属子系统内核）能用的调用
let BLOCK = { block: true };
let SERVICES = {};      // 服务名 -> pid（窗口管理器等）
let BUS = {};           // 本系统黑板：飞控传感器与舵面等“保持到下一次写入”的数据
let CH = {};            // 直属子系统：id -> 记录
let SURFACES = {};      // 显示面 sid -> 所有者 pid
let VIEWS = {};         // 三维视图 vid -> { pid, bytes }
let NEXT_SURFACE = 1;
let NEXT_WIN = 1;
let PROJECTIONS = {};   // 本系统发出的投送：id -> { target, sid, wid, pid }
let SUBS = {};          // 本系统的实时数据订阅：sub -> pid
let NEXT_SUB = 1;
let JOBS = {};          // 正在进行的编译：src 哈希 -> 任务
let REBUILDING = false; // 编译器正在重建
let IMG_QUEUE = [];
let COMPILER_BAD = "";
let FS_WATCH = {};      // 关注文件变化的 pid
let FS_CHANGED = false;
let AVG = { used: 0, own: 0, user: 0 };
let TICK_T0 = 0;
let TICK_OWN0 = 0;
let XFERS = {};
let NEXT_XFER = 1;
let PENDING_RESTORE = null;
let EVENTS = [];        // 给窗口管理器的系统事件日志（通知来源）

// ———————— 通用小工具 ————————
function k_up(msg) { return sys("up", msg); }
function host(op, msg) { msg.dst = "host"; msg.op = op; msg.sys = SELF.id; return k_up(msg); }
function now_used() { return vm_used(); }
function wm_send(msg) {
  let w = SERVICES.wm;
  if (w == null) return false;
  return do_send(0, w, msg);
}
function log_event(level, text) {
  wm_send({ type: "notify", level: level, text: text, t: VTIME });
}

// ———————— 进程控制 ————————
function enqueue(p) {
  if (p.inq || p.suspended || p.state != "ready") return;
  if (p.child != null) {
    let c = CH[p.child];
    if (c != null && c.paused && !c.stepping) return;
  }
  p.inq = true;
  push(RUNQ, p.pid);
}

function wake(p, v) {
  if (p.state == "exited" || p.state == "fault") return;
  p.wait = null;
  p.wake_at = null;
  vm_resume(p.ctx, v);
  p.state = "ready";
  enqueue(p);
}

function create_process(image, args, opts) {
  let pid = NEXT_PID;
  NEXT_PID = NEXT_PID + 1;
  let vmo = { mem: opts.mem != null ? opts.mem : null, priv: opts.priv == true, seed: pid * 7919 + TICKS };
  let ctx = vm_spawn(image, args, vmo);
  let p = {
    pid: pid, name: opts.name != null ? opts.name : opts.path, path: opts.path, ctx: ctx, state: "ready",
    wait: null, wake_at: null, mq: [], suspended: false, inq: false, kind: opts.kind != null ? opts.kind : "user",
    ppid: opts.ppid != null ? opts.ppid : 0, group: opts.group != null ? opts.group : pid, leader: opts.group == null,
    quota: opts.quota != null ? opts.quota : 0, quota_left: 0, stdout: opts.stdout != null ? opts.stdout : 0,
    child: opts.child, app: opts.app, on_exit: opts.on_exit, exit_data: opts.exit_data,
    used0: 0, tick_used: 0, avg: 0, msgs_in: 0, msgs_out: 0, remaining: 0, error: null, started: VTIME, sleeps: 0
  };
  PROCS[pid] = p;
  enqueue(p);
  return p;
}

function proc_cleanup(p) {
  let pid = p.pid;
  del(FS_WATCH, pid);
  let sids = keys(SURFACES);
  for (let s of sids) {
    if (SURFACES[s] == pid) {
      del(SURFACES, s);
      host("surface_drop", { sid: s });
    }
  }
  let vids = keys(VIEWS);
  for (let v of vids) {
    if (VIEWS[v].pid == pid) {
      del(VIEWS, v);
      host("gfx_close", { vid: v });
    }
  }
  let pj = keys(PROJECTIONS);
  for (let id of pj) {
    let r = PROJECTIONS[id];
    if (r.pid == pid) {
      route({ dst: r.target, op: "proj_close", id: id, reason: "源窗口已关闭" });
      host("proj_unreg", { id: id });
      del(PROJECTIONS, id);
    }
  }
  let sb = keys(SUBS);
  for (let s of sb) {
    if (SUBS[s] == pid) {
      route({ dst: "outer", op: "data_disconnect", sub: s });
      del(SUBS, s);
    }
  }
}

function proc_end(p, state, value, err) {
  if (p.state == "exited" || p.state == "fault") return;
  p.state = state;
  p.error = err;
  p.exit_value = null;
  p.final_used = vm_stat(p.ctx)[0];
  p.final_own = vm_stat(p.ctx)[1];
  vm_kill(p.ctx);
  p.ctx = null;
  p.mq = [];
  p.inq = false;
  proc_cleanup(p);
  push(DEAD, p.pid);
  if (len(DEAD) > 24) {
    let old = shift(DEAD);
    del(PROCS, old);
  }
  if (p.leader && p.child == null) {
    // 协作进程跟随应用一起结束
    let ids = keys(PROCS);
    for (let k of ids) {
      let q = PROCS[k];
      if (q.group == p.pid && q.pid != p.pid && q.ctx != null) kill_process(q, "所属应用已结束");
    }
  }
  if (p.child != null) child_on_exit(CH[p.child], state, err);
  if (p.on_exit != null) { let f = p.on_exit; f(p.exit_data, value, err); }
  // 等待它结束的进程
  let ids = keys(PROCS);
  for (let k of ids) {
    let q = PROCS[k];
    if (q.wait == "proc" && q.wait_pid == p.pid) wake(q, { state: state, value: value, error: err });
  }
  wm_send({ type: "proc_exit", pid: p.pid, state: state, error: err, name: p.name });
  if (state == "fault") log_event("error", "进程 " + p.name + " 异常：" + str(err));
  if (p.stdout != 0) {
    do_send(0, p.stdout, { type: "proc_end", pid: p.pid, state: state, error: err, value: value });
  }
}
function kill_process(p, reason) { proc_end(p, "exited", null, reason); }

// 运行一个进程至多 n 单位。系统调用在同一时间片内就地处理。
function run_proc(p, n) {
  p.state = "running";
  p.inq = false;
  let remain = n;
  while (remain > 0) {
    let r = vm_run(p.ctx, remain);
    let st = r[0], paid = r[3];
    p.tick_used = p.tick_used + paid;
    p.quota_left = p.quota_left - paid;
    remain = remain - paid;
    if (st == 0) {
      if (paid == 0) break;
      continue;
    }
    if (st == 1) {
      let name = r[1], args = r[2], h = null;
      if (p.child != null) h = HC[name];
      if (h == null) h = SC[name];
      let res = null;
      if (h == null) {
        res = { error: "ENOSYS: 没有这个系统调用 " + str(name) };
      } else {
        try {
          res = h(p, args);
        } catch (e) {
          res = { error: "系统调用 " + str(name) + " 失败：" + str(e) };
        }
      }
      if (res == BLOCK) return;
      if (p.ctx == null || p.state != "running") return;
      try {
        vm_resume(p.ctx, res);
      } catch (e) {
        proc_end(p, "fault", null, str(e));
        return;
      }
      continue;
    }
    if (st == 2) { proc_end(p, "exited", r[1], null); return; }
    proc_end(p, "fault", null, r[1]);
    return;
  }
  if (p.state == "running") {
    p.state = "ready";
    enqueue(p);
  }
}

// 一个逻辑步的调度循环：内核自己的指令也计入预算
function schedule() {
  let cap = CFG.budget;
  while (len(RUNQ) > 0) {
    let rem = cap - (now_used() - TICK_T0);
    if (rem <= 0) break;
    let pid = pick_next();
    let p = PROCS[pid];
    if (p == null) continue;
    p.inq = false;
    if (p.state != "ready" || p.suspended) continue;
    if (p.child != null) {
      let c = CH[p.child];
      if (c != null && c.paused && !c.stepping) continue;
    }
    let q = quantum_for(p);
    if (p.quota > 0) {
      if (p.quota_left <= 0) { push(THROTTLED, pid); continue; }
      if (q > p.quota_left) q = p.quota_left;
    }
    if (q > rem) q = rem;
    run_proc(p, q);
  }
  while (len(THROTTLED) > 0) {
    let p = PROCS[pop(THROTTLED)];
    if (p != null && p.state == "ready") enqueue(p);
  }
}

// 每个逻辑步开始：推进时钟、处理父系统交下来的事务、唤醒到期等待
function on_tick(t) {
  let dt = t.dt;
  VTIME = VTIME + dt;
  TICKS = TICKS + 1;
  TICK_T0 = now_used();
  let selfnow = vm_self();
  TICK_OWN0 = selfnow[1];
  let box = t.inbox;
  if (box != null) {
    for (let m of box) local_or_route(m);
  }
  // 配额重置与统计
  let ids = keys(PROCS);
  for (let k of ids) {
    let p = PROCS[k];
    p.quota_left = p.quota;
    p.avg = p.avg + (p.tick_used - p.avg) * 0.05;
    p.tick_used = 0;
  }
  // 直属子系统：时间按“父系统逻辑时间 × 自身速率”推进
  let cids = keys(CH);
  for (let k of cids) {
    let c = CH[k];
    if (c.state == "stopped" || c.state == "error" || c.pid == 0) continue;
    if (c.step_req > 0 && c.paused) {
      c.step_req = c.step_req - 1;
      c.stepping = true;
      c.pending_dt = c.pending_dt + STEP_DT * c.rate;
    } else if (!c.paused) {
      c.pending_dt = c.pending_dt + dt * c.rate;
    }
    let p = PROCS[c.pid];
    if (p != null) {
      if (p.state == "waiting" && p.wait == "tick" && c.pending_dt > 0 && (!c.paused || c.stepping) && !p.suspended) {
        wake(p, take_tick(c));
      } else {
        enqueue(p);
      }
    }
  }
  // 定时等待
  if (len(SLEEPERS) > 0) {
    let keep = [];
    for (let pid of SLEEPERS) {
      let p = PROCS[pid];
      if (p == null || p.wake_at == null) continue;
      if (p.wake_at <= VTIME && !p.suspended) {
        p.wake_at = null;
        wake(p, null);
      } else keep = keep_push(keep, pid);
    }
    SLEEPERS = keep;
  }
}
function keep_push(a, v) { push(a, v); return a; }

function take_tick(c) {
  let r = { dt: c.pending_dt, inbox: c.inbox };
  c.pending_dt = 0;
  c.inbox = [];
  return r;
}

function end_tick() {
  let cids = keys(CH);
  for (let k of cids) { CH[k].stepping = false; }
  let used = now_used() - TICK_T0;
  let selfnow = vm_self();
  let own = selfnow[1] - TICK_OWN0;
  AVG.used = AVG.used + (used - AVG.used) * 0.05;
  AVG.own = AVG.own + (own - AVG.own) * 0.05;
  if (FS.dirty) fs_flush_super();
  if (FS_CHANGED) {
    FS_CHANGED = false;
    let w = keys(FS_WATCH);
    for (let k of w) do_send(0, num(k), { type: "fs_changed" });
  }
}

// ———————— 消息 ————————
function do_send(from, to, data) {
  let t = PROCS[to];
  if (t == null || t.state == "exited" || t.state == "fault") return false;
  let m = { from: from, data: message_filter(from, to, data), t: VTIME };
  t.msgs_in = t.msgs_in + 1;
  if (t.state == "waiting" && t.wait == "recv" && !t.suspended) {
    wake(t, m);
    return true;
  }
  if (len(t.mq) >= 8192) return false;
  push(t.mq, m);
  return true;
}

function sc_send(p, a) {
  let ok = do_send(p.pid, a[0], a[1]);
  p.msgs_out = p.msgs_out + 1;
  if (ok) return true;
  return { error: "ENOPROC: 目标进程 " + str(a[0]) + " 不存在或已结束" };
}
function sc_recv(p, a) {
  if (len(p.mq) > 0) return shift(p.mq);
  let timeout = a[0];
  if (timeout != null) {
    if (timeout <= 0) return null;
    p.wake_at = VTIME + timeout;
    push(SLEEPERS, p.pid);
  }
  p.state = "waiting";
  p.wait = "recv";
  return BLOCK;
}
function sc_sleep(p, a) {
  let d = a[0];
  if (d == null || d < 0) d = 0;
  p.wake_at = VTIME + d;
  p.sleeps = p.sleeps + 1;
  push(SLEEPERS, p.pid);
  p.state = "waiting";
  p.wait = "sleep";
  return BLOCK;
}

// ———————— 文件系统：目录树写在内核里，文件内容经父系统接口落在父系统文件中 ————————
let FS = { inodes: {}, next: 2, used: 0, dirty: false };

function fs_new() {
  FS = { inodes: {}, next: 2, used: 0, dirty: true };
  FS.inodes["1"] = { t: "d", n: "", p: "0", e: {}, s: 0, m: 0 };
}
function fs_mount() {
  let s = sys("disk_get", "super");
  if (type(s) != "string") { fs_new(); return true; }
  let d = json_parse(s);
  FS = { inodes: d.inodes, next: d.next, used: d.used, dirty: false };
  return false;
}
function fs_flush_super() {
  FS.dirty = false;
  sys("disk_put", "super", json_str({ inodes: FS.inodes, next: FS.next, used: FS.used }));
}
function path_parts(path) {
  let raw = split(path, "/");
  let out = [];
  for (let x of raw) {
    if (x == "" || x == ".") continue;
    if (x == "..") { pop(out); continue; }
    push(out, x);
  }
  return out;
}
function fs_lookup(path) {
  let parts = path_parts(path);
  let cur = "1";
  for (let x of parts) {
    let n = FS.inodes[cur];
    if (n == null || n.t != "d") return null;
    cur = n.e[x];
    if (cur == null) return null;
  }
  return cur;
}
function fs_mkdirs(path) {
  let parts = path_parts(path);
  let cur = "1";
  for (let x of parts) {
    let n = FS.inodes[cur];
    if (n.t != "d") return null;
    let c = n.e[x];
    if (c == null) {
      c = str(FS.next);
      FS.next = FS.next + 1;
      FS.inodes[c] = { t: "d", n: x, p: cur, e: {}, s: 0, m: VTIME };
      n.e[x] = c;
      FS.dirty = true;
      note_fs_change(path);
    }
    cur = c;
  }
  return cur;
}
function note_fs_change(path) {
  if (!starts_with(path, "/Systems/")) FS_CHANGED = true;
}
function dirname(path) {
  let parts = path_parts(path);
  pop(parts);
  return "/" + join(parts, "/");
}
function basename(path) {
  let parts = path_parts(path);
  return len(parts) > 0 ? parts[len(parts) - 1] : "";
}
function fs_read_raw(path) {
  let i = fs_lookup(path);
  if (i == null) return null;
  let n = FS.inodes[i];
  if (n.t != "f") return null;
  let d = sys("disk_get", i);
  return type(d) == "string" ? d : "";
}
function fs_write_raw(path, text) {
  let t = type(text) == "string" ? text : json_str(text);
  let i = fs_lookup(path);
  let old = 0;
  if (i != null) {
    if (FS.inodes[i].t != "f") return { error: "EISDIR: 目标是目录 " + path };
    old = FS.inodes[i].s;
  }
  if (FS.used - old + len(t) > CFG.storage) {
    return { error: "ENOSPC: 存储配额不足（" + SELF.id + " 上限 " + str(floor(CFG.storage / 1024)) + " KB）" };
  }
  if (i == null) {
    let d = fs_mkdirs(dirname(path));
    if (d == null) return { error: "ENOTDIR: " + path };
    i = str(FS.next);
    FS.next = FS.next + 1;
    let name = basename(path);
    FS.inodes[i] = { t: "f", n: name, p: d, s: 0, m: VTIME };
    FS.inodes[d].e[name] = i;
  }
  let r = sys("disk_put", i, t);
  if (type(r) == "map" && r.error != null) {
    if (old == 0 && FS.inodes[i].s == 0) fs_unlink_entry(i);
    return r;
  }
  FS.used = FS.used - old + len(t);
  FS.inodes[i].s = len(t);
  FS.inodes[i].m = VTIME;
  FS.dirty = true;
  note_fs_change(path);
  return true;
}
function fs_unlink_entry(i) {
  let n = FS.inodes[i];
  let parent = FS.inodes[n.p];
  if (parent != null) del(parent.e, n.n);
  del(FS.inodes, i);
  FS.dirty = true;
}
function fs_delete_ino(i) {
  let n = FS.inodes[i];
  if (n.t == "d") {
    let names = keys(n.e);
    for (let x of names) fs_delete_ino(n.e[x]);
  } else {
    FS.used = FS.used - n.s;
    sys("disk_del", i);
  }
  fs_unlink_entry(i);
}
function fs_delete(path) {
  let i = fs_lookup(path);
  if (i == null) return { error: "ENOENT: " + path };
  if (i == "1") return { error: "EPERM: 不能删除根目录" };
  fs_delete_ino(i);
  note_fs_change(path);
  return true;
}
function fs_list(path) {
  let i = fs_lookup(path);
  if (i == null) return { error: "ENOENT: " + path };
  let n = FS.inodes[i];
  if (n.t != "d") return { error: "ENOTDIR: " + path };
  let names = keys(n.e);
  sort_str(names);
  let dirs = [], files = [];
  let base = path == "/" ? "/" : path + "/";
  for (let x of names) {
    let c = FS.inodes[n.e[x]];
    let e = { name: x, type: c.t == "d" ? "dir" : "file", size: c.s, mtime: c.m, path: base + x };
    if (c.t == "d") push(dirs, e); else push(files, e);
  }
  return concat(dirs, files);
}
function fs_rename(a, b) {
  let i = fs_lookup(a);
  if (i == null) return { error: "ENOENT: " + a };
  if (fs_lookup(b) != null) return { error: "EEXIST: 目标已存在 " + b };
  if (starts_with(b + "/", a + "/")) return { error: "EINVAL: 不能移动到自身内部" };
  let d = fs_mkdirs(dirname(b));
  let n = FS.inodes[i];
  del(FS.inodes[n.p].e, n.n);
  n.n = basename(b);
  n.p = d;
  FS.inodes[d].e[n.n] = i;
  FS.dirty = true;
  note_fs_change(a);
  note_fs_change(b);
  return true;
}
function fs_copy(a, b) {
  let i = fs_lookup(a);
  if (i == null) return { error: "ENOENT: " + a };
  let n = FS.inodes[i];
  if (n.t == "f") return fs_write_raw(b, fs_read_raw(a));
  fs_mkdirs(b);
  let names = keys(n.e);
  for (let x of names) {
    let r = fs_copy(a + "/" + x, b + "/" + x);
    if (r != true) return r;
  }
  return true;
}
// 递归取出一棵目录的全部文件（快照使用，规模按读取内容计费）
function fs_walk(path, base, out) {
  let i = fs_lookup(path);
  if (i == null) return out;
  let n = FS.inodes[i];
  if (n.t == "f") { push(out, [base, fs_read_raw(path)]); return out; }
  if (base != "") push(out, [base, null]);
  let names = keys(n.e);
  sort_str(names);
  for (let x of names) fs_walk(path + "/" + x, base + "/" + x, out);
  return out;
}

function sc_fs_read(p, a) {
  let t = fs_read_raw(a[0]);
  if (t == null) return { error: "ENOENT: 文件不存在 " + str(a[0]) };
  return t;
}
function sc_fs_write(p, a) {
  let path = a[0];
  let text = type(a[1]) == "string" ? a[1] : json_str(a[1]);
  return fs_write_raw(path, fs_write_filter(path, text));
}
function sc_fs_append(p, a) {
  let t = fs_read_raw(a[0]);
  if (t == null) t = "";
  return fs_write_raw(a[0], t + str(a[1]));
}
function sc_fs_list(p, a) { return fs_list(a[0]); }
function sc_fs_stat(p, a) {
  let i = fs_lookup(a[0]);
  if (i == null) return null;
  let n = FS.inodes[i];
  return { name: n.n, type: n.t == "d" ? "dir" : "file", size: n.s, mtime: n.m, path: a[0] };
}
function sc_fs_mkdir(p, a) {
  let r = fs_mkdirs(a[0]);
  return r == null ? { error: "ENOTDIR: " + str(a[0]) } : true;
}
function sc_fs_delete(p, a) { return fs_delete(a[0]); }
function sc_fs_rename(p, a) { return fs_rename(a[0], a[1]); }
function sc_fs_copy(p, a) { return fs_copy(a[0], a[1]); }
function sc_fs_watch(p, a) { FS_WATCH[p.pid] = true; return true; }

// ———————— 载入程序：编译器是系统内的进程 ————————
function nbc_header(text) {
  let i = index_of(text, "\n", 0);
  if (i < 0) return null;
  try { return json_parse(substr(text, 0, i)); } catch (e) { return null; }
}
function deps_ok(h) {
  let d = h.deps;
  for (let i = 1; i < len(d); i++) {
    let t = fs_read_raw(d[i][0]);
    if (t == null || hash(t) != d[i][1]) return false;
  }
  return true;
}
// 取得可执行映像。命中缓存时立即回调；否则启动编译器进程，完成后回调 cb(data, image, error)。
function request_image(path, cb, data) {
  if (REBUILDING) { push(IMG_QUEUE, [path, cb, data]); return; }
  let src = fs_read_raw(path);
  if (src == null) { cb(data, null, "找不到文件 " + path); return; }
  let ctext = fs_read_raw("/System/bin/compiler.nbc");
  if (ctext == null) { cb(data, null, "系统缺少编译器 /System/bin/compiler.nbc"); return; }
  let csrc = fs_read_raw("/System/compiler.nest");
  if (csrc != null) {
    let ch = hash(csrc);
    let hd = nbc_header(ctext);
    if (hd != null && ch != hd.deps[0][1] && ch != COMPILER_BAD) {
      // 编译器源码被改过：先用现有编译器编译它自己，新编译器用于此后启动的程序
      REBUILDING = true;
      push(IMG_QUEUE, [path, cb, data]);
      start_compile("/System/compiler.nest", ctext, "", on_compiler_built, ch);
      return;
    }
  }
  let cid = hash(ctext);
  let key = hash(src);
  let bin_path = "/System/bin/" + key + ".nbc";
  let bin = fs_read_raw(bin_path);
  if (bin != null) {
    let h = nbc_header(bin);
    if (h != null && h.compiler == cid && deps_ok(h)) {
      let im = null;
      let e = null;
      try { im = vm_load(bin); } catch (x) { e = str(x); }
      cb(data, im, e);
      return;
    }
  }
  let job = JOBS[key];
  if (job != null) { push(job.waiters, [cb, data]); return; }
  job = { key: key, path: path, waiters: [[cb, data]], bin: bin_path };
  JOBS[key] = job;
  start_compile(path, ctext, cid, on_compiled, job);
}
function start_compile(path, ctext, cid, cb, data) {
  let im = vm_load(ctext);
  create_process(im, { path: path, compiler_id: cid }, {
    name: "编译器 " + basename(path), path: "/System/compiler.nest", kind: "system", on_exit: cb, exit_data: data
  });
}
function on_compiled(job, value, err) {
  del(JOBS, job.key);
  let im = null;
  let e = err;
  if (value != null && value.ok) {
    let w = fs_write_raw(job.bin, value.text);
    if (w != true) e = w.error;
    else {
      try { im = vm_load(value.text); } catch (x) { e = str(x); }
    }
  } else if (value != null) {
    e = value.error;
  } else if (e == null) e = "编译器被结束";
  for (let w of job.waiters) { let f = w[0]; f(w[1], im, e); }
}
function on_compiler_built(ch, value, err) {
  REBUILDING = false;
  if (value != null && value.ok) {
    fs_write_raw("/System/bin/compiler.nbc", value.text);
    log_event("info", "编译器已用新的源文件重新编译，后续启动的程序使用新编译器");
  } else {
    COMPILER_BAD = ch;
    let msg = value != null ? value.error : err;
    log_event("error", "编译器源文件编译失败，继续使用现有编译器：" + str(msg));
  }
  let q = IMG_QUEUE;
  IMG_QUEUE = [];
  for (let e of q) request_image(e[0], e[1], e[2]);
}

// spawn(路径, 参数, 选项)：调用方阻塞到程序载入完成，返回 pid 或 { error }
function on_spawn_ready(d, image, err) {
  let caller = d.caller != 0 ? PROCS[d.caller] : null;
  let res = null;
  if (image == null) {
    res = { error: "编译失败：" + str(err) };
  } else {
    try {
      let p = create_process(image, d.args, d.opts);
      res = p.pid;
    } catch (e) {
      res = { error: str(e) };
    }
  }
  if (caller != null && caller.wait == "spawn") wake(caller, res);
  else if (type(res) == "map") log_event("error", "启动 " + str(d.opts.path) + " 失败：" + str(res.error));
}
function sc_spawn(p, a) {
  let path = a[0];
  let o = a[2] != null ? a[2] : {};
  let opts = {
    path: path, name: o.name != null ? o.name : basename(path), ppid: p.pid, kind: o.kind != null ? o.kind : "user",
    stdout: o.stdout != null ? o.stdout : (o.inherit_stdout == true ? p.stdout : 0),
    group: o.join_group == true ? p.group : null, app: o.app, quota: o.quota, mem: o.mem
  };
  p.state = "waiting";
  p.wait = "spawn";
  request_image(path, on_spawn_ready, { caller: p.pid, args: a[1], opts: opts });
  return BLOCK;
}
// 只编译不启动：编辑器“编译”按钮和编译器自编译使用
function on_compile_only(d, image, err) {
  let caller = PROCS[d.caller];
  if (caller != null && caller.wait == "spawn") wake(caller, image != null ? true : { error: str(err) });
}
function sc_compile(p, a) {
  p.state = "waiting";
  p.wait = "spawn";
  request_image(a[0], on_compile_only, { caller: p.pid });
  return BLOCK;
}
function sc_exit(p, a) { proc_end(p, "exited", a[0], null); return BLOCK; }
function sc_kill(p, a) {
  let t = PROCS[a[0]];
  if (t == null || t.ctx == null) return { error: "ENOPROC: 进程不存在" };
  if (t.child != null) { child_stop(CH[t.child], "承载进程被结束"); return true; }
  kill_process(t, "被进程 " + str(p.pid) + " 结束");
  return true;
}
function sc_suspend(p, a) {
  let t = PROCS[a[0]];
  if (t == null || t.ctx == null) return { error: "ENOPROC: 进程不存在" };
  t.suspended = true;
  if (t.child != null) { child_set_state(CH[t.child], "paused"); CH[t.child].paused = true; }
  return true;
}
function sc_resume(p, a) {
  let t = PROCS[a[0]];
  if (t == null || t.ctx == null) return { error: "ENOPROC: 进程不存在" };
  t.suspended = false;
  if (t.child != null) { CH[t.child].paused = false; child_set_state(CH[t.child], "running"); }
  // 挂起期间到期的等待在继续后生效；已到达的消息按顺序处理
  if (t.wait == "recv" && len(t.mq) > 0) { wake(t, shift(t.mq)); return true; }
  if (t.wake_at != null && t.wake_at <= VTIME) { wake(t, null); return true; }
  enqueue(t);
  return true;
}
function sc_set_quota(p, a) {
  let t = PROCS[a[0]];
  if (t == null) return { error: "ENOPROC: 进程不存在" };
  t.quota = a[1];
  t.quota_left = a[1];
  if (t.child != null) CH[t.child].grant = a[1];
  return true;
}
function sc_wait_proc(p, a) {
  let t = PROCS[a[0]];
  if (t == null || t.ctx == null) return { state: "exited" };
  p.state = "waiting";
  p.wait = "proc";
  p.wait_pid = a[0];
  return BLOCK;
}
function sc_proc_state(p, a) {
  let t = PROCS[a[0]];
  if (t == null) return "gone";
  return t.suspended ? "suspended" : t.state;
}
function proc_row(p) {
  let st = p.ctx != null ? vm_stat(p.ctx) : [p.final_used, p.final_own, 0, 0, 0];
  let remaining = p.remaining + st[3];
  return {
    pid: p.pid, ppid: p.ppid, name: p.name, path: p.path, kind: p.kind, app: p.app,
    state: p.suspended && p.ctx != null ? "suspended" : p.state, wait: p.wait,
    used: st[0], own: st[1], mem: st[2], debt: st[3], remaining: remaining, avg: floor(p.avg),
    quota: p.quota, mq: len(p.mq), msgs_in: p.msgs_in, msgs_out: p.msgs_out, error: p.error,
    child: p.child, where: p.ctx != null && p.state != "running" ? vm_where(p.ctx) : ""
  };
}
function sc_proc_list(p, a) {
  let out = [];
  let ids = keys(PROCS);
  for (let k of ids) push(out, proc_row(PROCS[k]));
  return out;
}
function sc_stats(p, a) {
  let me = vm_self();
  return {
    id: SELF.id, name: SELF.name, path: SELF.path, depth: SELF.depth, vtime: VTIME, ticks: TICKS,
    budget: CFG.budget, used_avg: floor(AVG.used), own_avg: floor(AVG.own), runq: len(RUNQ),
    mem_used: me[2], mem_limit: CFG.mem, mem_eff: me[5], storage_used: FS.used, storage_limit: CFG.storage,
    kernel_total: me[0], kernel_own: me[1], debt: me[3], procs: len(PROCS), step: STEP_DT
  };
}
function sc_set_config(p, a) {
  let c = a[0];
  if (c.budget != null && c.budget > 0) CFG.budget = c.budget;
  if (c.mem != null && c.mem > 0) { CFG.mem = c.mem; }
  if (c.storage != null && c.storage > 0) CFG.storage = c.storage;
  return true;
}
function sc_work(p, a) { p.remaining = a[0] != null ? a[0] : 0; return true; }

// ———————— 输出与显示：提交经本内核分发，再逐级向上交给显示设备 ————————
function sc_print(p, a) {
  let t = a[0];
  if (p.stdout != 0) do_send(p.pid, p.stdout, { type: "print", pid: p.pid, name: p.name, text: type(t) == "string" ? t : json_str(t) });
  return true;
}
function sc_draw(p, a) {
  if (p.stdout != 0) do_send(p.pid, p.stdout, { type: "draw", pid: p.pid, ops: a[0] });
  return true;
}
function sc_scene(p, a) {
  if (p.stdout != 0) do_send(p.pid, p.stdout, { type: "scene", pid: p.pid, text: a[0], frame: a[1] });
  return true;
}
function sc_scene_frame(p, a) {
  if (p.stdout != 0) do_send(p.pid, p.stdout, { type: "scene_frame", pid: p.pid, frame: a[0] });
  return true;
}
function sc_surface_new(p, a) {
  let sid = "s" + str(NEXT_SURFACE);
  NEXT_SURFACE = NEXT_SURFACE + 1;
  SURFACES[sid] = p.pid;
  return sid;
}
function sc_ui(p, a) {
  let sid = a[0];
  if (SURFACES[sid] != p.pid && sid != "root") return { error: "EPERM: 不是这个显示面的所有者" };
  return host("ui", { sid: sid, tree: a[1] });
}
function sc_ui_patch(p, a) {
  let sid = a[0];
  if (SURFACES[sid] != p.pid && sid != "root") return { error: "EPERM: 不是这个显示面的所有者" };
  return host("ui_patch", { sid: sid, key: a[1], props: a[2] });
}
function sc_ui_focus(p, a) { return host("ui_focus", { sid: a[0], key: a[1] }); }
function sc_meta(p, a) { return host("meta", { kind: a[0], data: a[1] }); }
function sc_gfx_open(p, a) {
  let vid = a[0], text = a[1];
  let bytes = len(text);
  let old = VIEWS[vid];
  if (old != null) { vm_ext_mem(p.ctx, -old.bytes); }
  if (!vm_ext_mem(p.ctx, bytes)) {
    if (old != null) { del(VIEWS, vid); host("gfx_close", { vid: vid }); }
    return { error: "ENOMEM: 内存配额不足，无法把场景载入显示设备" };
  }
  VIEWS[vid] = { pid: p.pid, bytes: bytes };
  let r = host("gfx_open", { vid: vid, text: text, fx_limit: a[2] });
  if (type(r) == "map" && r.error != null) {
    vm_ext_mem(p.ctx, -bytes);
    del(VIEWS, vid);
  }
  return r;
}
// 同一应用的协作进程共用显示面和视图
function same_group(owner, p) {
  if (owner == p.pid) return true;
  let o = PROCS[owner];
  return o != null && o.group == p.group;
}
function sc_gfx_frame(p, a) {
  let v = VIEWS[a[0]];
  if (v == null || !same_group(v.pid, p)) return { error: "ENOVIEW: 视图未载入 " + str(a[0]) };
  return host("gfx_frame", { vid: a[0], frame: a[1], meta: a[2] });
}
function sc_gfx_close(p, a) {
  let v = VIEWS[a[0]];
  if (v != null && same_group(v.pid, p)) {
    let owner = PROCS[v.pid];
    if (owner != null && owner.ctx != null) vm_ext_mem(owner.ctx, -v.bytes);
    del(VIEWS, a[0]);
    host("gfx_close", { vid: a[0] });
  }
  return true;
}
function sc_gfx_pick(p, a) { return host("gfx_pick", { vid: a[0], x: a[1], y: a[2] }); }

// 窗口：内核分配身份，窗口次序、焦点、命中判断都在窗口管理器进程里
function sc_win_open(p, a) {
  let o = a[0];
  let wid = SELF.id + ":w" + str(NEXT_WIN);
  NEXT_WIN = NEXT_WIN + 1;
  let sid = sc_surface_new(p, a);
  wm_send({ type: "win_open", wid: wid, sid: sid, pid: p.pid, title: o.title, app: o.app, w: o.w, h: o.h, x: o.x, y: o.y, icon: o.icon, max: o.max });
  return { wid: wid, sid: sid };
}
function sc_win_set(p, a) { wm_send({ type: "win_set", wid: a[0], props: a[1], pid: p.pid }); return true; }
function sc_win_close(p, a) { wm_send({ type: "win_close", wid: a[0], pid: p.pid }); return true; }
function sc_service_set(p, a) { SERVICES[a[0]] = p.pid; return true; }
function sc_service_get(p, a) { return SERVICES[a[0]]; }
function sc_self(p, a) { return { pid: p.pid, system: SELF.id, path: SELF.path, depth: SELF.depth, name: SELF.name, ppid: p.ppid, group: p.group }; }
function sc_time(p, a) { return VTIME; }
function sc_bus_write(p, a) { BUS[a[0]] = { t: VTIME, v: a[1] }; return true; }
function sc_bus_read(p, a) {
  let e = BUS[a[0]];
  return e == null ? null : e.v;
}
function sc_ancestors(p, a) {
  let parts = split(SELF.path, "/");
  let out = [];
  let cur = "";
  for (let i = 0; i < len(parts) - 1; i++) {
    cur = cur == "" ? parts[i] : cur + "/" + parts[i];
    push(out, { id: parts[i], path: cur, level: i + 1 });
  }
  return out;
}
function sc_notify(p, a) { log_event(a[1] != null ? a[1] : "info", a[0]); return true; }
function sc_focus_parent(p, a) { route({ dst: SELF.parent_path, op: "focus_child_parent", child: SELF.id }); return true; }

// ———————— 跨层路由：消息带目标系统路径，按树逐级转发 ————————
function route(msg) {
  let d = msg.dst;
  if (d == "host") return k_up(msg);
  if (d == SELF.path) return local_op(msg);
  if (starts_with(d, SELF.path + "/")) {
    let rest = substr(d, len(SELF.path) + 1);
    let i = index_of(rest, "/", 0);
    let next = i < 0 ? rest : substr(rest, 0, i);
    let c = CH[next];
    if (c == null) return { error: "ENOSYS: 没有实例 " + next };
    push(c.inbox, msg);
    return true;
  }
  return k_up(msg);
}
function local_or_route(m) {
  if (m.dst != null && m.dst != SELF.path) { route(m); return; }
  local_op(m);
}
// 发给本系统的跨层事务
function local_op(m) {
  let op = m.op;
  if (op == "input") {
    wm_send({ type: "input", ev: m.ev });
  } else if (op == "resize") {
    wm_send({ type: "desk_resize", w: m.w, h: m.h });
  } else if (op == "deliver") {
    do_send(0, m.pid, m.data);
  } else if (op == "proj_open" || op == "proj_close" || op == "proj_focus") {
    wm_send({ type: op, proj: m.proj, id: m.id, reason: m.reason });
  } else if (op == "proj_input" || op == "proj_resize" || op == "proj_closed") {
    let owner = SURFACES[m.sid];
    if (owner != null) do_send(0, owner, { type: op, sid: m.sid, ev: m.ev, w: m.w, h: m.h, id: m.id });
    if (op == "proj_closed") {
      del(PROJECTIONS, m.id);
      host("proj_unreg", { id: m.id });
    }
  } else if (op == "value") {
    wm_send({ type: "value_in", sid: m.sid, key: m.key, value: m.value });
  } else if (op == "xfer_start") {
    xfer_start(m);
  } else if (op == "xfer_data") {
    xfer_data(m);
  } else if (op == "xfer_result") {
    log_event(m.ok ? "info" : "error", m.text);
  } else if (op == "notify") {
    log_event(m.level, m.text);
  } else if (op == "focus_child_parent") {
    wm_send({ type: "focus_self" });
  } else if (op == "cfg") {
    sc_set_config(null, [m.cfg]);
  } else if (op == "host_file") {
    do_send(0, m.pid, { type: "host_file", name: m.name, text: m.text, error: m.error, tag: m.tag });
  } else if (op == "restored") {
    on_restored(m);
  } else if (op == "ping") {
    return true;
  }
  return true;
}

// ———————— 文件跨层传递：经两端系统接口，目标得到独立副本 ————————
function xfer_start(m) {
  let results = [];
  for (let p of m.paths) {
    let t = fs_read_raw(p);
    if (t == null) {
      let st = fs_lookup(p);
      if (st == null) { route({ dst: m.reply, op: "xfer_result", ok: false, text: "源文件不存在：" + p }); continue; }
      route({ dst: m.reply, op: "xfer_result", ok: false, text: "暂不支持传递目录：" + p });
      continue;
    }
    route({ dst: m.target, op: "xfer_data", dir: m.dir, name: basename(p), text: t, from: SELF.id, from_path: p, overwrite: m.overwrite == true, reply: m.reply, move: m.move });
  }
}
function xfer_data(m) {
  let dest = (m.dir == "/" ? "" : m.dir) + "/" + m.name;
  if (fs_lookup(dest) != null && !m.overwrite) {
    let id = "x" + str(NEXT_XFER);
    NEXT_XFER = NEXT_XFER + 1;
    XFERS[id] = m;
    wm_send({ type: "xfer_conflict", id: id, name: m.name, dir: m.dir, from: m.from });
    return;
  }
  xfer_commit(m, dest);
}
function xfer_commit(m, dest) {
  let r = fs_write_raw(dest, m.text);
  if (r == true) {
    log_event("info", "已从 " + m.from + " 接收文件 " + dest);
  } else {
    log_event("error", "接收 " + m.name + " 失败：" + str(r.error));
    route({ dst: m.reply, op: "xfer_result", ok: false, text: "传递到 " + SELF.id + " 失败：" + str(r.error) });
  }
}
function sc_xfer_decide(p, a) {
  let m = XFERS[a[0]];
  if (m == null) return { error: "没有这个传递" };
  del(XFERS, a[0]);
  if (a[1] == true) {
    xfer_commit(m, (m.dir == "/" ? "" : m.dir) + "/" + m.name);
  } else {
    log_event("info", "已取消接收 " + m.name);
  }
  return true;
}
function sc_host_export(p, a) { return host("host_export", { name: a[0], text: a[1] }); }
function sc_host_import(p, a) { return host("host_import", { reply: SELF.path, pid: p.pid, tag: a[0] }); }
function sc_host_paths(p, a) { return host("host_paths", {}); }

// ———————— 投送：源应用留在本系统，目标桌面只放外框 ————————
function sc_proj_open(p, a) {
  let o = a[0];
  let sid = o.sid;
  let id = SELF.id + ":" + sid;
  PROJECTIONS[id] = { target: o.target, sid: sid, wid: o.wid, pid: p.pid };
  let proj = {
    id: id, sid: sid, src_sys: SELF.id, src_path: SELF.path, src_win: o.wid, src_app: o.app, title: o.title,
    target: o.target, w: o.w, h: o.h, depth: SELF.depth
  };
  host("proj_reg", { proj: proj });
  route({ dst: o.target, op: "proj_open", proj: proj });
  return id;
}
function sc_proj_focus(p, a) { route({ dst: a[1], op: "proj_focus", id: a[0] }); return true; }
function sc_proj_close(p, a) {
  let r = PROJECTIONS[a[0]];
  if (r == null) return false;
  route({ dst: r.target, op: "proj_close", id: a[0], reason: a[1] });
  host("proj_unreg", { id: a[0] });
  del(PROJECTIONS, a[0]);
  return true;
}
// 目标桌面的窗口管理器把投送内容里的输入转回源系统
function sc_proj_input(p, a) {
  return route({ dst: a[0], op: "proj_input", sid: a[1], ev: a[2] });
}
function sc_proj_resize(p, a) { return route({ dst: a[0], op: "proj_resize", sid: a[1], w: a[2], h: a[3] }); }
function sc_proj_closed(p, a) { return route({ dst: a[0], op: "proj_closed", sid: a[1], id: a[2] }); }

// ———————— 实时数据连接：与根系统电子表格之间只传副本 ————————
function sc_data_sources(p, a) { return route({ dst: "outer", op: "data_sources", reply: SELF.path, pid: p.pid, tag: a[0] }); }
function sc_data_connect(p, a) {
  let sub = SELF.id + ":sub" + str(NEXT_SUB);
  NEXT_SUB = NEXT_SUB + 1;
  SUBS[sub] = p.pid;
  route({ dst: "outer", op: "data_connect", reply: SELF.path, pid: p.pid, sub: sub, doc: a[0], range: a[1] });
  return sub;
}
function sc_data_disconnect(p, a) {
  if (SUBS[a[0]] != null) {
    del(SUBS, a[0]);
    route({ dst: "outer", op: "data_disconnect", sub: a[0] });
  }
  return true;
}

// ———————— 直属子系统 ————————
function child_path_dir(id) { return "/Systems/" + id; }
function save_tree() {
  let out = [];
  let ids = keys(CH);
  for (let k of ids) {
    let c = CH[k];
    push(out, { id: c.id, name: c.name, rate: c.rate, grant: c.grant, budget: c.budget, mem: c.mem, storage: c.storage, stopped: c.state == "stopped" });
  }
  fs_write_raw("/Systems/tree.json", json_str(out));
}
function child_info(c) {
  let p = PROCS[c.pid];
  let st = p != null && p.ctx != null ? vm_stat(p.ctx) : [0, 0, 0, 0, 0];
  return {
    id: c.id, name: c.name, path: c.path, depth: c.depth, state: c.state, rate: c.rate, grant: c.grant, budget: c.budget,
    mem: c.mem, storage: c.storage, err: c.err, pid: c.pid, kernel: child_path_dir(c.id) + "/kernel.nest", disk_used: c.disk_used,
    used: st[0], own: st[1], mem_used: st[2], avg: p != null ? floor(p.avg) : 0, parent: SELF.id, inner: st[0] - st[1]
  };
}
function child_set_state(c, state, err) {
  c.state = state;
  c.err = err;
  host("sys_state", { target: c.id, state: state, err: err, parent: SELF.id, name: c.name, path: c.path });
  wm_send({ type: "child_state", info: child_info(c) });
}
function child_defaults() {
  return {
    rate: 1,
    grant: floor(CFG.budget / 2),
    budget: floor(CFG.budget / 2),
    mem: floor(CFG.mem / 2),
    storage: floor(CFG.storage / 2)
  };
}
function child_new(o) {
  let id = o != null && o.id != null ? o.id : host("alloc_id", {});
  let d = child_defaults();
  let c = {
    id: id, name: o != null && o.name != null ? o.name : id, path: SELF.path + "/" + id, depth: SELF.depth + 1,
    state: "booting", rate: o != null && o.rate != null ? o.rate : d.rate, grant: o != null && o.grant != null ? o.grant : d.grant,
    budget: o != null && o.budget != null ? o.budget : d.budget, mem: o != null && o.mem != null ? o.mem : d.mem,
    storage: o != null && o.storage != null ? o.storage : d.storage,
    paused: false, stepping: false, step_req: 0, pending_dt: 0, inbox: [], pid: 0, err: null, disk_used: 0, w: 900, h: 600
  };
  CH[id] = c;
  let dir = child_path_dir(id);
  fs_mkdirs(dir + "/disk");
  if (fs_lookup(dir + "/kernel.nest") == null) {
    let r = fs_copy("/System/kernel.nest", dir + "/kernel.nest");
    if (r != true) {
      del(CH, id);
      return { error: "创建失败：" + str(r.error) };
    }
  }
  save_tree();
  host("sys_state", { target: id, state: "booting", parent: SELF.id, name: c.name, path: c.path });
  wm_send({ type: "child_new", info: child_info(c) });
  child_boot(c);
  return id;
}
function child_boot(c) {
  c.state = "booting";
  c.err = null;
  c.pending_dt = 0;
  c.inbox = [];
  c.paused = false;
  child_set_state(c, "booting");
  request_image(child_path_dir(c.id) + "/kernel.nest", on_kernel_ready, c.id);
}
function on_kernel_ready(id, image, err) {
  let c = CH[id];
  if (c == null) return;
  if (image == null) {
    child_set_state(c, "error", "内核编译失败：" + str(err));
    log_event("error", id + " 内核错误：" + str(err));
    return;
  }
  let boot_args = {
    id: c.id, name: c.name, path: c.path, depth: c.depth, parent: SELF.id, parent_path: SELF.path,
    budget: c.budget, mem: c.mem, storage: c.storage, w: c.w, h: c.h
  };
  try {
    let p = create_process(image, boot_args, {
      name: "内核 " + c.id, path: child_path_dir(c.id) + "/kernel.nest", kind: "host", child: c.id, priv: true, mem: c.mem, quota: c.grant
    });
    p.quota_left = c.grant;
    c.pid = p.pid;
    c.state = "running";
    child_set_state(c, "running");
  } catch (e) {
    child_set_state(c, "error", str(e));
  }
}
function child_kill_proc(c) {
  let p = PROCS[c.pid];
  if (p != null && p.ctx != null) {
    let saved = p.child;
    p.child = null;
    proc_end(p, "exited", null, "实例已停止");
    p.child = saved;
  }
  c.pid = 0;
}
function child_on_exit(c, state, err) {
  if (c == null) return;
  c.pid = 0;
  if (state == "fault") {
    host("drop_subtree", { target: c.id, keep_self: true, reason: "内核错误" });
    child_set_state(c, "error", "内核错误：" + str(err));
    log_event("error", c.id + " 内核错误：" + str(err));
  } else {
    if (c.state != "stopped") {
      host("drop_subtree", { target: c.id, keep_self: true, reason: "实例已停止" });
      child_set_state(c, "stopped", err);
    }
  }
}
function child_stop(c, reason) {
  child_kill_proc(c);
  host("drop_subtree", { target: c.id, keep_self: true, reason: reason != null ? reason : "实例已停止" });
  child_set_state(c, "stopped", null);
  save_tree();
}
function child_close(c) {
  child_kill_proc(c);
  host("drop_subtree", { target: c.id, keep_self: false, reason: "实例已关闭" });
  host("sys_state", { target: c.id, state: "closed", parent: SELF.id, name: c.name, path: c.path });
  fs_delete(child_path_dir(c.id));
  del(CH, c.id);
  save_tree();
  wm_send({ type: "child_closed", id: c.id });
}
function child_restart(c) {
  child_kill_proc(c);
  host("drop_subtree", { target: c.id, keep_self: true, reason: "实例已重启" });
  child_boot(c);
}
// 把本系统记录的子系统按保留的结构重新启动（重启内核时）
function restore_tree() {
  let t = fs_read_raw("/Systems/tree.json");
  if (t == null) return;
  let list = null;
  try { list = json_parse(t); } catch (e) { return; }
  for (let e of list) {
    let c = {
      id: e.id, name: e.name, path: SELF.path + "/" + e.id, depth: SELF.depth + 1, state: "booting", rate: e.rate, grant: e.grant,
      budget: e.budget, mem: e.mem, storage: e.storage, paused: false, stepping: false, step_req: 0, pending_dt: 0,
      inbox: [], pid: 0, err: null, disk_used: 0, w: 900, h: 600
    };
    CH[e.id] = c;
    host("sys_state", { target: c.id, state: e.stopped ? "stopped" : "booting", parent: SELF.id, name: c.name, path: c.path });
    wm_send({ type: "child_new", info: child_info(c) });
    if (e.stopped) { c.state = "stopped"; continue; }
    child_boot(c);
  }
}

// —— 快照：子树的全部运行状态写成父系统文件，复制和写入计入本系统预算与存储配额 ——
function snapshot_data(c) {
  let p = PROCS[c.pid];
  if (p == null || p.ctx == null) return null;
  let ids = host("subtree_ids", { target: c.id });
  let rec = {
    kind: "nest-snapshot", v: 1, id: c.id, name: c.name, path: c.path, depth: c.depth, parent_path: SELF.path, parent_vtime: VTIME,
    ids: ids, rate: c.rate, paused: c.paused, pending_dt: c.pending_dt, inbox: c.inbox,
    budget: c.budget, mem: c.mem, storage: c.storage,
    proc: { state: p.state, wait: p.wait, wake_at: p.wake_at, mq: p.mq, suspended: p.suspended, avg: p.avg, msgs_in: p.msgs_in, msgs_out: p.msgs_out },
    ctx: vm_save(p.ctx),
    dev: host("dev_export", { target: c.id }),
    files: fs_walk(child_path_dir(c.id), "", [])
  };
  return rec;
}
function child_snapshot(c, file) {
  let rec = snapshot_data(c);
  if (rec == null) return { error: "实例没有运行，不能保存快照" };
  let name = file != null ? file : "/Snapshots/" + c.id + "-" + str(TICKS) + ".snap";
  let r = fs_write_raw(name, json_str(rec));
  if (r != true) return r;
  log_event("info", "已保存 " + c.id + " 的快照：" + name);
  return name;
}
function write_snapshot_files(id, files) {
  let dir = child_path_dir(id);
  if (fs_lookup(dir) != null) fs_delete(dir);
  fs_mkdirs(dir);
  for (let f of files) {
    if (f[1] == null) fs_mkdirs(dir + f[0]);
    else {
      let r = fs_write_raw(dir + f[0], f[1]);
      if (r != true) return r;
    }
  }
  return true;
}
function install_snapshot_proc(c, rec, text, remap) {
  let ctx = vm_restore(text, remap);
  let pid = NEXT_PID;
  NEXT_PID = NEXT_PID + 1;
  let pr = rec.proc;
  let p = {
    pid: pid, name: "内核 " + c.id, path: child_path_dir(c.id) + "/kernel.nest", ctx: ctx, state: pr.state == "running" ? "ready" : pr.state,
    wait: pr.wait, wake_at: pr.wake_at, mq: [], suspended: pr.suspended, inq: false, kind: "host", ppid: 0, group: pid, leader: true,
    quota: c.grant, quota_left: c.grant, stdout: 0, child: c.id, app: null, on_exit: null, exit_data: null,
    used0: 0, tick_used: 0, avg: pr.avg, msgs_in: pr.msgs_in, msgs_out: pr.msgs_out, remaining: 0, error: null, started: VTIME, sleeps: 0
  };
  PROCS[pid] = p;
  c.pid = pid;
  enqueue(p);
}
function child_restore(c, file) {
  let text = fs_read_raw(file);
  if (text == null) return { error: "快照文件不存在：" + file };
  let rec = null;
  try { rec = json_parse(text); } catch (e) { return { error: "快照文件损坏：" + str(e) }; }
  if (rec.kind != "nest-snapshot") return { error: "不是快照文件" };
  // 只改变选定子树：结束现有进程，换回快照里的状态；拨付配置保持当前值
  child_kill_proc(c);
  host("drop_subtree", { target: c.id, keep_self: true, reason: "恢复快照", keep_proj: true });
  let remap = null;
  if (rec.id != c.id || rec.parent_path != SELF.path) {
    remap = {};
    remap[rec.id] = c.id;
    remap["@from"] = rec.parent_path;
    remap["@to"] = SELF.path;
  }
  let w = write_snapshot_files(c.id, rec.files);
  if (w != true) { child_set_state(c, "error", "恢复失败：" + str(w.error)); return w; }
  c.rate = rec.rate;
  c.paused = rec.paused;
  c.pending_dt = rec.pending_dt;
  c.inbox = rec.inbox;
  c.stepping = false;
  c.step_req = 0;
  install_snapshot_proc(c, rec, rec.ctx, remap);
  host("dev_import", { target: c.id, data: rec.dev, ids: rec.ids, remap: remap });
  let ext = host("proj_external", { scope: c.path });
  push(c.inbox, { op: "restored", mode: "restore", scope: c.path, ext: ext });
  child_set_state(c, c.paused ? "paused" : "running");
  log_event("info", "已恢复 " + c.id + "（" + file + "）");
  return true;
}
function child_fork(file, o) {
  let text = fs_read_raw(file);
  if (text == null) return { error: "快照文件不存在：" + file };
  let rec = null;
  try { rec = json_parse(text); } catch (e) { return { error: "快照文件损坏：" + str(e) }; }
  if (rec.kind != "nest-snapshot") return { error: "不是快照文件" };
  // 各节点使用新实例身份，内部关系指向分叉内的对应节点
  let remap = {};
  for (let old of rec.ids) { remap[old] = host("alloc_id", {}); }
  remap["@from"] = rec.parent_path;
  remap["@to"] = SELF.path;
  let id = remap[rec.id];
  let c = {
    id: id, name: id, path: SELF.path + "/" + id, depth: SELF.depth + 1, state: "running", rate: rec.rate,
    grant: child_defaults().grant, budget: rec.budget, mem: rec.mem, storage: rec.storage,
    paused: rec.paused, stepping: false, step_req: 0, pending_dt: rec.pending_dt, inbox: [], pid: 0, err: null, disk_used: 0, w: 900, h: 600
  };
  c.inbox = host("remap_value", { value: rec.inbox, remap: remap });
  CH[id] = c;
  let w = write_snapshot_files(id, rec.files);
  if (w != true) { del(CH, id); return w; }
  install_snapshot_proc(c, rec, rec.ctx, remap);
  host("dev_import", { target: id, data: rec.dev, ids: rec.ids, remap: remap, fork: true });
  push(c.inbox, { op: "restored", mode: "fork", scope: c.path, ext: [] });
  save_tree();
  host("sys_state", { target: id, state: c.paused ? "paused" : "running", parent: SELF.id, name: c.name, path: c.path });
  wm_send({ type: "child_new", info: child_info(c) });
  child_set_state(c, c.paused ? "paused" : "running");
  log_event("info", "已从快照分叉出 " + id);
  return id;
}
function on_restored(m) {
  FS.dirty = true;
  let ids = keys(CH);
  for (let k of ids) push(CH[k].inbox, m);
  let pids = keys(PROCS);
  for (let k of pids) {
    do_send(0, PROCS[k].pid, { type: "sys_restored", mode: m.mode, scope: m.scope, ext: m.ext });
  }
}

// 子系统管理接口（窗口管理器、任务管理器都用它）
function sc_sysctl(p, a) {
  let op = a[0];
  if (op == "new") return child_new(a[1]);
  if (op == "list") {
    let out = [];
    let ids = keys(CH);
    for (let k of ids) push(out, child_info(CH[k]));
    return out;
  }
  if (op == "fork") return child_fork(a[1], a[2]);
  if (op == "snapshots") {
    let l = fs_list("/Snapshots");
    return type(l) == "array" ? l : [];
  }
  let c = CH[a[1]];
  if (c == null) return { error: "没有直属子系统 " + str(a[1]) };
  if (op == "pause") {
    c.paused = true;
    child_set_state(c, "paused");
    return true;
  }
  if (op == "resume") {
    c.paused = false;
    let pr = PROCS[c.pid];
    if (pr != null) { pr.suspended = false; enqueue(pr); }
    child_set_state(c, "running");
    return true;
  }
  if (op == "step") {
    if (!c.paused) return { error: "只有暂停的直属子系统可以单步" };
    c.step_req = c.step_req + 1;
    return true;
  }
  if (op == "rate") {
    c.rate = a[2];
    wm_send({ type: "child_state", info: child_info(c) });
    return true;
  }
  if (op == "stop") { child_stop(c, "实例已停止"); return true; }
  if (op == "start") {
    if (c.pid != 0) return true;
    child_boot(c);
    return true;
  }
  if (op == "restart") { child_restart(c); return true; }
  if (op == "close") { child_close(c); return true; }
  if (op == "snapshot") return child_snapshot(c, a[2]);
  if (op == "restore") return child_restore(c, a[2]);
  if (op == "grant") {
    c.grant = a[2];
    let pr = PROCS[c.pid];
    if (pr != null) { pr.quota = a[2]; pr.quota_left = a[2]; }
    wm_send({ type: "child_state", info: child_info(c) });
    save_tree();
    return true;
  }
  if (op == "config") {
    let cf = a[2];
    if (cf.mem != null) {
      c.mem = cf.mem;
      let pr = PROCS[c.pid];
      if (pr != null && pr.ctx != null) vm_set_mem(pr.ctx, cf.mem);
    }
    if (cf.storage != null) c.storage = cf.storage;
    if (cf.budget != null) c.budget = cf.budget;
    push(c.inbox, { op: "cfg", cfg: cf });
    save_tree();
    return true;
  }
  if (op == "input") { push(c.inbox, { op: "input", ev: a[2] }); return true; }
  if (op == "resize") {
    c.w = a[2];
    c.h = a[3];
    push(c.inbox, { op: "resize", w: a[2], h: a[3] });
    return true;
  }
  if (op == "kernel_path") return child_path_dir(c.id) + "/kernel.nest";
  return { error: "未知操作 " + str(op) };
}

// —— 承载进程（直属子系统内核）专用接口 ——
function hc_tick(p, a) {
  let c = CH[p.child];
  if (c == null) return { dt: 0, inbox: [] };
  if (c.pending_dt > 0) return take_tick(c);
  p.state = "waiting";
  p.wait = "tick";
  return BLOCK;
}
function hc_up(p, a) {
  let m = a[0];
  if (m.dst == null) m.dst = "host";
  return route(m);
}
function child_disk_path(c, key) { return child_path_dir(c.id) + "/disk/" + key; }
function hc_disk_get(p, a) {
  let c = CH[p.child];
  return fs_read_raw(child_disk_path(c, a[0]));
}
function hc_disk_put(p, a) {
  let c = CH[p.child];
  let path = child_disk_path(c, a[0]);
  let i = fs_lookup(path);
  let old = i != null ? FS.inodes[i].s : 0;
  if (c.disk_used - old + len(a[1]) > c.storage + 1048576) return { error: "ENOSPC: " + c.id + " 超出父系统拨付的存储配额" };
  let r = fs_write_raw(path, a[1]);
  if (r == true) c.disk_used = c.disk_used - old + len(a[1]);
  return r;
}
function hc_disk_del(p, a) {
  let c = CH[p.child];
  let path = child_disk_path(c, a[0]);
  let i = fs_lookup(path);
  if (i != null) { c.disk_used = c.disk_used - FS.inodes[i].s; fs_delete(path); }
  return true;
}
// 新系统首次启动时从父系统取得预置文件
function seed_paths(dir, out) {
  let i = fs_lookup(dir);
  if (i == null) return out;
  let n = FS.inodes[i];
  if (n.t == "f") { push(out, dir); return out; }
  let names = keys(n.e);
  sort_str(names);
  for (let x of names) seed_paths(dir + "/" + x, out);
  return out;
}
function hc_seed_list(p, a) {
  let out = [];
  for (let d of ["/System", "/Programs", "/Flight", "/Docs"]) seed_paths(d, out);
  // 预置场景
  if (fs_lookup("/Demo/helicopter-24.scene") != null) push(out, "/Demo/helicopter-24.scene");
  if (fs_lookup("/Demo/minimal.scene") != null) push(out, "/Demo/minimal.scene");
  return out;
}
function hc_seed_read(p, a) {
  return fs_read_raw(a[0]);
}

// ———————— 启动 ————————
function init_syscalls() {
  SC = {
    time: sc_time, sleep: sc_sleep, self: sc_self, exit: sc_exit, spawn: sc_spawn, compile: sc_compile, kill: sc_kill,
    suspend: sc_suspend, resume: sc_resume, set_quota: sc_set_quota, wait_proc: sc_wait_proc, proc_state: sc_proc_state,
    proc_list: sc_proc_list, stats: sc_stats, set_config: sc_set_config, work: sc_work,
    send: sc_send, recv: sc_recv,
    fs_read: sc_fs_read, fs_write: sc_fs_write, fs_append: sc_fs_append, fs_list: sc_fs_list, fs_stat: sc_fs_stat, fs_mkdir: sc_fs_mkdir,
    fs_delete: sc_fs_delete, fs_rename: sc_fs_rename, fs_copy: sc_fs_copy, fs_watch: sc_fs_watch,
    print: sc_print, draw: sc_draw, scene: sc_scene, scene_frame: sc_scene_frame,
    surface_new: sc_surface_new, ui: sc_ui, ui_patch: sc_ui_patch, ui_focus: sc_ui_focus, meta: sc_meta,
    gfx_open: sc_gfx_open, gfx_frame: sc_gfx_frame, gfx_close: sc_gfx_close, gfx_pick: sc_gfx_pick,
    win_open: sc_win_open, win_set: sc_win_set, win_close: sc_win_close,
    service_set: sc_service_set, service_get: sc_service_get, bus_write: sc_bus_write, bus_read: sc_bus_read,
    ancestors: sc_ancestors, notify: sc_notify, focus_parent: sc_focus_parent,
    proj_open: sc_proj_open, proj_focus: sc_proj_focus, proj_close: sc_proj_close, proj_input: sc_proj_input,
    proj_resize: sc_proj_resize, proj_closed: sc_proj_closed,
    data_sources: sc_data_sources, data_connect: sc_data_connect, data_disconnect: sc_data_disconnect,
    xfer_decide: sc_xfer_decide, host_export: sc_host_export, host_import: sc_host_import, host_paths: sc_host_paths,
    sysctl: sc_sysctl
  };
  HC = { tick: hc_tick, up: hc_up, disk_get: hc_disk_get, disk_put: hc_disk_put, disk_del: hc_disk_del, seed_list: hc_seed_list, seed_read: hc_seed_read };
}

function boot_screen(text) {
  host("ui", { sid: "root", tree: {
    k: "boot", x: 0, y: 0, w: SELF.w, h: SELF.h, cls: "boot-screen", c: [
      { k: "logo", cls: "boot-logo", text: "Nest" },
      { k: "id", cls: "boot-id", text: SELF.id + " · 第 " + str(SELF.depth) + " 层" },
      { k: "msg", cls: "boot-msg", text: text }
    ]
  } });
}

function install_seed() {
  let list = sys("seed_list");
  let total = len(list), i = 0;
  for (let path of list) {
    i = i + 1;
    if (i % 8 == 1) boot_screen("正在安装系统文件 " + str(i) + " / " + str(total));
    let t = sys("seed_read", path);
    if (type(t) == "string") fs_write_raw(path, t);
  }
  fs_mkdirs("/Documents");
  fs_mkdirs("/Downloads");
  fs_mkdirs("/Systems");
  fs_mkdirs("/Snapshots");
  fs_flush_super();
}

function on_wm_ready(d, image, err) {
  if (image == null) {
    boot_screen("窗口管理器启动失败：" + str(err));
    host("kernel_note", { text: "窗口管理器启动失败：" + str(err) });
    return;
  }
  let p = create_process(image, { w: SELF.w, h: SELF.h, id: SELF.id, name: SELF.name, depth: SELF.depth, path: SELF.path }, {
    name: "窗口管理器", path: "/System/wm.nest", kind: "system"
  });
  SERVICES.wm = p.pid;
  // 窗口管理器就绪后再恢复保留的子系统结构
  restore_tree();
}

function main(args) {
  SELF = args;
  CFG = { budget: args.budget, mem: args.mem, storage: args.storage };
  init_syscalls();
  boot_screen("正在挂载文件系统");
  let fresh = fs_mount();
  if (fresh) install_seed();
  boot_screen("正在启动窗口管理器");
  request_image("/System/wm.nest", on_wm_ready, null);
  for (;;) {
    let t = sys("tick");
    on_tick(t);
    schedule();
    end_tick();
  }
}
