// Nest 编译器 —— 用 Nest 语言自身写成，在系统内作为普通进程运行。
// 输入：程序源文件（可 include 其他源文件）；输出：VM 执行的 .nbc 文本。
// 修改本文件并保存后，内核在下一次启动程序前会用现有编译器重新编译它，
// 新编译器随后用于此后启动的所有程序（缓存键含编译器哈希，旧产物自动失效）。
//
// 文件形式上也是合法的 JavaScript 子集，开发阶段可由 tools/bootstrap.mjs 引导出第一版。

const OP_NAMES = "NOP CONST INT NULL TRUE FALSE LOAD STORE GLOAD GSTORE POP DUP DUP2 ADD SUB MUL DIV MOD NEG NOT EQ NE LT LE GT GE BAND BOR BXOR SHL SHR BNOT JMP JZ JNZ JZK JNZK CALL CALLV RET BI TRAP ARR OBJ GET SET TRY ENDTRY THROW FUNC GETK";
const BUILTIN_NAMES = "sqrt sin cos tan atan asin acos abs floor ceil round exp log sign atan2 pow min max rand srand is_nan len substr char_at char_code char_from index_of last_index_of split join str num fmt lower upper trim replace starts_with ends_with pad_left push pop shift insert remove_at slice concat new_array reverse sort_num sort_str sort_key keys values has del type copy json_parse json_str hash vm_load vm_spawn vm_run vm_resume vm_throw vm_kill vm_stat vm_self vm_set_mem vm_ext_mem vm_where budget_left vm_save vm_restore vm_used";

let OP = {};
let BUILTIN = {};

const T_EOF = 0, T_NUM = 1, T_STR = 2, T_ID = 3, T_KW = 4, T_P = 5;
let KEYWORDS = {};

// 词法单元（并行数组，便于节省内存）
let tk_type = [], tk_val = [], tk_line = [], tk_file = [];
let tp = 0;

// 代码生成状态
let code = [], consts = [], const_map = {}, lines = [], files = [];
let funcs = [], fn_map = {}, global_map = {}, nglobals = 0, imports = [], import_map = {};
let scopes = [], nslots = 0, maxslots = 0, loops = [], try_depth = 0, in_function = false;
let last_line = -1, last_file = -1;

function init_tables() {
  OP = {}; BUILTIN = {}; KEYWORDS = {};
  let names = split(OP_NAMES, " ");
  for (let i = 0; i < len(names); i++) { OP["o:" + names[i]] = i; }
  names = split(BUILTIN_NAMES, " ");
  for (let i = 0; i < len(names); i++) { BUILTIN["b:" + names[i]] = true; }
  names = split("let const var function if else while for of break continue return true false null try catch throw include", " ");
  for (let i = 0; i < len(names); i++) { KEYWORDS["k:" + names[i]] = true; }
  code = []; consts = []; const_map = {}; lines = []; files = [];
  funcs = []; fn_map = {}; global_map = {}; nglobals = 0; imports = []; import_map = {};
  scopes = []; nslots = 0; maxslots = 0; loops = []; try_depth = 0; in_function = false;
  last_line = -1; last_file = -1;
  tk_type = []; tk_val = []; tk_line = []; tk_file = []; tp = 0;
}

function err_at(i, msg) {
  throw files[tk_file[i]] + ":" + tk_line[i] + ": " + msg;
}

// —— 词法分析 ——
function is_id_start(c) { return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || c == 36 || c > 127; }
function is_digit(c) { return c >= 48 && c <= 57; }

function lex_file(src, file_idx, out) {
  let i = 0, n = len(src), line = 1;
  let ty = out.ty, va = out.va, li = out.li, fi = out.fi;
  while (i < n) {
    let c = char_code(src, i);
    if (c == 10) { line = line + 1; i = i + 1; continue; }
    if (c == 32 || c == 9 || c == 13) { i = i + 1; continue; }
    if (c == 47) {
      let d = char_code(src, i + 1);
      if (d == 47) { let e = index_of(src, "\n", i); i = e < 0 ? n : e; continue; }
      if (d == 42) {
        let e = index_of(src, "*/", i + 2);
        if (e < 0) throw files[file_idx] + ":" + line + ": 注释没有结束";
        let j = i;
        while (j < e) { if (char_code(src, j) == 10) line = line + 1; j = j + 1; }
        i = e + 2; continue;
      }
    }
    if (is_id_start(c)) {
      let j = i + 1;
      while (j < n) { let d = char_code(src, j); if (is_id_start(d) || is_digit(d)) j = j + 1; else break; }
      let word = substr(src, i, j - i);
      push(ty, KEYWORDS["k:" + word] ? T_KW : T_ID); push(va, word); push(li, line); push(fi, file_idx);
      i = j; continue;
    }
    if (is_digit(c) || (c == 46 && is_digit(char_code(src, i + 1)))) {
      let j = i;
      if (c == 48 && (char_code(src, i + 1) == 120 || char_code(src, i + 1) == 88)) {
        j = i + 2; let v = 0;
        while (j < n) {
          let d = char_code(src, j), h = -1;
          if (is_digit(d)) h = d - 48; else if (d >= 97 && d <= 102) h = d - 87; else if (d >= 65 && d <= 70) h = d - 55;
          if (h < 0) break;
          v = v * 16 + h; j = j + 1;
        }
        push(ty, T_NUM); push(va, v); push(li, line); push(fi, file_idx);
        i = j; continue;
      }
      while (j < n && is_digit(char_code(src, j))) j = j + 1;
      if (char_code(src, j) == 46) { j = j + 1; while (j < n && is_digit(char_code(src, j))) j = j + 1; }
      let ec = char_code(src, j);
      if (ec == 101 || ec == 69) {
        let k = j + 1, sc = char_code(src, k);
        if (sc == 43 || sc == 45) k = k + 1;
        if (is_digit(char_code(src, k))) { j = k; while (j < n && is_digit(char_code(src, j))) j = j + 1; }
      }
      push(ty, T_NUM); push(va, num(substr(src, i, j - i))); push(li, line); push(fi, file_idx);
      i = j; continue;
    }
    if (c == 34 || c == 39) {
      let parts = [], j = i + 1, start = j;
      for (;;) {
        if (j >= n) throw files[file_idx] + ":" + line + ": 字符串没有结束";
        let d = char_code(src, j);
        if (d == c) break;
        if (d == 10) throw files[file_idx] + ":" + line + ": 字符串不能跨行";
        if (d == 92) {
          push(parts, substr(src, start, j - start));
          let e = char_code(src, j + 1);
          if (e == 110) push(parts, "\n");
          else if (e == 116) push(parts, "\t");
          else if (e == 114) push(parts, "\r");
          else if (e == 48) push(parts, char_from(0));
          else if (e == 117) { push(parts, char_from(hex4(substr(src, j + 2, 4)))); j = j + 4; }
          else push(parts, char_from(e));
          j = j + 2; start = j; continue;
        }
        j = j + 1;
      }
      push(parts, substr(src, start, j - start));
      push(ty, T_STR); push(va, len(parts) == 1 ? parts[0] : join(parts, "")); push(li, line); push(fi, file_idx);
      i = j + 1; continue;
    }
    let p3 = substr(src, i, 3);
    if (p3 == "===" || p3 == "!==") {
      push(ty, T_P); push(va, p3 == "===" ? "==" : "!="); push(li, line); push(fi, file_idx);
      i = i + 3; continue;
    }
    let p2 = substr(p3, 0, 2);
    if (p2 == "==" || p2 == "!=" || p2 == "<=" || p2 == ">=" || p2 == "&&" || p2 == "||" || p2 == "+=" || p2 == "-=" || p2 == "*=" || p2 == "/=" || p2 == "%=" || p2 == "++" || p2 == "--" || p2 == "<<" || p2 == ">>") {
      push(ty, T_P); push(va, p2); push(li, line); push(fi, file_idx);
      i = i + 2; continue;
    }
    let p1 = substr(p3, 0, 1);
    if (index_of("+-*/%=<>!&|^~?:;,.()[]{}", p1, 0) >= 0) {
      push(ty, T_P); push(va, p1); push(li, line); push(fi, file_idx);
      i = i + 1; continue;
    }
    throw files[file_idx] + ":" + line + ": 无法识别的字符 " + p1;
  }
}

function hex4(s) {
  let v = 0;
  for (let i = 0; i < len(s); i++) {
    let d = char_code(s, i), h = 0;
    if (is_digit(d)) h = d - 48; else if (d >= 97 && d <= 102) h = d - 87; else if (d >= 65 && d <= 70) h = d - 55;
    v = v * 16 + h;
  }
  return v;
}

// 展开 include：被包含文件的词法单元在包含点之前进入流，每个文件只包含一次。
function load_tokens(path, src, reader, deps, included) {
  let file_idx = len(files);
  push(files, path);
  push(deps, [path, hash(src)]);
  included["f:" + path] = true;
  let o = { ty: [], va: [], li: [], fi: [] };
  lex_file(src, file_idx, o);
  let i = 0, n = len(o.ty);
  while (i < n) {
    if (o.ty[i] == T_KW && o.va[i] == "include") {
      if (o.ty[i + 1] != T_STR) throw path + ":" + o.li[i] + ": include 后面应是文件路径字符串";
      let p = o.va[i + 1];
      if (!included["f:" + p]) {
        let s = reader(p);
        if (s == null) throw path + ":" + o.li[i] + ": 找不到被包含的文件 " + p;
        load_tokens(p, s, reader, deps, included);
      }
      i = i + 2;
      if (o.ty[i] == T_P && o.va[i] == ";") i = i + 1;
      continue;
    }
    push(tk_type, o.ty[i]); push(tk_val, o.va[i]); push(tk_line, o.li[i]); push(tk_file, o.fi[i]);
    i = i + 1;
  }
}

// —— 语法工具 ——
function is_p(s) { return tk_type[tp] == T_P && tk_val[tp] == s; }
function is_kw(s) { return tk_type[tp] == T_KW && tk_val[tp] == s; }
function accept_p(s) { if (is_p(s)) { tp = tp + 1; return true; } return false; }
function expect_p(s) { if (!accept_p(s)) err_at(tp, "这里应该是 “" + s + "”，实际是 “" + str(tk_val[tp]) + "”"); }
function expect_id() {
  if (tk_type[tp] != T_ID) err_at(tp, "这里应该是名称，实际是 “" + str(tk_val[tp]) + "”");
  tp = tp + 1;
  return tk_val[tp - 1];
}

// —— 代码生成工具 ——
function op_code(name) { return OP["o:" + name]; }
function e0(name) { push(code, OP["o:" + name]); }
function e1(name, a) { push(code, OP["o:" + name]); push(code, a); }
function e2(name, a, b) { push(code, OP["o:" + name]); push(code, a); push(code, b); }
function emit_jump(name) { push(code, OP["o:" + name]); push(code, 0); return len(code) - 1; }
function patch(at) { code[at] = len(code); }
function mark_line() {
  let l = tk_line[tp], f = tk_file[tp];
  if (l != last_line || f != last_file) {
    push(lines, len(code)); push(lines, f); push(lines, l);
    last_line = l; last_file = f;
  }
}
function const_idx(v) {
  let key = (type(v) == "string" ? "s:" : "n:") + str(v);
  let k = const_map[key];
  if (k != null) return k;
  k = len(consts);
  push(consts, v);
  const_map[key] = k;
  return k;
}
function emit_num(v) {
  if (v == floor(v) && v >= -1000000000 && v <= 1000000000) e1("INT", v);
  else e1("CONST", const_idx(v));
}
function emit_str(s) { e1("CONST", const_idx(s)); }

function fn_index(name) {
  let k = fn_map["f:" + name];
  if (k != null) return k;
  k = len(funcs);
  push(funcs, [name, 0, 0, -1]);
  fn_map["f:" + name] = k;
  return k;
}
function import_idx(name) {
  let k = import_map["i:" + name];
  if (k != null) return k;
  k = len(imports);
  push(imports, name);
  import_map["i:" + name] = k;
  return k;
}

// 作用域
function push_scope() { push(scopes, {}); }
function pop_scope(saved) { pop(scopes); nslots = saved; }
function declare_local(name) {
  let slot = nslots;
  nslots = nslots + 1;
  if (nslots > maxslots) maxslots = nslots;
  scopes[len(scopes) - 1]["v:" + name] = slot;
  return slot;
}
function hidden_local() {
  let slot = nslots;
  nslots = nslots + 1;
  if (nslots > maxslots) maxslots = nslots;
  return slot;
}
function find_local(name) {
  let i = len(scopes) - 1;
  while (i >= 0) {
    let s = scopes[i]["v:" + name];
    if (s != null) return s;
    i = i - 1;
  }
  return null;
}

// —— 表达式（单趟生成，左值延后处理）——
// 描述符：kind 0=已入栈的值 1=局部 2=全局 3=下标(对象、键已入栈) 4=成员(对象已入栈、键为常量)
const D_VAL = 0, D_LOCAL = 1, D_GLOBAL = 2, D_INDEX = 3, D_MEMBER = 4, D_FN = 5, D_BI = 6, D_SYS = 7;
let DV = [0, 0];

function discharge(d) {
  let k = d[0];
  if (k == D_VAL) return;
  if (k == D_LOCAL) e1("LOAD", d[1]);
  else if (k == D_GLOBAL) e1("GLOAD", d[1]);
  else if (k == D_INDEX) e0("GET");
  else if (k == D_MEMBER) e1("GETK", d[1]);
  else if (k == D_FN) e1("FUNC", d[1]);
  else err_at(tp, "内建函数只能被调用：" + str(d[1]));
}

function parse_args() {
  let argc = 0;
  if (!accept_p(")")) {
    for (;;) {
      parse_expr();
      argc = argc + 1;
      if (accept_p(")")) break;
      expect_p(",");
    }
  }
  return argc;
}

function parse_primary() {
  let ty = tk_type[tp], v = tk_val[tp];
  if (ty == T_NUM) { tp = tp + 1; emit_num(v); return DV; }
  if (ty == T_STR) { tp = tp + 1; emit_str(v); return DV; }
  if (ty == T_ID) {
    tp = tp + 1;
    if (v == "sys") return [D_SYS, 0];
    let s = find_local(v);
    if (s != null) return [D_LOCAL, s];
    let g = global_map["g:" + v];
    if (g != null) return [D_GLOBAL, g];
    let f = fn_map["f:" + v];
    if (f != null) return [D_FN, f];
    if (BUILTIN["b:" + v]) return [D_BI, v];
    err_at(tp - 1, "未定义的名称 " + v);
  }
  if (ty == T_KW) {
    if (v == "true") { tp = tp + 1; e0("TRUE"); return DV; }
    if (v == "false") { tp = tp + 1; e0("FALSE"); return DV; }
    if (v == "null") { tp = tp + 1; e0("NULL"); return DV; }
    err_at(tp, "此处不能使用关键字 " + v);
  }
  if (is_p("(")) {
    tp = tp + 1;
    parse_expr();
    expect_p(")");
    return DV;
  }
  if (is_p("[")) {
    tp = tp + 1;
    let n = 0;
    if (!accept_p("]")) {
      for (;;) {
        parse_expr();
        n = n + 1;
        if (accept_p("]")) break;
        expect_p(",");
        if (accept_p("]")) break;
      }
    }
    e1("ARR", n);
    return DV;
  }
  if (is_p("{")) {
    tp = tp + 1;
    let n = 0;
    if (!accept_p("}")) {
      for (;;) {
        let kt = tk_type[tp];
        if (kt == T_ID || kt == T_STR || kt == T_KW) { emit_str(tk_val[tp]); tp = tp + 1; }
        else if (kt == T_NUM) { emit_str(str(tk_val[tp])); tp = tp + 1; }
        else err_at(tp, "映射的键应为名称或字符串");
        expect_p(":");
        parse_expr();
        n = n + 1;
        if (accept_p("}")) break;
        expect_p(",");
        if (accept_p("}")) break;
      }
    }
    e1("OBJ", n);
    return DV;
  }
  err_at(tp, "无法解析的表达式：" + str(tk_val[tp]));
}

function parse_postfix() {
  let d = parse_primary();
  for (;;) {
    if (is_p("(")) {
      tp = tp + 1;
      let k = d[0];
      if (k == D_FN) { let argc = parse_args(); e2("CALL", d[1], argc); d = DV; continue; }
      if (k == D_BI) { let argc = parse_args(); e2("BI", import_idx(d[1]), argc); d = DV; continue; }
      if (k == D_SYS) { let argc = parse_args(); e1("TRAP", argc); d = DV; continue; }
      discharge(d);
      let argc = parse_args();
      e1("CALLV", argc);
      d = DV;
      continue;
    }
    if (is_p("[")) {
      tp = tp + 1;
      discharge(d);
      parse_expr();
      expect_p("]");
      d = [D_INDEX, 0];
      continue;
    }
    if (is_p(".")) {
      tp = tp + 1;
      discharge(d);
      let ty = tk_type[tp];
      if (ty != T_ID && ty != T_KW) err_at(tp, "“.” 后面应是成员名");
      let name = tk_val[tp];
      tp = tp + 1;
      d = [D_MEMBER, const_idx(name)];
      continue;
    }
    if (is_p("++") || is_p("--")) {
      let plus = is_p("++");
      tp = tp + 1;
      let k = d[0];
      if (k == D_LOCAL) {
        e1("LOAD", d[1]); e0("DUP"); e1("INT", 1); e0(plus ? "ADD" : "SUB"); e1("STORE", d[1]);
      } else if (k == D_GLOBAL) {
        e1("GLOAD", d[1]); e0("DUP"); e1("INT", 1); e0(plus ? "ADD" : "SUB"); e1("GSTORE", d[1]);
      } else if (k == D_INDEX || k == D_MEMBER) {
        if (k == D_MEMBER) e1("CONST", d[1]);
        e0("DUP2"); e0("GET"); e1("INT", 1); e0(plus ? "ADD" : "SUB"); e0("SET");
      } else err_at(tp - 1, "自增自减的目标不是变量");
      d = DV;
      continue;
    }
    return d;
  }
}

function parse_unary() {
  if (is_p("-")) { tp = tp + 1; let d = parse_unary(); discharge(d); e0("NEG"); return DV; }
  if (is_p("+")) { tp = tp + 1; let d = parse_unary(); discharge(d); return DV; }
  if (is_p("!")) { tp = tp + 1; let d = parse_unary(); discharge(d); e0("NOT"); return DV; }
  if (is_p("~")) { tp = tp + 1; let d = parse_unary(); discharge(d); e0("BNOT"); return DV; }
  if (is_p("++") || is_p("--")) {
    let plus = is_p("++");
    tp = tp + 1;
    let d = parse_postfix();
    let k = d[0];
    if (k == D_LOCAL) { e1("LOAD", d[1]); e1("INT", 1); e0(plus ? "ADD" : "SUB"); e0("DUP"); e1("STORE", d[1]); }
    else if (k == D_GLOBAL) { e1("GLOAD", d[1]); e1("INT", 1); e0(plus ? "ADD" : "SUB"); e0("DUP"); e1("GSTORE", d[1]); }
    else if (k == D_INDEX || k == D_MEMBER) {
      if (k == D_MEMBER) e1("CONST", d[1]);
      e0("DUP2"); e0("GET"); e1("INT", 1); e0(plus ? "ADD" : "SUB"); e0("SET");
    } else err_at(tp - 1, "自增自减的目标不是变量");
    return DV;
  }
  return parse_postfix();
}

function binary_prec(s) {
  if (s == "*" || s == "/" || s == "%") return 10;
  if (s == "+" || s == "-") return 9;
  if (s == "<<" || s == ">>") return 8;
  if (s == "<" || s == "<=" || s == ">" || s == ">=") return 7;
  if (s == "==" || s == "!=") return 6;
  if (s == "&") return 5;
  if (s == "^") return 4;
  if (s == "|") return 3;
  if (s == "&&") return 2;
  if (s == "||") return 1;
  return 0;
}
function binary_op(s) {
  if (s == "*") return "MUL";
  if (s == "/") return "DIV";
  if (s == "%") return "MOD";
  if (s == "+") return "ADD";
  if (s == "-") return "SUB";
  if (s == "<<") return "SHL";
  if (s == ">>") return "SHR";
  if (s == "<") return "LT";
  if (s == "<=") return "LE";
  if (s == ">") return "GT";
  if (s == ">=") return "GE";
  if (s == "==") return "EQ";
  if (s == "!=") return "NE";
  if (s == "&") return "BAND";
  if (s == "^") return "BXOR";
  return "BOR";
}

function parse_binary(minp) {
  let d = parse_unary();
  for (;;) {
    if (tk_type[tp] != T_P) return d;
    let s = tk_val[tp];
    let p = binary_prec(s);
    if (p == 0 || p < minp) return d;
    tp = tp + 1;
    discharge(d);
    if (s == "&&") {
      let j = emit_jump("JZK");
      let r = parse_binary(p + 1);
      discharge(r);
      patch(j);
    } else if (s == "||") {
      let j = emit_jump("JNZK");
      let r = parse_binary(p + 1);
      discharge(r);
      patch(j);
    } else {
      let r = parse_binary(p + 1);
      discharge(r);
      e0(binary_op(s));
    }
    d = DV;
  }
}

function assign_op(s) {
  if (s == "+=") return "ADD";
  if (s == "-=") return "SUB";
  if (s == "*=") return "MUL";
  if (s == "/=") return "DIV";
  if (s == "%=") return "MOD";
  return null;
}

function parse_expr() {
  let d = parse_binary(1);
  if (tk_type[tp] == T_P) {
    let s = tk_val[tp];
    if (s == "?") {
      discharge(d);
      tp = tp + 1;
      let j1 = emit_jump("JZ");
      parse_expr();
      expect_p(":");
      let j2 = emit_jump("JMP");
      patch(j1);
      parse_expr();
      patch(j2);
      return;
    }
    let k = d[0];
    if (s == "=") {
      tp = tp + 1;
      if (k == D_LOCAL) { parse_expr(); e0("DUP"); e1("STORE", d[1]); return; }
      if (k == D_GLOBAL) { parse_expr(); e0("DUP"); e1("GSTORE", d[1]); return; }
      if (k == D_INDEX) { parse_expr(); e0("SET"); return; }
      if (k == D_MEMBER) { e1("CONST", d[1]); parse_expr(); e0("SET"); return; }
      err_at(tp - 1, "赋值目标无效");
    }
    let aop = assign_op(s);
    if (aop != null) {
      tp = tp + 1;
      if (k == D_LOCAL) { e1("LOAD", d[1]); parse_expr(); e0(aop); e0("DUP"); e1("STORE", d[1]); return; }
      if (k == D_GLOBAL) { e1("GLOAD", d[1]); parse_expr(); e0(aop); e0("DUP"); e1("GSTORE", d[1]); return; }
      if (k == D_INDEX) { e0("DUP2"); e0("GET"); parse_expr(); e0(aop); e0("SET"); return; }
      if (k == D_MEMBER) { e1("CONST", d[1]); e0("DUP2"); e0("GET"); parse_expr(); e0(aop); e0("SET"); return; }
      err_at(tp - 1, "赋值目标无效");
    }
  }
  discharge(d);
}

// —— 语句 ——
function parse_block() {
  expect_p("{");
  let saved = nslots;
  push_scope();
  while (!is_p("}")) {
    if (tk_type[tp] == T_EOF) err_at(tp, "代码块没有结束");
    parse_stmt();
  }
  tp = tp + 1;
  pop_scope(saved);
}

function parse_let() {
  // 当前已跳过 let/const/var
  for (;;) {
    let name = expect_id();
    if (in_function) {
      if (accept_p("=")) { parse_expr(); } else { e0("NULL"); }
      let slot = declare_local(name);
      e1("STORE", slot);
    } else {
      let g = global_map["g:" + name];
      if (accept_p("=")) { parse_expr(); } else { e0("NULL"); }
      e1("GSTORE", g);
    }
    if (!accept_p(",")) break;
  }
}

function close_tries(down_to) {
  let i = try_depth;
  while (i > down_to) { e0("ENDTRY"); i = i - 1; }
}

function parse_stmt() {
  mark_line();
  let ty = tk_type[tp], v = tk_val[tp];
  if (ty == T_P) {
    if (v == "{") { parse_block(); return; }
    if (v == ";") { tp = tp + 1; return; }
  }
  if (ty == T_KW) {
    if (v == "let" || v == "const" || v == "var") {
      tp = tp + 1;
      parse_let();
      accept_p(";");
      return;
    }
    if (v == "if") {
      tp = tp + 1;
      expect_p("(");
      parse_expr();
      expect_p(")");
      let j = emit_jump("JZ");
      parse_stmt();
      if (is_kw("else")) {
        tp = tp + 1;
        let e = emit_jump("JMP");
        patch(j);
        parse_stmt();
        patch(e);
      } else patch(j);
      return;
    }
    if (v == "while") {
      tp = tp + 1;
      let top = len(code);
      expect_p("(");
      parse_expr();
      expect_p(")");
      let j = emit_jump("JZ");
      let lp = { breaks: [], conts: [], depth: try_depth };
      push(loops, lp);
      parse_stmt();
      pop(loops);
      for (let i = 0; i < len(lp.conts); i++) code[lp.conts[i]] = top;
      e1("JMP", top);
      patch(j);
      for (let i = 0; i < len(lp.breaks); i++) patch(lp.breaks[i]);
      return;
    }
    if (v == "for") { parse_for(); return; }
    if (v == "break") {
      tp = tp + 1;
      accept_p(";");
      if (len(loops) == 0) err_at(tp - 1, "break 不在循环内");
      let lp = loops[len(loops) - 1];
      close_tries(lp.depth);
      push(lp.breaks, emit_jump("JMP"));
      return;
    }
    if (v == "continue") {
      tp = tp + 1;
      accept_p(";");
      if (len(loops) == 0) err_at(tp - 1, "continue 不在循环内");
      let lp = loops[len(loops) - 1];
      close_tries(lp.depth);
      push(lp.conts, emit_jump("JMP"));
      return;
    }
    if (v == "return") {
      tp = tp + 1;
      if (accept_p(";") || is_p("}")) { e0("NULL"); }
      else { parse_expr(); accept_p(";"); }
      close_tries(0);
      e0("RET");
      return;
    }
    if (v == "throw") {
      tp = tp + 1;
      parse_expr();
      accept_p(";");
      e0("THROW");
      return;
    }
    if (v == "try") {
      tp = tp + 1;
      let t = emit_jump("TRY");
      try_depth = try_depth + 1;
      parse_block();
      try_depth = try_depth - 1;
      e0("ENDTRY");
      let e = emit_jump("JMP");
      patch(t);
      if (!is_kw("catch")) err_at(tp, "try 后面应有 catch");
      tp = tp + 1;
      let saved = nslots;
      push_scope();
      if (accept_p("(")) {
        let name = expect_id();
        expect_p(")");
        let slot = declare_local(name);
        e1("STORE", slot);
      } else {
        e0("POP");
      }
      parse_block();
      pop_scope(saved);
      patch(e);
      return;
    }
    if (v == "function") err_at(tp, "函数只能定义在文件顶层");
  }
  parse_expr();
  accept_p(";");
  e0("POP");
}

function parse_for() {
  tp = tp + 1;
  expect_p("(");
  let saved = nslots;
  push_scope();
  // for (let x of arr)
  if ((is_kw("let") || is_kw("const") || is_kw("var")) && tk_type[tp + 1] == T_ID && tk_type[tp + 2] == T_KW && tk_val[tp + 2] == "of") {
    let name = tk_val[tp + 1];
    tp = tp + 3;
    let arr_slot = hidden_local();
    let idx_slot = hidden_local();
    let var_slot = declare_local(name);
    parse_expr();
    expect_p(")");
    e1("STORE", arr_slot);
    e1("INT", 0);
    e1("STORE", idx_slot);
    let top = len(code);
    e1("LOAD", idx_slot);
    e1("LOAD", arr_slot);
    e2("BI", import_idx("len"), 1);
    e0("LT");
    let j = emit_jump("JZ");
    e1("LOAD", arr_slot);
    e1("LOAD", idx_slot);
    e0("GET");
    e1("STORE", var_slot);
    let lp = { breaks: [], conts: [], depth: try_depth };
    push(loops, lp);
    parse_stmt();
    pop(loops);
    let cont = len(code);
    for (let i = 0; i < len(lp.conts); i++) code[lp.conts[i]] = cont;
    e1("LOAD", idx_slot);
    e1("INT", 1);
    e0("ADD");
    e1("STORE", idx_slot);
    e1("JMP", top);
    patch(j);
    for (let i = 0; i < len(lp.breaks); i++) patch(lp.breaks[i]);
    pop_scope(saved);
    return;
  }
  // 普通三段式
  if (!accept_p(";")) {
    if (is_kw("let") || is_kw("const") || is_kw("var")) { tp = tp + 1; parse_let(); }
    else { parse_expr(); e0("POP"); }
    expect_p(";");
  }
  let top = len(code);
  let j = -1;
  if (!accept_p(";")) {
    parse_expr();
    expect_p(";");
    j = emit_jump("JZ");
  }
  let body_jump = -1, step_top = -1;
  if (!accept_p(")")) {
    body_jump = emit_jump("JMP");
    step_top = len(code);
    parse_expr();
    e0("POP");
    e1("JMP", top);
    expect_p(")");
    patch(body_jump);
  }
  let lp = { breaks: [], conts: [], depth: try_depth };
  push(loops, lp);
  parse_stmt();
  pop(loops);
  let cont_target = step_top >= 0 ? step_top : top;
  for (let i = 0; i < len(lp.conts); i++) code[lp.conts[i]] = cont_target;
  e1("JMP", cont_target);
  if (j >= 0) patch(j);
  for (let i = 0; i < len(lp.breaks); i++) patch(lp.breaks[i]);
  pop_scope(saved);
}

function parse_function() {
  // 当前位于 function 之后
  let name = expect_id();
  let f = fn_index(name);
  if (funcs[f][3] != -1) err_at(tp - 1, "函数重复定义：" + name);
  expect_p("(");
  scopes = [];
  push_scope();
  nslots = 0; maxslots = 0; loops = []; try_depth = 0;
  in_function = true;
  let np = 0;
  if (!accept_p(")")) {
    for (;;) {
      declare_local(expect_id());
      np = np + 1;
      if (accept_p(")")) break;
      expect_p(",");
    }
  }
  funcs[f][1] = np;
  funcs[f][3] = len(code);
  parse_block();
  e0("NULL");
  e0("RET");
  funcs[f][2] = maxslots;
  in_function = false;
  scopes = [];
}

// 预扫描顶层名字：函数可以先用后定义，全局变量可以被其前面的函数使用
function prescan() {
  let i = 0, depth = 0, n = len(tk_type);
  while (i < n) {
    let ty = tk_type[i], v = tk_val[i];
    if (ty == T_P) {
      if (v == "{" || v == "(" || v == "[") depth = depth + 1;
      else if (v == "}" || v == ")" || v == "]") depth = depth - 1;
    } else if (ty == T_KW && depth == 0) {
      if (v == "function") {
        if (tk_type[i + 1] != T_ID) err_at(i + 1, "function 后面应是函数名");
        fn_index(tk_val[i + 1]);
      } else if (v == "let" || v == "const" || v == "var") {
        let j = i + 1, d = 0, expect = true;
        for (;;) {
          let t2 = tk_type[j], v2 = tk_val[j];
          if (t2 == T_EOF) break;
          if (t2 == T_P) {
            if (v2 == "{" || v2 == "(" || v2 == "[") d = d + 1;
            else if (v2 == "}" || v2 == ")" || v2 == "]") d = d - 1;
            else if (v2 == ";" && d == 0) break;
            else if (v2 == "," && d == 0) expect = true;
          } else if (expect && d == 0 && t2 == T_ID) {
            if (global_map["g:" + v2] == null) { global_map["g:" + v2] = nglobals; nglobals = nglobals + 1; }
            expect = false;
          }
          j = j + 1;
        }
        i = j;
        continue;
      }
    }
    i = i + 1;
  }
}

// 把 JSON 文本拼出来（保持结果确定，便于校验自举不动点）
function compile_source(path, src, reader, compiler_id) {
  init_tables();
  let deps = [];
  load_tokens(path, src, reader, deps, {});
  push(tk_type, T_EOF); push(tk_val, "文件结尾"); push(tk_line, 0); push(tk_file, 0);
  prescan();
  let start = fn_index("__start");
  let has_main = fn_map["f:main"] != null;
  // 顶层语句按出现顺序放进 __start，函数体单独生成
  let init_jump = -1;
  funcs[start][1] = 1;
  funcs[start][3] = len(code);
  scopes = [];
  // 第一遍：生成函数和顶层语句。顶层语句与函数体交错时用跳转串起来。
  tp = 0;
  let pending = [];
  in_function = false;
  while (tk_type[tp] != T_EOF) {
    if (is_kw("function")) {
      let j = emit_jump("JMP");
      tp = tp + 1;
      parse_function();
      patch(j);
      continue;
    }
    if (tk_type[tp] == T_P && tk_val[tp] == ";") { tp = tp + 1; continue; }
    // 顶层语句在 __start 的帧里运行（slot 0 是 args）
    mark_line();
    if (is_kw("let") || is_kw("const") || is_kw("var")) {
      tp = tp + 1;
      in_function = false;
      scopes = [{}];
      nslots = 1; maxslots = maxslots > 1 ? maxslots : 1;
      parse_let();
      accept_p(";");
      scopes = [];
      continue;
    }
    scopes = [{}];
    nslots = 1;
    in_function = true;
    parse_stmt();
    in_function = false;
    scopes = [];
  }
  if (has_main) {
    e1("LOAD", 0);
    e2("CALL", fn_map["f:main"], 1);
    e0("RET");
  } else {
    e0("NULL");
    e0("RET");
  }
  funcs[start][2] = 8;
  for (let i = 0; i < len(funcs); i++) {
    if (funcs[i][3] == -1) throw path + ": 调用了没有定义的函数 " + funcs[i][0];
  }
  let header = { nbc: 1, path: path, deps: deps, compiler: compiler_id };
  let body = { funcs: funcs, consts: consts, globals: nglobals, imports: imports, entry: start, code: code, lines: lines, files: files };
  return json_str(header) + "\n" + json_str(body);
}

function reader_sys(p) {
  let r = sys("fs_read", p);
  if (type(r) == "map" && r.error != null) return null;
  return r;
}

// 作为进程运行：args = { path, compiler_id }；退出值 { ok, text } 或 { ok:false, error }
function main(args) {
  try {
    let src = reader_sys(args.path);
    if (src == null) return { ok: false, error: "找不到源文件 " + args.path };
    let out = compile_source(args.path, src, reader_sys, args.compiler_id);
    return { ok: true, text: out };
  } catch (e) {
    return { ok: false, error: str(e) };
  }
}
