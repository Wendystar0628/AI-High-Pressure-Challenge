// 系统接口的薄封装。所有服务都经 sys() 陷入本系统内核。
function time() { return sys("time"); }
function sleep(d) { return sys("sleep", d); }
function self() { return sys("self"); }
function send(pid, data) { return sys("send", pid, data); }
function recv(timeout) { return sys("recv", timeout); }
function spawn(path, args, opts) { return sys("spawn", path, args, opts); }
function print(x) { return sys("print", x); }
function read_file(path) {
  let r = sys("fs_read", path);
  if (type(r) == "map" && r.error != null) return null;
  return r;
}
function write_file(path, text) { return sys("fs_write", path, text); }
function is_err(r) { return type(r) == "map" && r.error != null; }
function ext_of(path) {
  let i = last_index_of(path, ".");
  return i < 0 ? "" : lower(substr(path, i + 1));
}
function base_of(path) {
  let i = last_index_of(path, "/");
  return i < 0 ? path : substr(path, i + 1);
}
function dir_of(path) {
  let i = last_index_of(path, "/");
  if (i <= 0) return "/";
  return substr(path, 0, i);
}
function clampf(v, a, b) { return v < a ? a : (v > b ? b : v); }
