// 飞行场景进程：持有机体状态。记录回放按记录的控制时序演化（不随预算变化）；
// 排演时机体随虚拟时间连续演化，不等待飞控；控制量保持到下一次写入。
include "/System/lib/flightsim.nest";

const CHECK_EVERY = 30;      // 每 0.25 秒留一个检查点，跳转时从最近的检查点重算
const TRACE_EVERY = 8;       // 每 1/15 秒给特效进程一个轨迹样本

let TL = 0, FX = 0, UI = 0;
let SCENE = null;
let W = null;
let S = null;
let MODE = "static";         // record | rehearsal | keyframe | static
let REC = null;              // { controls, events, duration }
let CTL_I = 0, EV_I = 0;
let CHECKS = [];
let EV_SENT = 0;
let BUS = "";
let LAST_CTL = -1;
let GOAL = null;
let SHOTS = null;
let CTL_PERIOD = 0;
let LAST_CTL_T = 0;
let LIVE_CONTROLS = [], LIVE_EVENTS = [];
let TRACKS = null;
let DURATION = 15;
let FPS = 60;
let DEFAULT_CAM = null;

function reset_sim() {
  S = sim_init(W, W.F.init);
  CTL_I = 0;
  EV_I = 0;
  EV_SENT = 0;
  W.near_step = -1000;
  CHECKS = [{ s: copy(S), ctl: 0, ev: 0 }];
}
function load_scene(text, record) {
  SCENE = json_parse(text);
  // 贴图和几何留在显示设备那边，这里只保留飞行要用的数据
  SCENE.textures = null;
  SCENE.geometries = null;
  DURATION = SCENE.duration != null ? SCENE.duration : 10;
  FPS = SCENE.fps != null ? SCENE.fps : 60;
  SHOTS = null;
  if (SCENE.cameras != null) { SHOTS = SCENE.cameras.show; DEFAULT_CAM = SCENE.cameras.default; }
  if (SCENE.flight != null && SCENE.terrain != null) {
    W = world_from_scene(SCENE);
    REC = record != null ? record : SCENE.flight.record;
    if (REC == null) REC = { controls: [], events: [], duration: DURATION };
    if (REC.duration != null) DURATION = REC.duration;
    MODE = "record";
    reset_sim();
  } else if (SCENE.timeline != null) {
    MODE = "keyframe";
    TRACKS = SCENE.timeline.tracks;
    if (SCENE.timeline.duration != null) DURATION = SCENE.timeline.duration;
  } else {
    MODE = "static";
  }
  sys("send", TL, { type: "loaded", duration: DURATION, fps: FPS });
}
function apply_record_until(step) {
  let c = REC.controls;
  while (CTL_I < len(c) && c[CTL_I][0] <= step) {
    let e = c[CTL_I];
    S.ctl = { collective: e[1], pitch: e[2], roll: e[3], yaw: e[4], throttle: e[5] };
    CTL_I = CTL_I + 1;
  }
  let ev = REC.events;
  while (EV_I < len(ev) && ev[EV_I][0] <= step) {
    let e = ev[EV_I];
    sim_input(W, S, e[1], e[2], e[3]);
    EV_I = EV_I + 1;
  }
}
function trace_sample() {
  let g = terrain_height(W, S.x, S.z);
  return [S.t, S.x, S.y, S.z, S.vx, S.vy, S.vz, S.omega, S.agl, S.surface == "concrete" ? 0 : 1, S.crashed ? 1 : 0, S.fire_t, S.smoke_t, g];
}
function flush_trace(buf) {
  let evs = null;
  if (len(S.events) > EV_SENT) {
    evs = slice(S.events, EV_SENT);
    EV_SENT = len(S.events);
  }
  if (len(buf) > 0 || evs != null) sys("send", FX, { type: "trace", samples: buf, events: evs });
}
// 把模拟推进到时刻 t（物理步长对齐）。记录模式可以回退；排演模式时间只向前。
function advance(t) {
  let target = floor(t / SIM_H + 0.001);
  if (MODE == "record" && target < S.step) {
    // 回到最近的检查点
    let i = len(CHECKS) - 1;
    while (i > 0 && CHECKS[i].s.step > target) i = i - 1;
    let ck = CHECKS[i];
    S = copy(ck.s);
    CTL_I = ck.ctl;
    EV_I = ck.ev;
    EV_SENT = len(S.events);
    W.near_step = -1000;
    while (len(CHECKS) > i + 1) pop(CHECKS);
    sys("send", FX, { type: "truncate", t: S.t, ev: EV_SENT });
  }
  let buf = [];
  while (S.step < target) {
    if (MODE == "record") apply_record_until(S.step);
    else read_controls();
    sim_step(W, S, SIM_H);
    if (S.step % TRACE_EVERY == 0) {
      push(buf, trace_sample());
      if (len(buf) >= 8) { flush_trace(buf); buf = []; }
    }
    if (S.step % CHECK_EVERY == 0) {
      let last = CHECKS[len(CHECKS) - 1];
      if (S.step > last.s.step) push(CHECKS, { s: copy(S), ctl: CTL_I, ev: EV_I });
    }
    if (MODE == "rehearsal" && S.step % 4 == 0) write_sensors();
  }
  flush_trace(buf);
  if (MODE == "rehearsal") write_sensors();
}
function write_sensors() {
  let s = sim_sensors(W, S);
  s.goal = GOAL;
  sys("bus_write", BUS + "/sensors", s);
}
function num_or(v, d) { return type(v) == "number" && !is_nan(v) ? v : d; }
function read_controls() {
  let c = sys("bus_read", BUS + "/control");
  if (c == null || c.t == LAST_CTL) return;
  LAST_CTL = c.t;
  let now = S.t;
  let p = now - LAST_CTL_T;
  LAST_CTL_T = now;
  if (p > 0) CTL_PERIOD = CTL_PERIOD == 0 ? p : CTL_PERIOD + (p - CTL_PERIOD) * 0.2;
  S.ctl = { collective: clamp_num(num_or(c.collective, 0), 0, 1), pitch: clamp_num(num_or(c.pitch, 0), -1, 1), roll: clamp_num(num_or(c.roll, 0), -1, 1), yaw: clamp_num(num_or(c.yaw, 0), -1, 1), throttle: clamp_num(num_or(c.throttle, 1), 0, 1) };
  push(LIVE_CONTROLS, [S.step, S.ctl.collective, S.ctl.pitch, S.ctl.roll, S.ctl.yaw, S.ctl.throttle]);
}
function current_yaw() {
  let f = q_rot(S.q, 1, 0, 0);
  return atan2(f[2], f[0]);
}
function start_rehearsal(bus) {
  BUS = bus;
  if (MODE != "record") {
    if (MODE != "rehearsal") { sys("send", UI, { type: "note", text: "这个场景没有飞行模型，不能排演", err: true }); return; }
  }
  // 从当前状态续演：之前的控制时序作为新记录的前缀
  LIVE_CONTROLS = [];
  LIVE_EVENTS = [];
  if (REC != null) {
    for (let c of REC.controls) if (c[0] < S.step) push(LIVE_CONTROLS, c);
    for (let e of REC.events) if (e[0] < S.step) push(LIVE_EVENTS, e);
  }
  MODE = "rehearsal";
  LAST_CTL = -1;
  LAST_CTL_T = S.t;
  CTL_PERIOD = 0;
  let sp = sqrt(S.vx * S.vx + S.vz * S.vz);
  let ground = terrain_height(W, S.x, S.z);
  GOAL = { mode: "cruise", heading: current_yaw(), y: S.y < ground + 16 ? ground + 16 : S.y, speed: sp < 1 ? 0 : sp, x: S.x, z: S.z };
  sys("bus_write", BUS + "/control", null);
  write_sensors();
}
function end_rehearsal() {
  if (MODE != "rehearsal") return;
  REC = { controls: LIVE_CONTROLS, events: LIVE_EVENTS, duration: S.t };
  MODE = "record";
  CTL_I = len(REC.controls);
  EV_I = len(REC.events);
  DURATION = S.t;
  sys("send", TL, { type: "loaded", duration: DURATION, fps: FPS });
}
function keyframe_parts(t) {
  let out = [];
  if (TRACKS == null) return out;
  for (let tr of TRACKS) {
    let ts = tr.times;
    let n = len(ts);
    if (n == 0) continue;
    let i = 0;
    while (i < n - 1 && ts[i + 1] <= t) i = i + 1;
    let a = i, b = i + 1 < n ? i + 1 : i;
    let k = b > a && ts[b] > ts[a] ? clamp_num((t - ts[a]) / (ts[b] - ts[a]), 0, 1) : 0;
    let px = 0, py = 0, pz = 0;
    if (tr.pos != null) {
      px = tr.pos[a * 3] + (tr.pos[b * 3] - tr.pos[a * 3]) * k;
      py = tr.pos[a * 3 + 1] + (tr.pos[b * 3 + 1] - tr.pos[a * 3 + 1]) * k;
      pz = tr.pos[a * 3 + 2] + (tr.pos[b * 3 + 2] - tr.pos[a * 3 + 2]) * k;
    }
    let q = [0, 0, 0, 1];
    if (tr.rot != null) {
      let qa = [tr.rot[a * 4], tr.rot[a * 4 + 1], tr.rot[a * 4 + 2], tr.rot[a * 4 + 3]];
      let qb = [tr.rot[b * 4], tr.rot[b * 4 + 1], tr.rot[b * 4 + 2], tr.rot[b * 4 + 3]];
      q = q_norm([qa[0] + (qb[0] - qa[0]) * k, qa[1] + (qb[1] - qa[1]) * k, qa[2] + (qb[2] - qa[2]) * k, qa[3] + (qb[3] - qa[3]) * k]);
    }
    push(out, [tr.part, px, py, pz, q[0], q[1], q[2], q[3], tr.world ? 1 : 0, 0, 1]);
  }
  return out;
}
function static_cam(cam) {
  let d = DEFAULT_CAM;
  let target = d != null ? d.target : [0, 0, 0];
  let pos = d != null ? d.pos : [6, 4, 8];
  let fov = d != null && d.fov != null ? d.fov : 45;
  if (cam.mode == "free") {
    let c = cos(cam.orbit.pitch);
    return [target[0] + cos(cam.orbit.yaw) * c * cam.orbit.dist, target[1] + sin(cam.orbit.pitch) * cam.orbit.dist, target[2] + sin(cam.orbit.yaw) * c * cam.orbit.dist, target[0], target[1], target[2], fov];
  }
  return [pos[0], pos[1], pos[2], target[0], target[1], target[2], fov];
}
function on_frame(d) {
  let f = null;
  if (MODE == "record" || MODE == "rehearsal") {
    advance(d.t);
    let g = terrain_height(W, S.x, S.z);
    let strength = S.crashed ? 0 : clamp_num(S.omega * S.omega * (1 - S.agl / 14), 0, 1);
    let shots = MODE == "rehearsal" ? null : SHOTS;
    let cam_mode = d.cam.mode;
    let cam = cam_compute(W, S, cam_mode, d.cam.orbit, shots, S.t);
    f = {
      type: "f", n: d.n, t: S.t, parts: sim_parts(W, S), cam: cam, dents: S.dents, focus: [S.x, S.y, S.z], wind: [S.windx, S.windz],
      down: [S.x, g, S.z, strength], crashed: S.crashed, agl: S.agl, speed: sqrt(S.vx * S.vx + S.vy * S.vy + S.vz * S.vz), ctl_period: CTL_PERIOD
    };
  } else if (MODE == "keyframe") {
    f = { type: "f", n: d.n, t: d.t, parts: keyframe_parts(d.t), cam: static_cam(d.cam), wind: [0, 0], agl: 0, speed: 0 };
  } else {
    f = { type: "f", n: d.n, t: d.t, parts: [], cam: static_cam(d.cam), wind: [0, 0], agl: 0, speed: 0 };
  }
  sys("send", TL, f);
}
function on_msg(m) {
  let d = m.data;
  if (d == null) return;
  let t = d.type;
  if (t == "init") { FX = d.fx; UI = d.ui; return; }
  if (t == "load") {
    try {
      load_scene(d.text, d.record);
    } catch (e) {
      sys("send", UI, { type: "note", text: "场景内容有误：" + str(e), err: true });
      MODE = "static";
      sys("send", TL, { type: "loaded", duration: 1, fps: 60 });
    }
    return;
  }
  if (t == "frame") { on_frame(d); return; }
  if (t == "rehearsal") { start_rehearsal(d.bus); return; }
  if (t == "end_rehearsal") { end_rehearsal(); return; }
  if (t == "input") {
    if (S == null) return;
    sim_input(W, S, d.kind, d.a, d.b);
    if (MODE == "rehearsal") push(LIVE_EVENTS, [S.step, d.kind, d.a, d.b]);
    return;
  }
  if (t == "goal_heading") {
    if (GOAL != null) { GOAL.mode = "cruise"; GOAL.heading = d.heading; if (GOAL.speed < 8) GOAL.speed = 10; }
    return;
  }
  if (t == "ground_click") {
    if (GOAL != null) { GOAL.mode = "cruise"; GOAL.heading = atan2(d.z - S.z, d.x - S.x); if (GOAL.speed < 8) GOAL.speed = 10; }
    return;
  }
  if (t == "goal_land") {
    if (GOAL != null && W.F.pads != null) {
      let pad = W.F.pads[d.index];
      GOAL = { mode: "land", heading: current_yaw(), y: pad.y + W.F.skid_height + 12, speed: 13, x: pad.x, z: pad.z };
    }
    return;
  }
  if (t == "goal_hover") {
    if (GOAL != null) GOAL = { mode: "point", heading: current_yaw(), y: S.y, speed: 6, x: S.x, z: S.z };
    return;
  }
  if (t == "part_status") {
    let st = W != null && S != null ? sim_part_status(W, S, d.name) : "完好";
    sys("send", UI, { type: "part_info", name: d.name, status: st });
    return;
  }
  if (t == "get_record") {
    let rec = null;
    if (MODE == "rehearsal") rec = { dt: SIM_H, controls: LIVE_CONTROLS, events: LIVE_EVENTS, duration: S.t };
    else if (REC != null) rec = { dt: SIM_H, controls: REC.controls, events: REC.events, duration: DURATION };
    sys("send", UI, { type: "record", rec: rec });
    return;
  }
}
function main(args) {
  TL = args.timeline;
  for (;;) {
    let m = sys("recv");
    on_msg(m);
  }
}
