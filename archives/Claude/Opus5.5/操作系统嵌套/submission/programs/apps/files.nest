// 文件管理器：子系统的文件操作都走本系统内核的文件接口。
include "/System/lib/ui.nest";

let CWD = "/Documents";
let ENTRIES = [];
let SEL = {};            // 路径 -> true
let ANCHOR = -1;
let SCROLL = 0;
let CLIP = null;         // { paths, cut }
let HISTORY = [];
let PROMPT = null;       // { kind, value, target }
let STATUS = "";
let STATUS_ERR = false;
let MENU = null;
let PATH_TEXT = "/Documents";
const NAV = [["文档", "/Documents"], ["下载", "/Downloads"], ["演示", "/Demo"], ["程序", "/Programs"], ["飞控", "/Flight"], ["系统", "/System"], ["子系统", "/Systems"], ["快照", "/Snapshots"], ["根目录", "/"]];
const ROW_H = 34;

function set_status(t, is_e) { STATUS = t; STATUS_ERR = is_e == true; ui_invalidate(); }
function reload() {
  let l = sys("fs_list", CWD);
  if (is_err(l)) { set_status(l.error, true); ENTRIES = []; }
  else ENTRIES = l;
  PATH_TEXT = CWD;
  let keep = {};
  for (let e of ENTRIES) if (SEL[e.path]) keep[e.path] = true;
  SEL = keep;
  ui_invalidate();
}
function go(path) {
  if (path != CWD) push(HISTORY, CWD);
  CWD = path;
  SEL = {};
  SCROLL = 0;
  reload();
}
function selected() {
  let out = [];
  for (let e of ENTRIES) if (SEL[e.path]) push(out, e.path);
  return out;
}
function open_entry(e) {
  if (e.type == "dir") { go(e.path); return; }
  let x = ext_of(e.path);
  let app = (x == "scene" || x == "flight") ? "/System/apps/player.nest" : "/System/apps/editor.nest";
  let r = spawn(app, { file: e.path }, { kind: "app" });
  if (is_err(r)) set_status(r.error, true);
}
function child_path(name) { return (CWD == "/" ? "" : CWD) + "/" + name; }
function unique_name(name) {
  let n = name, i = 2;
  while (sys("fs_stat", child_path(n)) != null) {
    let dot = last_index_of(name, ".");
    n = dot > 0 ? substr(name, 0, dot) + " (" + str(i) + ")" + substr(name, dot) : name + " (" + str(i) + ")";
    i = i + 1;
  }
  return n;
}
function do_paste() {
  if (CLIP == null) return;
  for (let p of CLIP.paths) {
    let target = child_path(unique_name(base_of(p)));
    let r = CLIP.cut ? sys("fs_rename", p, target) : sys("fs_copy", p, target);
    if (is_err(r)) { set_status(r.error, true); return; }
  }
  if (CLIP.cut) CLIP = null;
  set_status("已粘贴", false);
  reload();
}
function do_delete() {
  let s = selected();
  if (len(s) == 0) return;
  for (let p of s) {
    let r = sys("fs_delete", p);
    if (is_err(r)) { set_status(r.error, true); return; }
  }
  sys("notify", "已删除 " + str(len(s)) + " 项", "info");
  set_status("已删除 " + str(len(s)) + " 项", false);
  reload();
}
function confirm_prompt() {
  let p = PROMPT;
  PROMPT = null;
  if (p == null) return;
  let name = trim(p.value);
  if (name == "") { ui_invalidate(); return; }
  let r = true;
  if (p.kind == "file") r = sys("fs_write", child_path(name), "");
  else if (p.kind == "dir") r = sys("fs_mkdir", child_path(name));
  else if (p.kind == "rename") r = sys("fs_rename", p.target, child_path(name));
  if (is_err(r)) set_status(r.error, true);
  else set_status("完成", false);
  reload();
}
function do_export() {
  let s = selected();
  if (len(s) != 1) { set_status("请选择一个文件再保存到本机", true); return; }
  let t = read_file(s[0]);
  if (t == null) { set_status("只能保存文件", true); return; }
  let r = sys("host_export", base_of(s[0]), t);
  if (is_err(r)) set_status(r.error, true); else if (r != null && r.path != null) set_status("已保存到本机：" + r.path, false);
}

function render(v) {
  let W = v.w, H = v.h;
  let out = [];
  let x = 8;
  let tools = [
    ["后退", "back", "files-back"], ["上级", "up", "files-up"], ["新建文件", "new_file", "files-new-file"], ["新建目录", "new_dir", "files-new-folder"],
    ["打开", "open", "files-open"], ["复制", "copy", "files-copy"], ["剪切", "cut", "files-cut"], ["粘贴", "paste", "files-paste"], ["重命名", "rename", "files-rename"], ["删除", "delete", "files-delete"],
    ["导出", "export", "files-export"], ["导入", "import", "files-import"]
  ];
  for (let t of tools) {
    let bw = len(t[0]) * 13 + 14;
    if (x + bw > W - 6) break;
    push(out, B("b" + t[1], x, 6, bw, 28, t[0], t[1], null, { tid: t[2], cls: "small" }));
    x = x + bw + 3;
  }
  push(out, INPUT("path", 8, 40, W - 16, 28, PATH_TEXT, { tid: "files-path", label: "路径" }));
  let top = 74;
  let nav_w = W > 520 ? 118 : 0;
  let body_h = H - top - 26;
  if (nav_w > 0) {
    let nv = [];
    let ny = 4, i = 0;
    for (let n of NAV) {
      let on = CWD == n[1];
      let node = { k: "n" + str(i), x: 6, y: ny, w: nav_w - 12, h: 30, cls: "nav-item" + (on ? " on" : ""), text: n[0], tid: "files-nav", drop: n[1], a: { "data-file-path": n[1] }, label: n[0], role: "button" };
      push(nv, node);
      hit(6, top + ny, nav_w - 12, 30, "nav", n[1]);
      ny = ny + 32;
      i = i + 1;
    }
    push(out, N("nav", 0, top, nav_w, body_h, "nav-pane", nv));
  }
  let lx = nav_w + 2, lw = W - nav_w - 6;
  let rows = [];
  let visible = floor((body_h - 26) / ROW_H) + 1;
  let maxs = len(ENTRIES) - visible + 1;
  if (maxs < 0) maxs = 0;
  if (SCROLL > maxs) SCROLL = maxs;
  let i = SCROLL, y = 26, idx = 0;
  let drag_paths = selected();
  rows = [
    T("hn", 34, 0, lw - 200, 24, "list-head", "名称"),
    T("hs", lw - 150, 0, 70, 24, "list-head", "大小"),
    T("hk", lw - 76, 0, 70, 24, "list-head", "类型")
  ];
  hit(lx, top, lw, body_h, "list_bg", null);
  while (i < len(ENTRIES) && y < body_h) {
    let e = ENTRIES[i];
    let on = SEL[e.path] == true;
    let row = {
      k: "r:" + e.path, x: 0, y: y, w: lw, h: ROW_H - 2, cls: "file-row" + (on ? " selected" : ""), tid: "files-item", label: e.name,
      a: { "data-file-path": e.path }, drag: on && len(drag_paths) > 0 ? drag_paths : [e.path], c: [
        { k: "i", t: "icon", x: 8, y: 7, w: 18, h: 18, icon: e.type == "dir" ? "folder" : "file-" + ext_of(e.name) },
        T("n", 34, 0, lw - 190, ROW_H - 2, "file-name", e.name),
        T("s", lw - 150, 0, 70, ROW_H - 2, "file-meta", e.type == "dir" ? "" : fmt_bytes(e.size)),
        T("k", lw - 76, 0, 70, ROW_H - 2, "file-meta", e.type == "dir" ? "目录" : ext_of(e.name))
      ]
    };
    if (e.type == "dir") row.drop = e.path;
    push(rows, row);
    hit(lx, top + y, lw, ROW_H - 2, "row", i);
    i = i + 1;
    y = y + ROW_H;
    idx = idx + 1;
  }
  if (len(ENTRIES) == 0) push(rows, T("empty", 0, 40, lw, 28, "panel-empty center", "空目录"));
  push(out, { k: "list", x: lx, y: top, w: lw, h: body_h, cls: "file-list", tid: "files-list", drop: CWD, label: "文件列表 " + CWD, c: rows });
  push(out, T("status", 8, H - 24, W - 16, 22, STATUS_ERR ? "status err" : "status", STATUS != "" ? STATUS : str(len(ENTRIES)) + " 项 · " + CWD));
  if (PROMPT != null) {
    push(out, N("pr", floor((W - 340) / 2), 90, 340, 118, "dialog", [
      T("t", 16, 10, 300, 24, "dialog-title small", PROMPT.kind == "rename" ? "重命名" : (PROMPT.kind == "dir" ? "新建目录" : "新建文件")),
      INPUT("prompt", 16, 42, 308, 28, PROMPT.value, { tid: "files-prompt-input", label: "名称" })
    ]));
    let px = floor((W - 340) / 2);
    hit(px, 90, 340, 118, "noop", null);
    push(out, B("ok", px + 170, 170, 74, 28, "确定", "prompt_ok", null, { tid: "files-prompt-ok", cls: "primary small" }));
    push(out, B("no", px + 250, 170, 74, 28, "取消", "prompt_no", null, { tid: "files-prompt-cancel", cls: "small" }));
  }
  if (MENU != null) {
    let items = [["打开", "open"], ["复制", "copy"], ["剪切", "cut"], ["粘贴", "paste"], ["重命名", "rename"], ["删除", "delete"], ["保存到本机", "export"]];
    let mx = MENU.x, my = MENU.y;
    if (mx + 150 > W) mx = W - 150;
    if (my + 8 + len(items) * 30 > H) my = H - 8 - len(items) * 30;
    let kids = [];
    let yy = 4, n = 0;
    hit(mx, my, 150, 8 + len(items) * 30, "noop", null);
    for (let it of items) {
      push(kids, { k: "m" + str(n), x: 4, y: yy, w: 142, h: 28, cls: "menu-item", text: it[0], role: "menuitem", label: it[0] });
      hit(mx + 4, my + yy, 142, 28, it[1], "menu");
      yy = yy + 30;
      n = n + 1;
    }
    push(out, N("ctxm", mx, my, 150, 8 + len(items) * 30, "ctx-menu", kids));
  }
  return out;
}
function on_act(v, act, data, ev) {
  if (MENU != null) MENU = null;
  ui_invalidate();
  if (act == "row") {
    let e = ENTRIES[data];
    if (e == null) return;
    if (ev.ctrl) {
      if (SEL[e.path]) del(SEL, e.path); else SEL[e.path] = true;
      ANCHOR = data;
    } else if (ev.shift && ANCHOR >= 0) {
      SEL = {};
      let a = min(ANCHOR, data), b = max(ANCHOR, data);
      for (let i = a; i <= b; i++) SEL[ENTRIES[i].path] = true;
    } else {
      if (!SEL[e.path] || len(SEL) > 1) SEL = {};
      SEL[e.path] = true;
      ANCHOR = data;
    }
    return;
  }
  if (act == "list_bg") { SEL = {}; ANCHOR = -1; return; }
  if (act == "nav") { go(data); return; }
  if (act == "back") { if (len(HISTORY) > 0) { CWD = pop(HISTORY); SEL = {}; SCROLL = 0; reload(); } return; }
  if (act == "up") { if (CWD != "/") go(dir_of(CWD)); return; }
  if (act == "new_file") { PROMPT = { kind: "file", value: unique_name("新文件.txt") }; return; }
  if (act == "new_dir") { PROMPT = { kind: "dir", value: unique_name("新目录") }; return; }
  if (act == "rename") {
    let s = selected();
    if (len(s) != 1) { set_status("请选择一个项目再重命名", true); return; }
    PROMPT = { kind: "rename", value: base_of(s[0]), target: s[0] };
    return;
  }
  if (act == "prompt_ok") { confirm_prompt(); return; }
  if (act == "prompt_no") { PROMPT = null; return; }
  if (act == "open") {
    for (let e of ENTRIES) if (SEL[e.path]) { open_entry(e); return; }
    return;
  }
  if (act == "copy") { CLIP = { paths: selected(), cut: false }; set_status("已复制 " + str(len(CLIP.paths)) + " 项", false); return; }
  if (act == "cut") { CLIP = { paths: selected(), cut: true }; set_status("已剪切 " + str(len(CLIP.paths)) + " 项", false); return; }
  if (act == "paste") { do_paste(); return; }
  if (act == "delete") { do_delete(); return; }
  if (act == "export") { do_export(); return; }
  if (act == "import") { sys("host_import", "files"); return; }
}
function on_dbl(v, act, data, ev) {
  if (act == "row") {
    let e = ENTRIES[data];
    if (e != null) open_entry(e);
  }
}
function on_ctx(v, r, ev) {
  if (r != null && r.act == "row") {
    let e = ENTRIES[r.data];
    if (e != null && !SEL[e.path]) { SEL = {}; SEL[e.path] = true; }
  }
  MENU = { x: ev.x, y: ev.y };
  ui_invalidate();
}
function on_wheel(v, r, ev) {
  SCROLL = SCROLL + (ev.dy > 0 ? 2 : -2);
  if (SCROLL < 0) SCROLL = 0;
  ui_invalidate();
}
function on_value(v, key, value) {
  if (key == "path") PATH_TEXT = value;
  else if (key == "prompt" && PROMPT != null) PROMPT.value = value;
}
function on_key(v, ev) {
  if (ev.k != "keydown") return;
  if (ev.key == "Enter") {
    if (PROMPT != null) { confirm_prompt(); return; }
    if (PATH_TEXT != CWD) { go(PATH_TEXT); return; }
    for (let e of ENTRIES) if (SEL[e.path]) { open_entry(e); return; }
    return;
  }
  if (ev.native) return;
  if (ev.key == "Delete") do_delete();
  else if (ev.ctrl && lower(ev.key) == "c") on_act(v, "copy", null, ev);
  else if (ev.ctrl && lower(ev.key) == "v") do_paste();
  else if (ev.ctrl && lower(ev.key) == "a") { for (let e of ENTRIES) SEL[e.path] = true; ui_invalidate(); }
}
function on_msg(m) {
  let d = m.data;
  if (d.type == "fs_changed") reload();
  else if (d.type == "host_file") {
    if (d.error != null) { set_status(d.error, true); return; }
    let r = sys("fs_write", child_path(unique_name(d.name)), d.text);
    if (is_err(r)) set_status(r.error, true);
    else { set_status("已从本机导入 " + d.name, false); reload(); }
  }
}

function main(args) {
  sys("fs_watch");
  app_window("文件管理器", "files", 720, 460, "files");
  if (args != null && args.dir != null) CWD = args.dir;
  reload();
  app_run({ render: render, act: on_act, dbl: on_dbl, ctx: on_ctx, wheel: on_wheel, value: on_value, key: on_key, msg: on_msg }, null);
}
