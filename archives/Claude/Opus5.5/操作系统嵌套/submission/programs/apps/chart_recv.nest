// 数据接收进程：只负责实时数据连接。连接按工作簿文档身份和选区建立，数据是根系统发来的副本。
// 版本只前进不后退；断开后不再改变图表。挂起本进程时已到达的消息留在队列里，继续后按序处理。
let CHART = 0;
let SUB = "";
let VERSION = -1;
let COUNT = 0;

function main(args) {
  CHART = args.chart;
  sys("data_sources", "chart");
  for (;;) {
    let m = sys("recv");
    let d = m.data;
    if (d == null) continue;
    let t = d.type;
    if (t == "connect") {
      if (SUB != "") sys("data_disconnect", SUB);
      VERSION = -1;
      SUB = sys("data_connect", d.doc, d.range);
    } else if (t == "disconnect") {
      if (SUB != "") sys("data_disconnect", SUB);
      SUB = "";
    } else if (t == "data") {
      if (d.sub != SUB || d.version < VERSION) continue;
      VERSION = d.version;
      COUNT = COUNT + 1;
      sys("send", CHART, { type: "chart_data", version: d.version, title: d.title, range: d.range, rows: d.rows, recv_count: COUNT });
    } else if (t == "data_sources") {
      sys("send", CHART, { type: "sources", list: d.list });
    } else if (t == "data_error") {
      if (d.sub == SUB) {
        SUB = "";
        sys("send", CHART, { type: "conn_state", state: "连接失败", cls: " err", note: d.error });
      }
    } else if (t == "data_closed") {
      if (d.sub == SUB) {
        SUB = "";
        sys("send", CHART, { type: "conn_state", state: "数据源已关闭", cls: " warn", note: "“" + str(d.title) + "” 已关闭，保留已接收的数据；重新打开后请重新选择连接" });
      }
    } else if (t == "sys_restored") {
      // 根系统实时数据源不属于子树快照：图表用已接收的数据续行，用户重新连接时建立新连接
      if (SUB != "") {
        SUB = "";
        sys("send", CHART, { type: "conn_state", state: "已恢复，待重新连接", cls: " warn", note: "图表继续显示已接收的数据；点“连接”取得源工作簿当前的完整选区" });
      }
      sys("data_sources", "chart");
    }
  }
}
