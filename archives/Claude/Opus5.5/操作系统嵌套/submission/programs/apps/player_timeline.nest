// 时序进程：按所属系统的虚拟时间推进播放位置，用消息驱动飞行场景进程和环境特效进程，
// 收齐同一时刻的结果后一次性提交给显示设备。播放器暂停时不推进位置，继续时不补跑。
let UI = 0, FLIGHT = 0, FX = 0, WID = "", SYSTEM = "";
let VIDS = [];
let POS = 0, DURATION = 15, STATE = "stopped", RATE = 1, LOOP = false, MODE = "record", FPS = 60;
let SCENE = "";
let LAST_VT = 0;
let N = 0;
let WAIT_F = false, WAIT_X = false;
let NEED = false;
let LAST_F = null, LAST_X = null;
let CAM = { mode: "show", orbit: { yaw: 0.8, pitch: 0.35, dist: 22 } };
let STATUS_AT = 0;
let FRAME_T = 0;
let LOADED = false;
let SENT_FX = false;

function publish(force) {
  let now = sys("time");
  if (!force && now - STATUS_AT < 0.05) return;
  STATUS_AT = now;
  let lf = LAST_F;
  let st = {
    type: "status", pos: POS, duration: DURATION, state: STATE, rate: RATE, loop: LOOP, frame_time: FRAME_T, mode: MODE, fps: FPS,
    lag: lf != null ? POS - lf.t : 0, ctl_period: lf != null && lf.ctl_period != null ? lf.ctl_period : 0, crashed: lf != null && lf.crashed == true, agl: lf != null ? lf.agl : 0, speed: lf != null ? lf.speed : 0
  };
  sys("send", UI, st);
  meta();
}
function meta() {
  sys("meta", "player:" + WID, { windowId: WID, systemId: SYSTEM, state: STATE == "playing" && MODE == "rehearsal" ? "rehearsal" : STATE, position: POS, duration: DURATION, rate: RATE, scene: SCENE, frameTime: FRAME_T, loop: LOOP, camera: CAM.mode, mode: MODE });
}
function proc_ok(pid) {
  let s = sys("proc_state", pid);
  return s != "suspended" && s != "gone" && s != "exited" && s != "fault";
}
// 请求新的一帧：同一时刻只有一帧在途，落后时直接取最新位置
function request_frame() {
  if (WAIT_F || WAIT_X || !LOADED) return;
  NEED = false;
  N = N + 1;
  if (proc_ok(FLIGHT)) {
    WAIT_F = true;
    sys("send", FLIGHT, { type: "frame", n: N, t: POS, cam: CAM });
  } else {
    // 飞行场景进程被挂起：只停止它负责的更新
    after_flight(LAST_F);
  }
}
function after_flight(f) {
  if (f == null) return;
  LAST_F = f;
  if (proc_ok(FX)) {
    WAIT_X = true;
    sys("send", FX, { type: "frame", n: N, t: f.t });
  } else commit();
}
function commit() {
  let f = LAST_F;
  if (f == null) return;
  let x = LAST_X;
  let frame = { t: f.t, parts: f.parts, cam: f.cam, dents: f.dents, focus: f.focus, wind: f.wind, down: f.down };
  if (x != null) {
    frame.lights = x.lights;
    frame.scars = x.scars;
    if (x.fx != null) frame.fx = x.fx;
    else if (!SENT_FX) frame.fx = [];
    SENT_FX = true;
  }
  FRAME_T = f.t;
  for (let v of VIDS) sys("gfx_frame", v, frame);
  publish(false);
}
function set_state(s) {
  STATE = s;
  publish(true);
}
function step_time() {
  let now = sys("time");
  let dt = now - LAST_VT;
  LAST_VT = now;
  if (STATE != "playing" || dt <= 0) return;   // 同一逻辑步内不重复取帧
  POS = POS + dt * RATE;
  NEED = true;
  if (MODE == "rehearsal") {
    if (POS > DURATION) DURATION = POS;
    return;
  }
  if (POS >= DURATION) {
    if (LOOP) {
      POS = POS % DURATION;
    } else {
      POS = DURATION;
      set_state("ended");
    }
  }
}
function on_msg(m) {
  let d = m.data;
  if (d == null) return;
  let t = d.type;
  if (t == "init") { FLIGHT = d.flight; FX = d.fx; return; }
  if (t == "views") { VIDS = d.vids; NEED = true; SENT_FX = false; return; }
  if (t == "refresh") { NEED = true; SENT_FX = false; return; }
  if (t == "load") {
    SCENE = d.path;
    POS = 0;
    STATE = "stopped";
    MODE = "record";
    LOADED = false;
    LAST_X = null;
    SENT_FX = false;
    return;
  }
  if (t == "loaded") {
    DURATION = d.duration;
    FPS = d.fps;
    LOADED = true;
    NEED = true;
    publish(true);
    return;
  }
  if (t == "f") {
    if (d.n != N) return;
    WAIT_F = false;
    after_flight(d);
    return;
  }
  if (t == "x") {
    if (d.n != N) return;
    WAIT_X = false;
    LAST_X = d;
    commit();
    return;
  }
  if (t == "play") {
    if (STATE == "ended" && MODE == "record") { POS = 0; NEED = true; }
    LAST_VT = sys("time");
    set_state("playing");
    return;
  }
  if (t == "pause") { if (STATE == "playing") set_state("paused"); return; }
  if (t == "stop") {
    POS = 0;
    if (MODE == "rehearsal") { end_rehearsal(); POS = 0; }
    NEED = true;
    set_state("stopped");
    return;
  }
  if (t == "replay") {
    if (MODE == "rehearsal") end_rehearsal();
    POS = 0;
    NEED = true;
    LAST_VT = sys("time");
    set_state("playing");
    return;
  }
  if (t == "step") {
    if (STATE == "playing") STATE = "paused";
    if (MODE == "rehearsal") end_rehearsal();
    POS = (floor(POS * FPS + 0.001) + 1) / FPS;
    if (POS > DURATION) POS = DURATION;
    NEED = true;
    if (STATE != "paused") STATE = "paused";
    publish(true);
    return;
  }
  if (t == "seek") {
    // 暂停后跳转仍保持暂停，播放中跳转从新位置继续
    if (MODE == "rehearsal") end_rehearsal();
    POS = d.t;
    if (POS < 0) POS = 0;
    if (POS > DURATION) POS = DURATION;
    if (STATE == "ended") STATE = "paused";
    if (STATE == "stopped") STATE = "paused";
    NEED = true;
    publish(true);
    return;
  }
  if (t == "rate") { RATE = d.rate; LAST_VT = sys("time"); publish(true); return; }
  if (t == "loop") { LOOP = !LOOP; publish(true); return; }
  if (t == "camera") { CAM = { mode: d.mode, orbit: d.orbit }; NEED = true; return; }
  if (t == "rehearsal") {
    MODE = "rehearsal";
    if (DURATION < POS) DURATION = POS;
    LAST_VT = sys("time");
    STATE = "playing";
    publish(true);
    return;
  }
  if (t == "sys_restored") { LAST_VT = sys("time"); NEED = true; SENT_FX = false; return; }
}
// 进度操作结束排演：当前过程转为可回放的记录
function end_rehearsal() {
  MODE = "record";
  sys("send", FLIGHT, { type: "end_rehearsal" });
  sys("send", UI, { type: "note", text: "排演已转为记录回放；可以保存，或从任意位置重新开始排演" });
  if (POS > DURATION) DURATION = POS;
}
function main(args) {
  UI = args.ui;
  WID = args.wid;
  SYSTEM = args.system;
  LAST_VT = sys("time");
  meta();
  for (;;) {
    let m = sys("recv", 1 / 60);
    if (m != null) {
      on_msg(m);
      let k = 0;
      while (k < 8) {
        let m2 = sys("recv", 0);
        if (m2 == null) break;
        on_msg(m2);
        k = k + 1;
      }
    }
    step_time();
    if (NEED) request_frame();
    // 协作进程被挂起时不再等它
    if (WAIT_F && !proc_ok(FLIGHT)) { WAIT_F = false; after_flight(LAST_F); }
    if (WAIT_X && !proc_ok(FX)) { WAIT_X = false; commit(); }
    if (STATE == "playing") publish(false);
  }
}
