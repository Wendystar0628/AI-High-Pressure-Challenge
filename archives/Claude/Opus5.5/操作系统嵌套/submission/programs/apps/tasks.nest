// 进程管理器：操作本系统自己的进程表，显示预算、内存、存储，设置配额。
include "/System/lib/ui.nest";

let ROWS = [];
let CHILDREN = [];
let ST = null;
let SEL_PID = 0;
let SCROLL = 0;
let QUOTA_TEXT = "";
let BUDGET_TEXT = null;
let MEM_TEXT = null;
let STORAGE_TEXT = null;
let GRANT_TEXT = {};
let STATUS = "";
let STATUS_ERR = false;
const ROW_H = 30;
const STATE_CN = { ready: "就绪", running: "运行", waiting: "等待", suspended: "挂起", exited: "结束", fault: "异常" };

function refresh() {
  ST = sys("stats");
  ROWS = sys("proc_list");
  CHILDREN = sys("sysctl", "list");
  ui_invalidate();
}
function state_cn(r) {
  let s = STATE_CN[r.state];
  if (s == null) s = r.state;
  if (r.state == "waiting" && r.wait != null) s = s + "·" + r.wait;
  return s;
}
function render(v) {
  let W = v.w, H = v.h;
  let out = [];
  let s = ST;
  let y = 8;
  if (s != null) {
    let kids = [
      T("a", 12, 4, W - 24, 22, "stat-line", "系统 " + s.id + " · 第 " + str(s.depth) + " 层 · 虚拟时间 " + fmt(s.vtime, 2) + " s · 就绪队列 " + str(s.runq)),
      T("b", 12, 26, W - 24, 22, "stat-line", "每步预算 " + fmt_units(s.budget) + " · 实际使用 " + fmt_units(s.used_avg) + " · 内核自身 " + fmt_units(s.own_avg) + " · 用户与后代 " + fmt_units(s.used_avg - s.own_avg)),
      T("c", 12, 48, W - 24, 22, "stat-line", "内存 " + fmt_bytes(s.mem_used) + " / " + fmt_bytes(s.mem_limit) + " · 存储 " + fmt_bytes(s.storage_used) + " / " + fmt_bytes(s.storage_limit))
    ];
    push(out, N("stats", 8, y, W - 16, 74, "stat-card", kids));
    y = y + 80;
    let bw = floor((W - 40) / 3);
    let lab = 62;
    push(out, T("lb", 10, y, lab, 26, "field-label", "总预算"));
    push(out, INPUT("budget", 10 + lab, y, bw - lab - 2, 26, BUDGET_TEXT != null ? BUDGET_TEXT : str(s.budget), { tid: "tasks-budget", label: "本系统总预算" }));
    push(out, T("lm", 14 + bw, y, lab, 26, "field-label", "内存 MB"));
    push(out, INPUT("mem", 14 + bw + lab, y, bw - lab - 2, 26, MEM_TEXT != null ? MEM_TEXT : str(floor(s.mem_limit / 1048576)), { tid: "tasks-memory", label: "本系统内存配额（MB）" }));
    push(out, T("ls", 18 + bw * 2, y, lab, 26, "field-label", "存储 MB"));
    push(out, INPUT("storage", 18 + bw * 2 + lab, y, bw - lab - 2, 26, STORAGE_TEXT != null ? STORAGE_TEXT : str(floor(s.storage_limit / 1048576)), { tid: "tasks-storage", label: "本系统存储配额（MB）" }));
    y = y + 30;
    push(out, B("apply", 10, y, 90, 26, "应用配置", "apply", null, { tid: "tasks-apply", cls: "small primary" }));
    y = y + 32;
  }
  // 直属子系统拨付
  for (let c of CHILDREN) {
    let t = GRANT_TEXT[c.id];
    push(out, T("cn" + c.id, 10, y, 240, 26, "field-label left", c.id + " 拨付上限（内核 " + fmt_units(c.own) + "，内部 " + fmt_units(c.used - c.own) + "）"));
    push(out, INPUT("grant:" + c.id, 252, y, 100, 26, t != null ? t : str(c.grant), { tid: "tasks-grant", label: c.id + " 拨付上限", a: { "data-target-system-id": c.id } }));
    push(out, B("cg" + c.id, 356, y, 54, 26, "应用", "grant", c.id, { cls: "small" }));
    y = y + 30;
  }
  // 操作条
  let ops = [["挂起", "suspend", "tasks-suspend"], ["继续", "resume", "tasks-resume"], ["结束", "kill", "tasks-kill"]];
  let x = 10;
  for (let o of ops) {
    push(out, B("op" + o[1], x, y, 56, 26, o[0], o[1], null, { tid: o[2], cls: "small", dis: SEL_PID == 0 }));
    x = x + 60;
  }
  push(out, T("ql", x + 6, y, 56, 26, "field-label", "额度"));
  push(out, INPUT("quota", x + 62, y, 90, 26, QUOTA_TEXT, { tid: "tasks-quota", label: "进程每步额度（0 不限）", ph: "0 不限" }));
  push(out, B("setq", x + 156, y, 54, 26, "设置", "setq", null, { cls: "small", dis: SEL_PID == 0 }));
  y = y + 32;
  // 进程表
  let cols = [["PID", 40], ["名称", 0], ["状态", 88], ["本步", 62], ["累计", 66], ["内存", 70], ["剩余", 56], ["消息", 44]];
  let namew = W - 16 - 40 - 88 - 62 - 66 - 70 - 56 - 44 - 16;
  if (namew < 70) namew = 70;
  let hd = [];
  let cx = 6;
  let i = 0;
  for (let c of cols) {
    let cw = c[1] == 0 ? namew : c[1];
    push(hd, T("h" + str(i), cx, 0, cw, 24, "list-head", c[0]));
    cx = cx + cw;
    i = i + 1;
  }
  push(out, N("head", 8, y, W - 16, 24, "table-head", hd));
  y = y + 24;
  let list_h = H - y - 28;
  let rows = [];
  let vis = floor(list_h / ROW_H);
  let maxs = len(ROWS) - vis;
  if (maxs < 0) maxs = 0;
  if (SCROLL > maxs) SCROLL = maxs;
  let ri = SCROLL, ry = 0;
  while (ri < len(ROWS) && ry + ROW_H <= list_h) {
    let r = ROWS[ri];
    let vals = [str(r.pid), r.name, state_cn(r), fmt_units(r.avg), fmt_units(r.used), fmt_bytes(r.mem), fmt_units(r.remaining), str(r.mq)];
    let kids = [];
    let cx2 = 6, j = 0;
    for (let c of cols) {
      let cw = c[1] == 0 ? namew : c[1];
      push(kids, T("c" + str(j), cx2, 0, cw, ROW_H - 2, "cell", vals[j]));
      cx2 = cx2 + cw;
      j = j + 1;
    }
    let cls = "proc-row" + (SEL_PID == r.pid ? " selected" : "") + " st-" + r.state + (r.kind == "host" ? " host" : "");
    push(rows, { k: "p" + str(r.pid), x: 0, y: ry, w: W - 16, h: ROW_H - 2, cls: cls, c: kids, label: r.name });
    hit(8, y + ry, W - 16, ROW_H - 2, "row", r.pid);
    ri = ri + 1;
    ry = ry + ROW_H;
  }
  push(out, N("rows", 8, y, W - 16, list_h, "proc-list", rows));
  let msg = STATUS;
  if (msg == "" && SEL_PID != 0) {
    for (let r of ROWS) {
      if (r.pid == SEL_PID) {
        msg = r.path + (r.error != null ? " · 错误：" + str(r.error) : "") + (r.where != "" ? " @ " + r.where : "");
      }
    }
  }
  push(out, T("st", 10, H - 25, W - 20, 22, STATUS_ERR ? "status err" : "status", msg != "" ? msg : "计量单位：一条指令 = 1；复制、拼接、解析等按规模折算（16 字节 = 1）"));
  return out;
}
function set_status(t, e) { STATUS = t; STATUS_ERR = e == true; ui_invalidate(); }
function on_act(v, act, data, ev) {
  STATUS = "";
  ui_invalidate();
  if (act == "row") { SEL_PID = data; for (let r of ROWS) if (r.pid == data) QUOTA_TEXT = str(r.quota); return; }
  if (act == "suspend" || act == "resume" || act == "kill") {
    let r = sys(act, SEL_PID);
    if (is_err(r)) set_status(r.error, true);
    refresh();
    return;
  }
  if (act == "setq") {
    let q = num(QUOTA_TEXT);
    if (q == null) { set_status("额度应为数字", true); return; }
    let r = sys("set_quota", SEL_PID, q);
    if (is_err(r)) set_status(r.error, true);
    refresh();
    return;
  }
  if (act == "apply") {
    let cf = {};
    if (BUDGET_TEXT != null) cf.budget = num(BUDGET_TEXT);
    if (MEM_TEXT != null) cf.mem = num(MEM_TEXT) * 1048576;
    if (STORAGE_TEXT != null) cf.storage = num(STORAGE_TEXT) * 1048576;
    sys("set_config", cf);
    BUDGET_TEXT = null; MEM_TEXT = null; STORAGE_TEXT = null;
    set_status("配置已应用", false);
    refresh();
    return;
  }
  if (act == "grant") {
    let t = GRANT_TEXT[data];
    if (t == null) return;
    let n = num(t);
    if (n == null) { set_status("拨付上限应为数字", true); return; }
    sys("sysctl", "grant", data, n);
    del(GRANT_TEXT, data);
    refresh();
    return;
  }
}
function on_value(v, key, value) {
  if (key == "budget") BUDGET_TEXT = value;
  else if (key == "mem") MEM_TEXT = value;
  else if (key == "storage") STORAGE_TEXT = value;
  else if (key == "quota") QUOTA_TEXT = value;
  else if (starts_with(key, "grant:")) GRANT_TEXT[substr(key, 6)] = value;
}
function on_key(v, ev) {
  if (ev.k != "keydown" || ev.key != "Enter") return;
  on_act(v, "apply", null, ev);
}
function on_wheel(v, r, ev) {
  SCROLL = SCROLL + (ev.dy > 0 ? 2 : -2);
  if (SCROLL < 0) SCROLL = 0;
  ui_invalidate();
}
function main(args) {
  app_window("进程管理器", "tasks", 780, 560, "tasks");
  refresh();
  app_run({ render: render, act: on_act, value: on_value, key: on_key, wheel: on_wheel, tick: refresh }, 1);
}
