// 子系统管理：创建、启动、暂停、单步、调速、重启、关闭、快照、恢复、分叉直属子系统。
include "/System/lib/ui.nest";

let LIST = [];
let SNAPS = [];
let SEL = null;
let STATUS = "";
let STATUS_ERR = false;
let ME = null;
let SNAP_SEL = null;
const RATES = [0.25, 0.5, 1, 2, 4, 8];
const STATE_CN = { running: "运行中", paused: "已暂停", booting: "启动中", stopped: "已停止", error: "内核错误" };

function refresh() {
  LIST = sys("sysctl", "list");
  SNAPS = sys("sysctl", "snapshots");
  if (SEL == null && len(LIST) > 0) SEL = LIST[0].id;
  ui_invalidate();
}
function report(r, ok) {
  if (is_err(r)) { STATUS = str(r.error); STATUS_ERR = true; }
  else { STATUS = ok; STATUS_ERR = false; }
  refresh();
}
function selected_info() {
  for (let c of LIST) if (c.id == SEL) return c;
  return null;
}
function render(v) {
  let W = v.w, H = v.h;
  let out = [];
  push(out, T("h", 12, 8, W - 150, 26, "panel-title", "本系统 " + ME.system + " 的直属子系统"));
  push(out, B("new", W - 124, 8, 112, 28, "＋ 新建子系统", "new", null, { cls: "primary small", tid: "systems-new" }));
  let y = 42;
  let rows = [];
  let ry = 0;
  for (let c of LIST) {
    let txt = c.id + "  ·  " + (STATE_CN[c.state] != null ? STATE_CN[c.state] : c.state) + "  ·  速率 " + str(c.rate) + "×  ·  实际 " + fmt_units(c.avg) + "/步";
    push(rows, { k: "c" + c.id, x: 0, y: ry, w: W - 24, h: 32, cls: "proc-row" + (SEL == c.id ? " selected" : ""), text: txt, label: c.id, a: { "data-target-system-id": c.id } });
    hit(12, y + ry, W - 24, 32, "sel", c.id);
    ry = ry + 34;
  }
  if (len(LIST) == 0) push(rows, T("e", 0, 6, W - 24, 28, "panel-empty center", "还没有子系统"));
  let list_h = ry < 40 ? 40 : ry;
  push(out, N("list", 12, y, W - 24, list_h, "proc-list", rows));
  y = y + list_h + 6;
  let c = selected_info();
  if (c != null) {
    let id = c.id;
    let attr = { "data-target-system-id": id };
    let x = 12;
    let btns = [];
    if (c.state == "running") push(btns, ["暂停", "pause", "system-pause"]);
    if (c.state == "paused") { push(btns, ["继续", "resume", "system-resume"]); push(btns, ["单步", "step", "system-step"]); }
    if (c.state == "stopped") push(btns, ["启动", "start", "system-start"]);
    if (c.state != "stopped") push(btns, ["停止", "stop", "system-stop"]);
    push(btns, ["重启", "restart", "system-restart"]);
    push(btns, ["关闭", "close", "system-close"]);
    push(btns, ["内核", "kernel", "kernel-open"]);
    push(btns, ["快照", "snapshot", "system-snapshot"]);
    for (let b of btns) {
      push(out, B("b" + b[1], x, y, 54, 28, b[0], b[1], id, { cls: "small", tid: b[2], a: attr }));
      x = x + 58;
      if (x + 54 > W) { x = 12; y = y + 32; }
    }
    y = y + 34;
    push(out, T("rl", 12, y, 60, 28, "field-label left", "时间速率"));
    let rx = 74;
    for (let r of RATES) {
      push(out, B("r" + str(r), rx, y, 46, 28, str(r) + "×", "rate", r, { cls: "small", on: c.rate == r, tid: "system-rate-" + str(r), a: attr }));
      rx = rx + 49;
    }
    y = y + 32;
    if (c.err != null) {
      push(out, T("err", 12, y, W - 24, 44, "err-text", str(c.err)));
      y = y + 48;
    }
    push(out, T("info", 12, y, W - 24, 22, "stat-line", "内核源：" + c.kernel + " · 拨付上限 " + fmt_units(c.grant) + " · 累计 " + fmt_units(c.used) + "（内核自身 " + fmt_units(c.own) + "）"));
    y = y + 28;
  }
  push(out, T("sh", 12, y, W - 24, 24, "panel-title small", "快照（/Snapshots）"));
  y = y + 26;
  let sn = [];
  let sy = 0;
  let room = H - y - 70;
  for (let s of SNAPS) {
    if (sy + 30 > room) break;
    push(sn, { k: "s" + s.name, x: 0, y: sy, w: W - 24, h: 28, cls: "proc-row" + (SNAP_SEL == s.path ? " selected" : ""), text: s.name + "  ·  " + fmt_bytes(s.size), label: s.name });
    hit(12, y + sy, W - 24, 28, "snap", s.path);
    sy = sy + 30;
  }
  if (len(SNAPS) == 0) push(sn, T("e", 0, 2, W - 24, 24, "panel-empty center", "没有快照"));
  push(out, N("snaps", 12, y, W - 24, room > 30 ? room : 30, "proc-list", sn));
  let by = H - 62;
  push(out, B("restore", 12, by, 100, 28, "恢复到选中实例", "restore", null, { cls: "small", tid: "system-restore", dis: SNAP_SEL == null || c == null }));
  push(out, B("fork", 116, by, 90, 28, "分叉新子树", "fork", null, { cls: "small", tid: "system-fork", dis: SNAP_SEL == null }));
  push(out, B("exp", 210, by, 80, 28, "保存到本机", "export", null, { cls: "small", tid: "system-snapshot-export", dis: SNAP_SEL == null }));
  push(out, B("imp", 294, by, 80, 28, "从本机导入", "import", null, { cls: "small", tid: "system-snapshot-import" }));
  push(out, T("st", 12, H - 28, W - 24, 24, STATUS_ERR ? "status err" : "status", STATUS != "" ? STATUS : "单步：让暂停的子系统执行 1/60 秒逻辑时间；快照写入本系统 /Snapshots"));
  return out;
}
function on_act(v, act, data, ev) {
  ui_invalidate();
  if (act == "sel") { SEL = data; return; }
  if (act == "snap") { SNAP_SEL = data; return; }
  if (act == "new") { let r = sys("sysctl", "new", {}); report(r, "已创建 " + str(r)); if (!is_err(r)) SEL = r; return; }
  if (act == "rate") { report(sys("sysctl", "rate", SEL, data), "速率已改为 " + str(data) + "×"); return; }
  if (act == "kernel") {
    let p = sys("sysctl", "kernel_path", data);
    if (!is_err(p)) spawn("/System/apps/editor.nest", { file: p }, { kind: "app" });
    return;
  }
  if (act == "snapshot") { report(sys("sysctl", "snapshot", data), "快照已保存"); return; }
  if (act == "restore") { report(sys("sysctl", "restore", SEL, SNAP_SEL), "已恢复"); return; }
  if (act == "fork") { report(sys("sysctl", "fork", SNAP_SEL), "已分叉"); return; }
  if (act == "export") {
    let t = read_file(SNAP_SEL);
    if (t != null) report(sys("host_export", base_of(SNAP_SEL), t), "已保存到本机");
    return;
  }
  if (act == "import") { sys("host_import", "snapshot"); return; }
  if (act == "pause" || act == "resume" || act == "step" || act == "stop" || act == "start" || act == "restart" || act == "close") {
    report(sys("sysctl", act, data), "已执行");
    if (act == "close") SEL = null;
    return;
  }
}
function on_msg(m) {
  let d = m.data;
  if (d.type == "host_file") {
    if (d.error != null) { STATUS = d.error; STATUS_ERR = true; ui_invalidate(); return; }
    let r = sys("fs_write", "/Snapshots/" + d.name, d.text);
    report(r, "已导入快照 " + d.name);
  }
}
function main(args) {
  ME = self();
  app_window("子系统管理", "systems", 560, 560, "systems");
  refresh();
  if (args != null && args.target != null) SEL = args.target;
  app_run({ render: render, act: on_act, tick: refresh, msg: on_msg }, 1);
}
