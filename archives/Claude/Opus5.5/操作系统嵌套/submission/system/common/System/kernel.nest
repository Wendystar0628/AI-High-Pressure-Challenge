;; =====================================================================
;; Nest 子系统内核（内核程序模板）
;;
;; 每个子系统由一份内核程序运行。父系统创建子系统时，把本文件复制为
;; 父系统里的 /System/Kernels/<实例标识>.nest，由父系统中的“承载进程”执行。
;; 修改那份副本并在父系统里“重启”该子系统即可生效，其他子系统不受影响。
;;
;; 本内核负责：进程表、调度（第 5 节）、等待与唤醒、消息投递（第 6 节）、
;; 文件系统（第 3 节）、系统调用分发（第 8 节）、窗口与显示转发（第 9 节）、
;; 直属子系统的承载与控制（第 10 节）、跨层信封路由（第 11 节）与快照（第 12 节）。
;; 子系统内的程序（窗口管理、文件管理器、播放器……）都由本内核载入和调度。
;;
;; 内核向父系统请求服务时使用 k- 开头的系统调用（见操作说明“父系统接口”）。
;; =====================================================================
(include "/System/lib/core.nest")

;; ---------------- 1. 常量 ----------------
(def KERNEL-VERSION "nest-kernel 1.0")
(def STEP-DT (/ 1 60))        ; 单步的逻辑时间（父系统时间 1/60 秒）
(def QUANTUM 4000)            ; 调度时间片（计量单位）
(def KERNEL-RESERVE 300)      ; 每步给内核自身保留的单位
(def BLOCK {:block true})     ; 系统调用处理器返回它表示“进程进入等待”
(def CHILD-DEFAULT-NAME "子系统")

;; ---------------- 2. 全局状态 ----------------
(var BOOT nil) (var SYSID "") (var MYPATH []) (var DEPTH 1) (var NAME "")
(var CLOCK 0) (var STEPNO 0) (var CONF {}) (var RATE 1)
(var PROCS {}) (var PORDER []) (var NEXT-PID 1) (var RR 0)
(var FILES {}) (var STORE-USED 0)
(var WINS {}) (var NEXT-WIN 1) (var WM-PID nil)
(var CHILDREN {}) (var CHILD-ORDER [])
(var BUS {}) (var ENDPOINTS {}) (var DEVMEM {})
(var BIN-INDEX {}) (var COMPILER-HASH "")
(var STEP-INFO {:budget 0 :grant 0 :used 0 :kernel 0 :procs 0})
(var DESK-SIZE [1000 640])
(var SNAP-SEQ 0)
(var PENDING-REPLIES {})
(var LAST-TREE-REPORT "")
(var MEM-CHECK-AT 0)

;; ---------------- 3. 文件系统 ----------------
;; 文件保存在内核内存的 FILES 表里，并逐项写透到父系统提供的磁盘
;; （父系统文件系统中的 /System/Disks/<本实例>/ 目录）。
(defn fs-norm (p)
  (when (not (str? p)) (throw "路径必须是字符串"))
  (when (not (starts-with? p "/")) (set! p (str "/" p)))
  (while (and (> (len p) 1) (ends-with? p "/")) (set! p (substr p 0 (- (len p) 1))))
  p)
(defn fs-entry (p) (get FILES p))
(defn fs-isdir (p) (var e (get FILES p)) (and e (= e.type "dir")))
(defn fs-exists (p) (not (nil? (get FILES p))))

(defn fs-mkdir (p)
  (set! p (fs-norm p))
  (cond ((= p "/") true)
        ((fs-isdir p) true)
        ((fs-exists p) (throw (str "已存在同名文件: " p)))
        (else
         (fs-mkdir (dirname p))
         (put! FILES p {:type "dir" :mtime CLOCK :size 0})
         (sys "k-disk-mkdir" p)
         true)))

(defn fs-write (p data)
  (set! p (fs-norm p))
  (when (not (str? data)) (set! data (to-str data)))
  (when (fs-isdir p) (throw (str "是目录: " p)))
  (var old (get FILES p))
  (var delta (- (len data) (if old old.size 0)))
  (when (> (+ STORE-USED delta) CONF.storage)
    (throw (str "存储配额不足：需要 " (fmt-bytes (+ STORE-USED delta)) "，配额 " (fmt-bytes CONF.storage))))
  (fs-mkdir (dirname p))
  (set! data (copy data))
  (sys "k-disk-write" p data)
  (put! FILES p {:type "file" :data data :mtime CLOCK :size (len data)})
  (inc! STORE-USED delta)
  true)

(defn fs-read (p)
  (set! p (fs-norm p))
  (var e (get FILES p))
  (cond ((nil? e) nil)
        ((= e.type "dir") (throw (str "是目录: " p)))
        (else e.data)))

(defn fs-list (dir)
  (set! dir (fs-norm dir))
  (when (not (fs-isdir dir)) (throw (str "目录不存在: " dir)))
  (var out [])
  (var prefix (if (= dir "/") "/" (str dir "/")))
  (each-kv (p e FILES)
    (when (and (starts-with? p prefix) (!= p dir) (< (index-of p "/" (len prefix)) 0))
      (push! out {:name (basename p) :path p :type e.type :size e.size :mtime e.mtime})))
  out)

(defn fs-delete (p)
  (set! p (fs-norm p))
  (when (= p "/") (throw "不能删除根目录"))
  (when (not (fs-exists p)) (throw (str "不存在: " p)))
  (var victims [])
  (each-kv (q e FILES) (when (under? q p) (push! victims q)))
  (each (q victims)
    (var e (get FILES q))
    (when (= e.type "file") (dec! STORE-USED e.size))
    (del! FILES q))
  (sys "k-disk-delete" p)
  true)

(defn fs-rename (from to)
  (set! from (fs-norm from)) (set! to (fs-norm to))
  (when (not (fs-exists from)) (throw (str "不存在: " from)))
  (when (fs-exists to) (throw (str "目标已存在: " to)))
  (when (under? to from) (throw "不能移动到自身内部"))
  (fs-mkdir (dirname to))
  (var moves [])
  (each-kv (q e FILES) (when (under? q from) (push! moves q)))
  (each (q moves)
    (var e (get FILES q))
    (del! FILES q)
    (put! FILES (str to (substr q (len from))) e))
  (sys "k-disk-rename" from to)
  true)

(defn fs-copy (from to)
  (set! from (fs-norm from)) (set! to (fs-norm to))
  (when (not (fs-exists from)) (throw (str "不存在: " from)))
  (if (fs-isdir from)
    (do (fs-mkdir to)
        (each (e (fs-list from)) (fs-copy e.path (path-join to e.name))))
    (fs-write to (copy (fs-read from))))
  true)

(defn mount-fs ()
  (var dump (sys "k-disk-dump"))
  (set! FILES {"/" {:type "dir" :mtime 0 :size 0}})
  (set! STORE-USED 0)
  (if (= (len dump) 0)
    (install-image)
    (each (e dump)
      (if (= (nth e 1) "dir")
        (put! FILES (nth e 0) {:type "dir" :mtime (nth e 3) :size 0})
        (do (put! FILES (nth e 0) {:type "file" :data (nth e 2) :mtime (nth e 3) :size (len (nth e 2))})
            (inc! STORE-USED (len (nth e 2))))))))

(defn install-image ()
  ;; 首次启动：从父系统取得预置文件（程序、场景资源、编译结果……）
  (var img (sys "k-image"))
  (each-kv (p data img)
    (if (ends-with? p "/")
      (fs-mkdir p)
      (fs-write p data)))
  (each (d ["/Documents" "/Downloads" "/Recycle" "/Snapshots" "/Desktop" "/System/Kernels" "/Records"])
    (fs-mkdir d)))

;; ---------------- 4. 进程与程序载入 ----------------
(defn new-pid () (var p NEXT-PID) (inc! NEXT-PID) p)

(defn make-proc (name path kind parent)
  (var pid (new-pid))
  (var p {:pid pid :name name :path path :kind kind :ctx nil :state "loading" :wait nil
          :queue [] :parent parent :quota (get-or CONF "proc-quota" 20000) :used 0 :last 0
          :units 0 :own 0 :inner 0 :mem 0 :out [] :error nil :started CLOCK :progress nil
          :demand false :wins [] :child nil :prio 1 :on-done nil :result nil})
  (put! PROCS (str pid) p)
  (push! PORDER pid)
  p)

(defn proc-of (pid) (get PROCS (str pid)))

(defn plog (p text)
  (push! p.out (str "[" (fmt CLOCK 2) "] " text))
  (when (> (len p.out) 60) (shift! p.out)))

(defn load-bin-index ()
  (var s (fs-read "/System/bin/index.json"))
  (set! BIN-INDEX (if s (try (parse-json s) (catch e {})) {}))
  (var c (fs-read "/System/bin/compiler.nx"))
  (set! COMPILER-HASH (if c (hash c) "")))

(defn deps-fresh? (deps)
  (all? (fn (d) (var s (fs-read (nth d 0))) (and s (= (hash s) (nth d 1)))) deps))

;; 查找已编译的可执行文件；源文件、依赖或编译器变化时返回 nil
(defn cached-exe (path src)
  ;; 按内容查找：同一份源码（例如各子系统的内核副本）共用编译结果
  (var h (hash src))
  (var rec (get BIN-INDEX path))
  (when (or (nil? rec) (!= rec.src h))
    (set! rec nil)
    (each-kv (k r BIN-INDEX) (when (and (nil? rec) (= r.src h) (= r.compiler COMPILER-HASH)) (set! rec r))))
  (if (and rec (= rec.src h) (= rec.compiler COMPILER-HASH) (deps-fresh? rec.deps))
    (fs-read rec.exe)
    nil))

(defn store-exe (path src exe-text deps)
  (var out (str "/System/bin/" (replace (substr path 1) "/" "_") ".nx"))
  (fs-write out exe-text)
  (put! BIN-INDEX path {:src (hash src) :compiler COMPILER-HASH :deps deps :exe out})
  (fs-write "/System/bin/index.json" (to-json BIN-INDEX)))

;; 用系统内的编译器程序编译源文件；完成后调用 k（参数：可执行文本 或 {error}）
(defn compile-async (path src k)
  (var cexe (fs-read "/System/bin/compiler.nx"))
  (if (nil? cexe)
    (k {:error "找不到编译器 /System/bin/compiler.nx"})
    (do (var cp (make-proc (str "编译 " (basename path)) "/System/compiler.nest" "service" nil))
        (put! cp "ctx" (ctx-new cexe {:args {:src src :name (stem-of path) :path path} :mem 64000000}))
        (put! cp "state" "ready")
        (put! cp "on-done" (fn (res)
          (if (and (dict? res) (nil? res.error) (= res.format "nest-exe"))
            (do (var txt (to-json res))
                (store-exe path src txt res.deps)
                (k txt))
            (k (if (dict? res) res {:error (to-str res)})))))
        cp)))

(defn spawn-proc (path args kind parent)
  (set! path (fs-norm path))
  (var src (fs-read path))
  (when (nil? src) (throw (str "程序不存在: " path)))
  (var p (make-proc (stem-of path) path kind parent))
  (var start (fn (exe-text)
    (if (and (dict? exe-text) exe-text.error)
      (do (put! p "state" "error")
          (put! p "error" (str "编译错误：" exe-text.error " (第 " exe-text.line " 行)"))
          (plog p p.error))
      (do (put! p "ctx" (ctx-new exe-text {:args args :mem (proc-mem-limit p) :seed (+ 7 (* 31 p.pid))}))
          (when (= p.state "loading") (put! p "state" "ready"))))))
  (var hit (cached-exe path src))
  (if hit (start hit) (compile-async path src start))
  p)

(defn proc-mem-limit (p) (get-or CONF "proc-mem" (floor (/ CONF.mem 4))))

(defn kill-proc (p why)
  (when (and p (not (or (= p.state "done") (= p.state "error"))))
    (put! p "state" (if (= why "error") "error" "done"))
    (put! p "ended" CLOCK)
    (when p.ctx (ctx-kill p.ctx))
    (put! p "wait" nil)
    (put! p "queue" [])
    ;; 关闭它的窗口，结束协作进程（由它启动的进程）
    (each (wid (slice p.wins 0)) (close-window wid))
    (each-kv (k q PROCS) (when (= q.parent p.pid) (kill-proc q "parent")))
    (each-kv (k pid ENDPOINTS) (when (= pid p.pid) (del! ENDPOINTS k)))
    (del! DEVMEM (str p.pid))
    (when p.child (child-stopped p.child "进程已结束"))
    (when (and p.on-done (= why "parent")) nil)))

(defn reap ()
  ;; 清理已结束很久的进程记录（保留最近的以便查看错误）
  (var keep [])
  (each (pid PORDER)
    (var p (proc-of pid))
    (if (and p (or (= p.state "done") (= p.state "error")) (> (- CLOCK p.ended) 30) (not p.child))
      (del! PROCS (str pid))
      (push! keep pid)))
  (set! PORDER keep))

;; ---------------- 5. 调度 ----------------
;; 调度策略：按时间片轮转。每步的预算 B 来自父系统拨付与本系统配置的较小值；
;; 每个进程本步最多使用自己的额度（quota）。修改 pick-next / quantum-for 即可改变策略。
(defn runnable? (p)
  (and (= p.state "ready") p.ctx (< p.used p.quota) (child-runnable? p)))

(defn pick-next ()
  (var n (len PORDER)) (var found nil) (var i 0)
  (while (and (< i n) (nil? found))
    (var pid (nth PORDER (% (+ RR i) n)))
    (var p (proc-of pid))
    (when (and p (runnable? p)) (set! found p) (set! RR (% (+ RR i 1) n)))
    (inc! i))
  found)

(defn quantum-for (p left)
  (min QUANTUM (- p.quota p.used) left))

(defn run-step (budget)
  (var u0 (units-now))
  (var spent-procs 0)
  (var going true)
  (while going
    (var left (- budget (- (units-now) u0) KERNEL-RESERVE))
    (var p (if (> left 50) (pick-next) nil))
    (if (nil? p)
      (set! going false)
      (do (var r (exec p.ctx (quantum-for p left)))
          (var used (nth r 1))
          (put! p "used" (+ p.used used))
          (inc! spent-procs used)
          (handle-exec p r))))
  ;; 本步结束：记录读数，标记未得到执行的进程
  (each (pid PORDER)
    (var p (proc-of pid))
    (when p (put! p "demand" (and (= p.state "ready") p.ctx (child-runnable? p)))))
  (var total (- (units-now) u0))
  (set! STEP-INFO {:budget budget :grant budget :used total :procs spent-procs :kernel (- total spent-procs)}))

(defn handle-exec (p r)
  (case (first r)
    ("quantum" nil)
    ("sys" (dispatch p (nth r 2)))
    ("done" (put! p "result" (nth r 2)) (put! p "ended" CLOCK) (finish-proc p (nth r 2)))
    ("error" (put! p "error" (nth r 2)) (put! p "ended" CLOCK) (plog p (str "错误: " (nth r 2)))
             (if p.child (child-crashed p (nth r 2)) (do (kill-proc p "error") (notify-error p))))
    (else nil)))

(defn finish-proc (p val)
  (var k p.on-done)
  (kill-proc p "done")
  (when k (k val)))

(defn notify-error (p)
  (when WM-PID (deliver-kernel WM-PID {:k "notify" :title (str "程序异常：" p.name) :body p.error :level "error"})))

;; ---------------- 6. 消息 ----------------
;; 投递规则：消息复制后放进接收进程的队列尾；接收进程在 recv 上等待时立即唤醒。
(defn deliver (from to msg)
  (var q (proc-of to))
  (if (or (nil? q) (= q.state "done") (= q.state "error") (nil? q.ctx))
    "no-such-process"
    (do (push! q.queue {:from from :msg (copy msg)})
        (wake-receiver q)
        "ok")))

(defn deliver-kernel (to msg)
  (var q (proc-of to))
  (when (and q (not (= q.state "done")) (not (= q.state "error")))
    (push! q.queue {:from 0 :msg msg})
    (wake-receiver q)))

(defn wake-receiver (q)
  (when (and (= q.state "waiting") q.wait (= q.wait.k "recv") (> (len q.queue) 0) q.ctx)
    (var m (shift! q.queue))
    (put! q "wait" nil)
    (put! q "state" "ready")
    (ctx-resume q.ctx m.msg)))

;; ---------------- 7. 时间 ----------------
(defn advance-clock (dt)
  (inc! CLOCK dt)
  (inc! STEPNO)
  (each (pid PORDER)
    (var p (proc-of pid))
    (when (and p (= p.state "waiting") p.wait)
      (case p.wait.k
        ("sleep" (when (<= p.wait.until CLOCK) (put! p "wait" nil) (put! p "state" "ready") (ctx-resume p.ctx CLOCK)))
        ("recv" (when (and p.wait.until (<= p.wait.until CLOCK)) (put! p "wait" nil) (put! p "state" "ready") (ctx-resume p.ctx nil)))
        (else nil)))
    (when p (put! p "last" p.used) (put! p "used" 0))))

;; ---------------- 8. 系统调用 ----------------
(def SYSCALLS {})
(defn defsys (name f) (put! SYSCALLS name f))

(defn dispatch (p trap)
  (var name (first trap))
  (var h (get SYSCALLS name))
  (if (nil? h)
    (ctx-throw p.ctx (str "未知的系统调用: " name))
    (do (var res (try (h p trap) (catch e {:sys-error e})))
        (cond ((and (dict? res) (has? res "sys-error")) (ctx-throw p.ctx res.sys-error))
              ((= res BLOCK) nil)
              (else (ctx-resume p.ctx res))))))

(defn arg (trap i) (nth trap i))

(defsys "now" (fn (p t) CLOCK))
(defsys "self" (fn (p t) p.pid))
(defsys "yield" (fn (p t) (put! p "used" p.quota) true))
(defsys "sleep" (fn (p t)
  (var s (arg t 1))
  (if (or (not (num? s)) (<= s 0))
    CLOCK
    (do (put! p "state" "waiting") (put! p "wait" {:k "sleep" :until (+ CLOCK s)}) BLOCK))))
(defsys "log" (fn (p t) (plog p (to-str (arg t 1))) true))
(defsys "progress" (fn (p t) (put! p "progress" [(arg t 1) (arg t 2)]) true))
(defsys "exit" (fn (p t) (put! p "result" (arg t 1)) (put! p "ended" CLOCK) (finish-proc p (arg t 1)) BLOCK))

(defsys "spawn" (fn (p t)
  (var q (spawn-proc (arg t 1) (arg t 2) (or (get (arg t 3) "kind") "user") (if (get (arg t 3) "detached") nil p.pid)))
  q.pid))
(defsys "kill" (fn (p t)
  (var q (proc-of (arg t 1)))
  (if (or (nil? q) q.child) false (do (put! q "ended" CLOCK) (kill-proc q "killed") true))))

(defsys "send" (fn (p t) (deliver p.pid (arg t 1) (arg t 2))))
(defsys "recv" (fn (p t)
  (if (> (len p.queue) 0)
    (get (shift! p.queue) "msg")
    (do (put! p "state" "waiting")
        (put! p "wait" {:k "recv" :until (if (num? (arg t 1)) (+ CLOCK (arg t 1)) nil)})
        BLOCK))))
(defsys "try-recv" (fn (p t) (if (> (len p.queue) 0) (get (shift! p.queue) "msg") nil)))
(defsys "recv-from" (fn (p t)
  (if (> (len p.queue) 0) (shift! p.queue) nil)))

(defsys "bus-write" (fn (p t) (put! BUS (arg t 1) {:v (copy (arg t 2)) :t CLOCK :pid p.pid}) true))
(defsys "bus-read" (fn (p t) (var e (get BUS (arg t 1))) (if e {:v (copy e.v) :t e.t} nil)))

(defsys "read" (fn (p t) (fs-read (arg t 1))))
(defsys "write" (fn (p t) (fs-write (arg t 1) (arg t 2))))
(defsys "list" (fn (p t) (fs-list (arg t 1))))
(defsys "stat" (fn (p t)
  (var e (fs-entry (fs-norm (arg t 1))))
  (if e {:path (fs-norm (arg t 1)) :type e.type :size e.size :mtime e.mtime} nil)))
(defsys "exists" (fn (p t) (fs-exists (fs-norm (arg t 1)))))
(defsys "mkdir" (fn (p t) (fs-mkdir (arg t 1))))
(defsys "delete" (fn (p t) (fs-delete (arg t 1))))
(defsys "rename" (fn (p t) (fs-rename (arg t 1) (arg t 2))))
(defsys "copy" (fn (p t) (fs-copy (arg t 1) (arg t 2))))
(defsys "storage" (fn (p t) {:used STORE-USED :quota CONF.storage}))

(defsys "compile" (fn (p t)
  ;; 编译（不运行）一个程序，结果写入编译缓存；等待编译完成
  (var path (fs-norm (arg t 1)))
  (var src (fs-read path))
  (if (nil? src)
    {:error (str "不存在: " path)}
    (do (put! p "state" "waiting") (put! p "wait" {:k "compile"})
        (compile-async path src (fn (res)
          (put! p "wait" nil) (put! p "state" "ready")
          (ctx-resume p.ctx (if (str? res) {:ok true :path path} res))))
        BLOCK))))

(defsys "install-compiler" (fn (p t)
  ;; 用当前编译器编译 /System/compiler.nest，成功后替换 /System/bin/compiler.nx
  (var src (fs-read "/System/compiler.nest"))
  (put! p "state" "waiting") (put! p "wait" {:k "compile"})
  (compile-async "/System/compiler.nest" src (fn (res)
    (put! p "wait" nil) (put! p "state" "ready")
    (if (str? res)
      (do (var old (fs-read "/System/bin/compiler.nx"))
          (when old (fs-write "/System/bin/compiler.prev.nx" old))
          (fs-write "/System/bin/compiler.nx" res)
          (set! COMPILER-HASH (hash res))
          (ctx-resume p.ctx {:ok true :hash COMPILER-HASH}))
      (ctx-resume p.ctx res))))
  BLOCK))

(defn proc-info (q)
  (var info (if q.ctx (ctx-info q.ctx) {}))
  {:pid q.pid :name q.name :path q.path :kind q.kind :state q.state
   :wait (if q.wait q.wait.k nil) :units (get-or info "units" 0) :own (get-or info "own" 0) :inner (get-or info "inner" 0)
   :last q.last :quota q.quota :demand q.demand :mem (+ (get-or info "mem" 0) (get-or DEVMEM (str q.pid) 0))
   :qlen (len q.queue) :error q.error :progress q.progress :pending (get-or info "pending" 0)
   :out (slice q.out (max 0 (- (len q.out) 8))) :child q.child :parent q.parent :where (get-or info "where" "")})

(defsys "ps" (fn (p t)
  (var out [])
  (each (pid PORDER) (var q (proc-of pid)) (when q (push! out (proc-info q))))
  out))

(defsys "proc" (fn (p t)
  (var q (proc-of (arg t 1)))
  (var action (arg t 2))
  (cond
    ((nil? q) (throw "没有这个进程"))
    ((= action "suspend")
     (when (not (or (= q.state "done") (= q.state "error") (= q.state "suspended")))
       (put! q "resume-state" q.state) (put! q "state" "suspended"))
     true)
    ((= action "resume")
     (when (= q.state "suspended")
       (put! q "state" (or q.resume-state "ready"))
       (wake-receiver q))
     true)
    ((= action "kill") (if q.child (child-control "stop" q.child nil) (do (put! q "ended" CLOCK) (kill-proc q "killed"))) true)
    ((= action "quota") (put! q "quota" (max 0 (floor (arg t 3)))) true)
    (else (throw (str "未知操作: " action))))))

(defn sysinfo ()
  {:id SYSID :name NAME :path MYPATH :depth DEPTH :time CLOCK :step STEPNO :conf CONF
   :step-info STEP-INFO :storage STORE-USED :kernel KERNEL-VERSION :mem (self-mem)
   :children (len CHILD-ORDER) :procs (len PORDER)})
(defsys "sysinfo" (fn (p t) (sysinfo)))
(defsys "sysconf" (fn (p t)
  (var key (arg t 1)) (var v (arg t 2))
  (when (not (num? v)) (throw "配置值必须是数字"))
  (case key
    (("budget" "mem" "storage" "child-cap" "proc-quota") (put! CONF key (max 0 (floor v))))
    (else (throw (str "未知配置项: " key))))
  (save-conf)
  CONF))
(defn save-conf () (fs-write "/System/config.json" (to-json CONF)))
(defsys "ancestors" (fn (p t) (copy MYPATH)))
(defsys "endpoint" (fn (p t) (put! ENDPOINTS (arg t 1) p.pid) true))
(defsys "endpoint-drop" (fn (p t) (del! ENDPOINTS (arg t 1)) true))

;; ---------------- 9. 窗口与显示 ----------------
;; 窗口的次序、焦点与命中由窗口管理程序（/System/wm.nest）决定；
;; 内核只分配窗口标识、检查归属并把显示内容转交给父系统的显示设备。
(defsys "win-open" (fn (p t)
  (var o (or (arg t 1) {}))
  (var wid (str SYSID ":w" NEXT-WIN))
  (inc! NEXT-WIN)
  (put! WINS wid {:wid wid :pid p.pid :app (or o.app "app") :title (or o.title p.name) :proj nil})
  (push! p.wins wid)
  (when WM-PID (deliver-kernel WM-PID {:k "win-new" :wid wid :pid p.pid :app (or o.app "app") :title (or o.title p.name)
                                       :w (or o.w 480) :h (or o.h 320) :icon (or o.icon o.app) :x o.x :y o.y :max o.max}))
  wid))
(defsys "win-title" (fn (p t)
  (var w (get WINS (arg t 1)))
  (when (and w (= w.pid p.pid))
    (put! w "title" (arg t 2))
    (when WM-PID (deliver-kernel WM-PID {:k "win-title" :wid w.wid :title (arg t 2)})))
  true))
(defsys "win-close" (fn (p t) (var w (get WINS (arg t 1))) (when (and w (= w.pid p.pid)) (close-window w.wid)) true))
(defsys "win-focus" (fn (p t) (when WM-PID (deliver-kernel WM-PID {:k "win-focus" :wid (arg t 1)})) true))
(defsys "windows" (fn (p t) (var out []) (each-kv (k w WINS) (push! out {:wid w.wid :pid w.pid :app w.app :title w.title})) out))

(defn close-window (wid)
  (var w (get WINS wid))
  (when w
    (del! WINS wid)
    (var p (proc-of w.pid))
    (when p (remove-item! p.wins wid))
    (when w.proj (route {:to w.proj.path :kind "proj-end" :data {:proj w.proj.pwid :reason "源窗口已关闭"}}))
    (sys "k-display" wid nil nil)
    (sys "k-display" (str wid "@proj") nil nil)
    (when WM-PID (deliver-kernel WM-PID {:k "win-closed" :wid wid}))))

(defn wins-own? (wins sid)
  (any? (fn (wid) (or (= sid wid) (starts-with? sid (str wid "@")) (starts-with? sid (str wid "#")))) wins))
(defn owns-surface? (p sid)
  ;; 窗口归属：窗口管理程序拥有桌面；应用拥有自己的窗口；应用启动的协作进程可提交到该应用窗口
  (var pp (if p.parent (proc-of p.parent) nil))
  (or (and (= p.pid WM-PID) (starts-with? sid (str SYSID ":")))
      (wins-own? p.wins sid)
      (and pp (wins-own? pp.wins sid))))

(defsys "display" (fn (p t)
  (var sid (arg t 1))
  (when (= sid "desktop") (set! sid (str SYSID ":desktop")))
  (when (not (owns-surface? p sid)) (throw (str "无权提交到显示面 " sid)))
  (sys "k-display" sid (copy (arg t 2)) (copy (arg t 3)))))

(defsys "display-res" (fn (p t) (sys "k-display-res" SYSID (arg t 1) (copy (arg t 2)))))

(defsys "scene" (fn (p t)
  (var op (arg t 1)) (var sid (arg t 2)) (var data (arg t 3))
  (when (not (owns-surface? p sid)) (throw (str "无权使用场景 " sid)))
  (when (= op "load")
    (var size (size-of data))
    (var used (get-or DEVMEM (str p.pid) 0))
    (when (> (+ size used (mem-used-total)) CONF.mem)
      (throw (str "显示内存不足：场景需要 " (fmt-bytes size) "，本系统内存配额 " (fmt-bytes CONF.mem))))
    (put! DEVMEM (str p.pid) (+ used size)))
  (when (= op "drop") (put! DEVMEM (str p.pid) 0))
  (sys "k-scene" op sid (copy data))))

(defsys "notify" (fn (p t)
  (when WM-PID (deliver-kernel WM-PID {:k "notify" :title (arg t 1) :body (arg t 2) :from p.name}))
  true))

(defsys "project" (fn (p t)
  ;; 把窗口投送到祖先桌面：目标系统的窗口管理创建投送外框
  (var w (get WINS (arg t 1))) (var target (arg t 2))
  (when (or (nil? w) (!= w.pid p.pid)) (throw "只能投送自己的窗口"))
  (var ti (index-of MYPATH target))
  (when (or (< ti 0) (= target SYSID)) (throw "只能投送到祖先桌面"))
  (if w.proj
    (do (route {:to w.proj.path :kind "proj-focus" :data {:proj w.proj.pwid}}) {:ok true :existing true :proj w.proj.pwid})
    (do (route {:to (slice MYPATH 0 (+ ti 1)) :kind "proj-open"
                :data {:src-sys SYSID :src-path MYPATH :src-win w.wid :src-app w.app :title w.title :w (or (arg t 3) 640) :h (or (arg t 4) 420)}})
        {:ok true :pending true}))))
(defsys "unproject" (fn (p t)
  (var w (get WINS (arg t 1)))
  (when (and w w.proj (= w.pid p.pid))
    (route {:to w.proj.path :kind "proj-end" :data {:proj w.proj.pwid :reason "源应用取消投送"}})
    (put! w "proj" nil))
  true))

;; ---------------- 10. 直属子系统 ----------------
(defn child-runnable? (p)
  (if (nil? p.child)
    true
    (do (var c (get CHILDREN p.child))
        (and c (or (= c.state "running") (= c.state "booting") (> c.stepping 0))))))

(defn new-child-record (id name)
  {:id id :name name :state "booting" :rate 1 :host nil :inbox [] :acc 0 :stepping 0
   :cap (get-or CONF "child-cap" (floor (* CONF.budget 0.8)))
   :budget (get-or CONF "child-cap" (floor (* CONF.budget 0.8)))
   :mem (floor (* CONF.mem 0.6)) :storage (floor (* CONF.storage 0.6))
   :error nil :kernel (str "/System/Kernels/" id ".nest") :subtree [] :last 0 :own 0 :inner 0
   :restarts 0 :size [900 560] :restored nil})

(defn save-children ()
  (var out [])
  (each (id CHILD-ORDER)
    (var c (get CHILDREN id))
    (when c (push! out {:id c.id :name c.name :rate c.rate :cap c.cap :budget c.budget :mem c.mem :storage c.storage})))
  (fs-write "/System/children.json" (to-json out)))

(defn start-child-kernel (c)
  ;; 编译并启动该子系统的内核程序（承载进程）
  (var src (fs-read c.kernel))
  (when (nil? src)
    (fs-copy "/System/kernel.nest" c.kernel)
    (set! src (fs-read c.kernel)))
  (put! c "state" "booting") (put! c "error" nil)
  (var hp (make-proc (str "承载 " c.id) c.kernel "host" nil))
  (put! hp "child" c.id)
  (put! hp "quota" c.cap)
  (put! c "host" hp.pid)
  (var go (fn (exe-text)
    (if (and (dict? exe-text) exe-text.error)
      (do (put! hp "state" "error")
          (put! hp "error" (str "内核编译错误：" exe-text.error "（第 " exe-text.line " 行）"))
          (child-crashed hp hp.error))
      (do (put! hp "ctx" (ctx-new exe-text {:mem c.mem :seed (+ 99 hp.pid)}))
          (put! hp "state" "ready")))))
  (var hit (cached-exe c.kernel src))
  (if hit (go hit) (compile-async c.kernel src go))
  hp)

(defn child-create (name)
  (var id (sys "k-idalloc"))
  (var c (new-child-record id (or name (str CHILD-DEFAULT-NAME " " id))))
  (fs-copy "/System/kernel.nest" c.kernel)
  (put! CHILDREN id c)
  (push! CHILD-ORDER id)
  (save-children)
  (start-child-kernel c)
  (when WM-PID (deliver-kernel WM-PID {:k "child-new" :id id :name c.name}))
  (report-tree)
  id)

(defn child-stopped (id why)
  (var c (get CHILDREN id))
  (when c
    (put! c "state" "stopped") (put! c "error" why)
    (sys "k-drop-subtree" id)
    (report-tree)))

(defn child-crashed (hp msg)
  (var c (get CHILDREN hp.child))
  (when (and hp.ctx (not (= (get (ctx-info hp.ctx) "state") "dead"))) (ctx-kill hp.ctx))
  (put! hp "state" "error") (put! hp "error" msg) (put! hp "ended" CLOCK)
  (when c
    (put! c "state" "kernel-error") (put! c "error" msg)
    (sys "k-drop-subtree" c.id)
    (when WM-PID (deliver-kernel WM-PID {:k "child-state" :id c.id :state "kernel-error" :error msg}))
    (report-tree)))

(defn host-of (c) (if c (proc-of c.host) nil))

(defn child-control (action id a)
  (var c (get CHILDREN id))
  (when (nil? c) (throw (str "没有直属子系统 " id)))
  (var hp (host-of c))
  (case action
    ("pause" (when (or (= c.state "running") (= c.state "booting")) (put! c "state" "paused")) true)
    ("resume" (when (= c.state "paused") (put! c "state" "running")) true)
    ("step"
     (when (!= c.state "paused") (throw "只能单步已暂停的子系统"))
     (put! c "stepping" 1) true)
    ("rate" (put! c "rate" (clamp (or a 1) 0.05 16)) (save-children) true)
    ("grant" (put! c "cap" (max 0 (floor a))) (when hp (put! hp "quota" c.cap)) (save-children) true)
    ("config"
     (each-kv (k v a) (when (and (num? v) (contains? ["budget" "mem" "storage" "cap"] k)) (put! c k (max 0 (floor v)))))
     (when hp (put! hp "quota" c.cap) (when hp.ctx (ctx-limit! hp.ctx c.mem)))
     (deliver-child-event c {:type "conf" :conf {:budget c.budget :mem c.mem :storage c.storage}})
     (save-children) true)
    ("stop" (when hp (put! hp "ended" CLOCK) (put! hp "child" nil) (kill-proc hp "killed")) (child-stopped id "已停止") true)
    ("restart"
     (when hp (put! hp "child" nil) (put! hp "ended" CLOCK) (kill-proc hp "killed"))
     (sys "k-drop-subtree" id)
     (put! c "inbox" []) (put! c "acc" 0) (put! c "stepping" 0) (inc! c.restarts)
     (start-child-kernel c)
     (when WM-PID (deliver-kernel WM-PID {:k "child-state" :id id :state "booting"}))
     (report-tree) true)
    ("close"
     (when hp (put! hp "child" nil) (put! hp "ended" CLOCK) (kill-proc hp "killed"))
     (sys "k-drop-subtree" id)
     (del! CHILDREN id) (remove-item! CHILD-ORDER id)
     (save-children)
     (when WM-PID (deliver-kernel WM-PID {:k "child-closed" :id id}))
     (report-tree) true)
    ("snapshot" (snapshot-child c))
    ("rename" (put! c "name" a) (save-children) (report-tree) true)
    (else (throw (str "未知的子系统操作: " action)))))

(defsys "children" (fn (p t)
  (var out [])
  (each (id CHILD-ORDER)
    (var c (get CHILDREN id))
    (var hp (host-of c))
    (var hi (if (and hp hp.ctx) (ctx-info hp.ctx) {}))
    (push! out {:id c.id :name c.name :state c.state :rate c.rate :cap c.cap :budget c.budget :mem c.mem :storage c.storage
                :error c.error :kernel c.kernel :pid c.host :last (if hp hp.last 0) :units (get-or hi "units" 0)
                :own c.own :inner c.inner :memUsed (get-or hi "mem" 0) :subtree c.subtree :disk (disk-usage c.id)}))
  out))
(defsys "child" (fn (p t)
  (if (= (arg t 1) "new")
    (child-create (arg t 3))
    (if (or (= (arg t 1) "restore") (= (arg t 1) "fork"))
      (snapshot-load (arg t 1) (arg t 2) (arg t 3))
      (child-control (arg t 1) (arg t 2) (arg t 3))))))
(defsys "child-input" (fn (p t)
  (var c (get CHILDREN (arg t 1)))
  (when c (push! c.inbox {:type "input" :ev (copy (arg t 2))}) (trim-inbox c))
  true))
(defsys "child-resize" (fn (p t)
  (var c (get CHILDREN (arg t 1)))
  (when c (put! c "size" [(arg t 2) (arg t 3)]) (push! c.inbox {:type "resize" :w (arg t 2) :h (arg t 3)}))
  true))
(defn trim-inbox (c) (when (> (len c.inbox) 4000) (shift! c.inbox)))
(defn deliver-child-event (c ev) (push! c.inbox ev) (trim-inbox c))

(defn disk-usage (id)
  (var prefix (str "/System/Disks/" id "/")) (var n 0)
  (each-kv (q e FILES) (when (and (= e.type "file") (starts-with? q prefix)) (inc! n e.size)))
  n)

(defn child-of-host (p) (if p.child (get CHILDREN p.child) nil))
(defn disk-path (c sub) (str "/System/Disks/" c.id sub))

;; 父系统接口：子系统内核发出的 k- 系统调用
(defsys "k-boot" (fn (p t)
  (var c (child-of-host p))
  (when (nil? c) (throw "不是承载进程"))
  {:id c.id :name c.name :path (concat MYPATH [c.id]) :depth (+ DEPTH 1)
   :conf {:budget c.budget :mem c.mem :storage c.storage} :size c.size :restarts c.restarts}))
(defsys "k-tick" (fn (p t)
  (var c (child-of-host p))
  (when (nil? c) (throw "不是承载进程"))
  (when (= c.state "booting") (put! c "state" "running") (report-tree)
        (when WM-PID (deliver-kernel WM-PID {:k "child-state" :id c.id :state "running"})))
  (put! p "state" "waiting") (put! p "wait" {:k "tick"})
  (when (= c.stepping 2) (put! c "stepping" 0))
  BLOCK))
(defsys "k-disk-dump" (fn (p t)
  (var c (child-of-host p)) (var prefix (disk-path c "")) (var out [])
  (each-kv (q e FILES)
    (when (starts-with? q (str prefix "/"))
      (push! out [(substr q (len prefix)) e.type (if (= e.type "file") e.data nil) e.mtime])))
  out))
(defsys "k-disk-write" (fn (p t) (var c (child-of-host p)) (fs-write (disk-path c (arg t 1)) (arg t 2))))
(defsys "k-disk-mkdir" (fn (p t) (var c (child-of-host p)) (fs-mkdir (disk-path c (arg t 1)))))
(defsys "k-disk-delete" (fn (p t) (var c (child-of-host p)) (var q (disk-path c (arg t 1))) (when (fs-exists q) (fs-delete q)) true))
(defsys "k-disk-rename" (fn (p t) (var c (child-of-host p)) (fs-rename (disk-path c (arg t 1)) (disk-path c (arg t 2)))))
(defsys "k-image" (fn (p t) (sys "k-image")))
(defsys "k-idalloc" (fn (p t) (sys "k-idalloc")))
(defsys "k-display" (fn (p t) (sys "k-display" (arg t 1) (copy (arg t 2)) (copy (arg t 3)))))
(defsys "k-display-res" (fn (p t) (sys "k-display-res" (arg t 1) (arg t 2) (copy (arg t 3)))))
(defsys "k-scene" (fn (p t) (sys "k-scene" (arg t 1) (arg t 2) (copy (arg t 3)))))
(defsys "k-drop-subtree" (fn (p t) (sys "k-drop-subtree" (arg t 1))))
(defsys "k-route" (fn (p t) (route (copy (arg t 1))) true))
(defsys "k-report" (fn (p t)
  (var c (child-of-host p))
  (when (and c (= (arg t 1) "tree")) (put! c "subtree" (arg t 2)) (report-tree))
  true))
(defsys "k-capture" (fn (p t) (sys "k-capture" (arg t 1))))
(defsys "k-restore-display" (fn (p t) (sys "k-restore-display" (arg t 1) (arg t 2) (arg t 3))))

(defn deliver-ticks (dt)
  ;; 每步开始时把时间与拨付交给等待中的子系统内核
  (each (id CHILD-ORDER)
    (var c (get CHILDREN id))
    (var hp (host-of c))
    (when (and c hp)
      (put! hp "quota" (min c.cap c.budget))
      (when (= c.state "running") (put! c "acc" (+ c.acc (* dt c.rate))))
      (var waiting (and (= hp.state "waiting") hp.wait (= hp.wait.k "tick")))
      (when (and waiting (or (= c.state "running") (and (= c.state "paused") (= c.stepping 1))))
        (when (= c.state "paused") (put! c "acc" (* STEP-DT c.rate)) (put! c "stepping" 2))
        (var evs c.inbox)
        (put! c "inbox" [])
        (put! hp "wait" nil) (put! hp "state" "ready")
        (ctx-resume hp.ctx {:dt c.acc :budget (min c.cap c.budget) :events evs :step STEPNO})
        (put! c "acc" 0)))))

(defn account-children ()
  (each (id CHILD-ORDER)
    (var c (get CHILDREN id))
    (var hp (host-of c))
    (when (and c hp hp.ctx)
      (var info (ctx-info hp.ctx))
      (put! c "own-last" (- info.own (get-or c "own-total" 0)))
      (put! c "inner-last" (- info.inner (get-or c "inner-total" 0)))
      (put! c "own" (get c "own-last")) (put! c "inner" (get c "inner-last"))
      (put! c "own-total" info.own) (put! c "inner-total" info.inner)
      ;; 子树内存超过配额时停止该子树（不影响本系统和兄弟）
      (when (> info.mem c.mem)
        (child-crashed hp (str "内存配额耗尽：" (fmt-bytes info.mem) " > " (fmt-bytes c.mem)))))))

(defn report-tree ()
  (var list [])
  (each (id CHILD-ORDER)
    (var c (get CHILDREN id))
    (push! list {:id c.id :parentId SYSID :name c.name :state c.state :rate c.rate :error c.error})
    (each (s c.subtree)
      ;; 祖先暂停时，后代显示为“受祖先暂停”
      (var st s.state)
      (when (and (or (= c.state "paused") (= c.state "stopped") (= c.state "kernel-error")) (= st "running")) (set! st "held"))
      (push! list (merge s {:state st}))))
  (var txt (to-json list))
  (when (!= txt LAST-TREE-REPORT)
    (set! LAST-TREE-REPORT txt)
    (sys "k-report" "tree" list)
    (when WM-PID (deliver-kernel WM-PID {:k "tree" :tree list}))))

(defn restore-children ()
  (var s (fs-read "/System/children.json"))
  (when s
    (each (r (parse-json s))
      (var c (new-child-record r.id r.name))
      (each (k ["rate" "cap" "budget" "mem" "storage"]) (when (get r k) (put! c k (get r k))))
      (put! CHILDREN r.id c)
      (push! CHILD-ORDER r.id)
      (start-child-kernel c)
      (when WM-PID (deliver-kernel WM-PID {:k "child-new" :id r.id :name c.name}))))
  (report-tree))

;; ---------------- 11. 跨层信封路由 ----------------
;; 信封 {to 目标路径 from 来源路径 kind 类型 data 数据}。
;; 目标是本系统时就地处理；目标在某个直属子系统的子树里时放进它的收件箱
;; （子系统暂停时信封留在这里，继续后按序交付）；否则交给父系统。
(defn route (env)
  (when (nil? env.from) (put! env "from" MYPATH))
  (var to env.to)
  (var me (index-of to SYSID))
  (cond
    ((and (>= me 0) (= me (- (len to) 1))) (handle-envelope env))
    ((>= me 0)
     (var c (get CHILDREN (nth to (+ me 1))))
     (if c (deliver-child-event c {:type "env" :env env}) (bounce env "目标系统不存在")))
    (else (sys "k-route" env))))

(defn bounce (env why)
  (when (and env.from (!= env.kind "bounce"))
    (route {:to env.from :kind "bounce" :data {:kind env.kind :why why :data env.data}})))

(defn handle-envelope (env)
  (var d env.data)
  (case env.kind
    ("proj-open" (when WM-PID (deliver-kernel WM-PID {:k "proj-open" :env env})))
    (("proj-focus" "proj-end" "proj-title") (when WM-PID (deliver-kernel WM-PID {:k env.kind :data d})))
    ("proj-opened"
     (var w (get WINS d.src-win))
     (when w (put! w "proj" {:path env.from :pwid d.proj})
       (deliver-kernel w.pid {:k "proj-opened" :wid w.wid :proj d.proj :w d.w :h d.h :target (last env.from)})))
    (("proj-input" "proj-resize")
     (var w (get WINS d.src-win))
     (if (and w w.proj (= w.proj.pwid d.proj))
       (deliver-kernel w.pid {:k env.kind :wid w.wid :ev d.ev :w d.w :h d.h})
       (route {:to env.from :kind "proj-end" :data {:proj d.proj :reason "源窗口已不存在"}})))
    ("proj-closed"
     (var w (get WINS d.src-win))
     (when (and w w.proj (= w.proj.pwid d.proj)) (put! w "proj" nil) (deliver-kernel w.pid {:k "proj-closed" :wid w.wid})))
    ("file-pull"
     (var content (try (fs-read d.path) (catch e nil)))
     (route {:to env.from :kind "file-data" :data {:req d.req :path d.path :name (basename d.path) :content content
                                                   :error (if (nil? content) "源文件不存在" nil)}}))
    (else
     ;; 交给登记了该端点的进程（数据订阅、文件传递应答等）
     (var key (or (get d "endpoint") (get d "sub") (get d "req")))
     (var pid (if key (get ENDPOINTS key) nil))
     (if pid
       (deliver-kernel pid {:k env.kind :data d :from env.from})
       (when WM-PID (deliver-kernel WM-PID {:k env.kind :data d :from env.from}))))))

(defsys "route" (fn (p t)
  (var env (copy (arg t 1)))
  (put! env "from" MYPATH)
  (route env)
  true))

;; ---------------- 12. 子树快照 ----------------
;; 快照保存所选子系统整棵子树在同一逻辑时点的状态：承载进程的完整上下文
;; （其中包括子系统内核、它的进程表、消息、等待、内存与随机状态以及更深的后代），
;; 子系统磁盘（文件），以及显示设备中该子树已提交的画面数据。
(defn snapshot-child (c)
  (var hp (host-of c))
  (when (or (nil? hp) (nil? hp.ctx)) (throw "子系统没有运行，无法快照"))
  (inc! SNAP-SEQ)
  (var disk [])
  (var prefix (disk-path c ""))
  (each-kv (q e FILES) (when (starts-with? q (str prefix "/")) (push! disk [(substr q (len prefix)) e.type (if (= e.type "file") e.data nil)])))
  (var snap {:format "nest-snapshot" :v 1 :id c.id :name c.name :time CLOCK :parent SYSID
             :state c.state :rate c.rate :cap c.cap :budget c.budget :mem c.mem :storage c.storage
             :subtree c.subtree :kernel-src (fs-read c.kernel)
             :host (ctx-serialize hp.ctx) :hostWait (if hp.wait hp.wait.k nil) :hostState hp.state
             :inbox c.inbox :acc c.acc :disk disk :display (sys "k-capture" c.id)})
  (var path (str "/Snapshots/" c.id "-" (pad-left SNAP-SEQ 3 "0") ".snap"))
  (fs-write path (to-json snap))
  (when WM-PID (deliver-kernel WM-PID {:k "notify" :title "快照已保存" :body path}))
  path)

(defn snapshot-load (mode path target)
  (var s (fs-read path))
  (when (nil? s) (throw (str "快照不存在: " path)))
  (var snap (parse-json s))
  (when (!= snap.format "nest-snapshot") (throw "不是快照文件"))
  (var ids [snap.id])
  (each (x snap.subtree) (push! ids x.id))
  (var c nil) (var map {})
  (if (= mode "restore")
    (do (set! c (get CHILDREN (or target snap.id)))
        (when (nil? c) (throw (str "原实例不存在，请用“分叉”打开: " snap.id)))
        (when (!= c.id snap.id) (throw "快照属于其他实例"))
        (var hp0 (host-of c))
        (when hp0 (put! hp0 "child" nil) (put! hp0 "ended" CLOCK) (kill-proc hp0 "killed"))
        (sys "k-drop-subtree" c.id))
    (do (each (old ids) (put! map old (sys "k-idalloc")))
        (set! c (new-child-record (get map snap.id) (str snap.name " 分叉")))
        (put! CHILDREN c.id c) (push! CHILD-ORDER c.id)))
  ;; 磁盘
  (var dpre (disk-path c ""))
  (when (fs-exists dpre) (fs-delete dpre))
  (each (e snap.disk)
    (var dp (if (= mode "fork") (remap-data (nth e 0) map) (nth e 0)))
    (if (= (nth e 1) "dir") (fs-mkdir (str dpre dp)) (fs-write (str dpre dp) (nth e 2))))
  (fs-write c.kernel (or snap.kernel-src (fs-read "/System/kernel.nest")))
  ;; 运行状态
  (var hctx (ctx-deserialize snap.host))
  (when (= mode "fork") (ctx-remap hctx map))
  (each (k ["rate" "cap" "budget" "mem" "storage"]) (put! c k (get snap k)))
  (put! c "subtree" (if (= mode "fork") (remap-data snap.subtree map) snap.subtree))
  (put! c "state" (if (= snap.state "paused") "paused" "running"))
  (put! c "acc" snap.acc) (put! c "stepping" 0) (put! c "error" nil)
  (put! c "inbox" (if (= mode "fork") (remap-data snap.inbox map) snap.inbox))
  (push! c.inbox {:type "restored" :mode mode})
  (var hp (make-proc (str "承载 " c.id) c.kernel "host" nil))
  (put! hp "child" c.id) (put! hp "quota" c.cap) (put! hp "ctx" hctx)
  (put! c "host" hp.pid)
  (if (= snap.hostWait "tick")
    (do (put! hp "state" "waiting") (put! hp "wait" {:k "tick"}))
    (put! hp "state" "ready"))
  (sys "k-restore-display" (if (= mode "fork") (remap-data snap.display map) snap.display) mode map)
  (save-children)
  (when WM-PID (deliver-kernel WM-PID {:k (if (= mode "fork") "child-new" "child-state") :id c.id :name c.name :state c.state}))
  (report-tree)
  c.id)

;; ---------------- 13. 启动与主循环 ----------------
(defn mem-used-total ()
  (var n 0)
  (each-kv (k v DEVMEM) (inc! n v))
  n)

(defn check-memory ()
  ;; 每秒测量各进程内存，并按本系统配额调整各进程的上限
  (when (>= CLOCK MEM-CHECK-AT)
    (set! MEM-CHECK-AT (+ CLOCK 1))
    (var total 0)
    (each (pid PORDER)
      (var p (proc-of pid))
      (when (and p p.ctx (not (= p.state "done")) (not (= p.state "error")))
        (put! p "mem" (ctx-mem p.ctx))
        (inc! total p.mem)))
    (var free (- CONF.mem total (mem-used-total)))
    (each (pid PORDER)
      (var p (proc-of pid))
      (when (and p p.ctx (nil? p.child) (not (= p.state "done")))
        (ctx-limit! p.ctx (max 65536 (min (proc-mem-limit p) (+ p.mem (max 0 free)))))))))

(defn on-events (evs)
  (each (ev evs)
    (case ev.type
      ("input" (when WM-PID (deliver-kernel WM-PID {:k "input" :ev ev.ev})))
      ("resize" (set! DESK-SIZE [ev.w ev.h]) (when WM-PID (deliver-kernel WM-PID {:k "resize" :w ev.w :h ev.h})))
      ("env" (route ev.env))
      ("conf" (each-kv (k v ev.conf) (put! CONF k v)) (save-conf))
      ("restored"
       (each-kv (k w WINS) (put! w "proj" nil))
       ;; 从快照恢复或分叉：通知各进程（图表连接改为“已恢复，待重新连接”等），并传给后代
       (each (pid PORDER) (var p (proc-of pid)) (when (and p (nil? p.child) p.ctx) (deliver-kernel pid {:k "restored" :mode ev.mode})))
       (each (id CHILD-ORDER) (var c (get CHILDREN id)) (when c (deliver-child-event c ev))))
      (else nil))))

(defn start-wm ()
  (var wm (spawn-proc "/System/wm.nest" {:size DESK-SIZE} "wm" nil))
  (put! wm "quota" 40000)
  (set! WM-PID wm.pid))

(defn boot ()
  (set! BOOT (sys "k-boot"))
  (set! SYSID BOOT.id) (set! MYPATH BOOT.path) (set! DEPTH BOOT.depth) (set! NAME BOOT.name)
  (set! CONF BOOT.conf)
  (when BOOT.size (set! DESK-SIZE BOOT.size))
  (mount-fs)
  ;; 本系统自己的配置（由本系统进程管理器修改）
  (var saved (fs-read "/System/config.json"))
  (when saved (each-kv (k v (parse-json saved)) (when (not (contains? ["budget" "mem" "storage"] k)) (put! CONF k v))))
  (when (nil? (get CONF "child-cap")) (put! CONF "child-cap" (floor (* CONF.budget 0.8))))
  (when (nil? (get CONF "proc-quota")) (put! CONF "proc-quota" (floor (* CONF.budget 0.5))))
  (load-bin-index)
  (start-wm)
  (restore-children))

(defn main ()
  (boot)
  (while true
    (var t (sys "k-tick"))
    (advance-clock t.dt)
    (on-events t.events)
    (deliver-ticks t.dt)
    (check-memory)
    (run-step (min t.budget CONF.budget))
    (account-children)
    (when (= (% STEPNO 120) 0) (reap))))

(main)
