;; Nest 核心库：常用的列表、字典、路径与字符串函数（各程序用 (include "/System/lib/core.nest") 引入）

(defn map-list (f l) (var r []) (each (x l) (push! r (f x))) r)
(defn filter (f l) (var r []) (each (x l) (when (f x) (push! r x))) r)
(defn find (f l) (var r nil) (each (x l) (when (f x) (set! r x) (break))) r)
(defn find-index (f l) (var r -1) (each-i (i x l) (when (f x) (set! r i) (break))) r)
(defn reduce (f acc l) (each (x l) (set! acc (f acc x))) acc)
(defn any? (f l) (var r false) (each (x l) (when (f x) (set! r true) (break))) r)
(defn all? (f l) (var r true) (each (x l) (when (not (f x)) (set! r false) (break))) r)
(defn sum (l) (var s 0) (each (x l) (inc! s x)) s)
(defn remove-item! (l x) (var i (index-of l x)) (when (>= i 0) (remove-at! l i)) l)
(defn take (l n) (slice l 0 n))
(defn merge (a b) (var r {}) (each-kv (k v a) (put! r k v)) (each-kv (k v b) (put! r k v)) r)
(defn get-or (d k dflt) (var v (get d k)) (if (nil? v) dflt v))

;; 归并排序（比较函数返回负数/零/正数）
(defn sort-with (l cmpf)
  (var n (len l))
  (if (<= n 1)
    (slice l 0)
    (do (var mid (floor (/ n 2)))
        (var a (sort-with (slice l 0 mid) cmpf))
        (var b (sort-with (slice l mid) cmpf))
        (var r []) (var i 0) (var j 0)
        (while (and (< i (len a)) (< j (len b)))
          (if (<= (cmpf (nth a i) (nth b j)) 0)
            (do (push! r (nth a i)) (inc! i))
            (do (push! r (nth b j)) (inc! j))))
        (while (< i (len a)) (push! r (nth a i)) (inc! i))
        (while (< j (len b)) (push! r (nth b j)) (inc! j))
        r)))
(defn compare (a b) (cond ((< a b) -1) ((> a b) 1) (else 0)))

;; ---- 路径 ----
(defn path-join (dir name) (if (= dir "/") (str "/" name) (str dir "/" name)))
(defn dirname (p)
  (var i (last-index-of p "/"))
  (if (<= i 0) "/" (substr p 0 i)))
(defn basename (p) (substr p (+ (last-index-of p "/") 1)))
(defn ext-of (p)
  (var b (basename p)) (var i (last-index-of b "."))
  (if (<= i 0) "" (lower (substr b (+ i 1)))))
(defn stem-of (p)
  (var b (basename p)) (var i (last-index-of b "."))
  (if (<= i 0) b (substr b 0 i)))
(defn last-index-of (s ch)
  (var i (- (len s) 1)) (var r -1)
  (while (>= i 0) (when (= (char-at s i) ch) (set! r i) (break)) (dec! i))
  r)
(defn under? (p dir) (or (= p dir) (starts-with? p (if (= dir "/") "/" (str dir "/")))))

;; ---- 字符串 ----
(defn fmt-time (t)
  (var s (floor t)) (var m (floor (/ s 60)))
  (str (pad-left (% m 60) 2 "0") ":" (pad-left (% s 60) 2 "0") "." (floor (* (- t s) 10))))
(defn fmt-clock (t)
  (var s (floor t))
  (str (pad-left (% (floor (/ s 3600)) 24) 2 "0") ":" (pad-left (% (floor (/ s 60)) 60) 2 "0") ":" (pad-left (% s 60) 2 "0")))
(defn fmt-bytes (n)
  (cond ((nil? n) "-")
        ((>= n 1048576) (str (fmt (/ n 1048576) 1) " MB"))
        ((>= n 1024) (str (fmt (/ n 1024) 1) " KB"))
        (else (str n " B"))))
(defn fmt-units (n)
  (cond ((>= n 1000000) (str (fmt (/ n 1000000) 2) "M"))
        ((>= n 10000) (str (fmt (/ n 1000) 1) "k"))
        (else (str (round n)))))
(defn starts-any? (s prefixes) (any? (fn (p) (starts-with? s p)) prefixes))

;; ---- 系统调用的便捷包装 ----
(defn now () (sys "now"))
(defn sleep (s) (sys "sleep" s))
(defn self-pid () (sys "self"))
(defn send (pid msg) (sys "send" pid msg))
(defn recv () (sys "recv"))
(defn recv-timeout (s) (sys "recv" s))
(defn try-recv () (sys "try-recv"))
(defn log (& xs) (sys "log" (join (map-list (fn (x) (to-str x)) xs) " ")))
(defn read-file (p) (sys "read" p))
(defn write-file (p s) (sys "write" p s))
(defn spawn (p args) (sys "spawn" p args))
