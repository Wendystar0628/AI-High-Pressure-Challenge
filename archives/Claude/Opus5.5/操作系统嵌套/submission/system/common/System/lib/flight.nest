;; =====================================================================
;; 旋翼机飞行模型（通用）：机体是不稳定的被控对象，状态随虚拟时间连续演化。
;; 所有机型参数、地形、停机坪与障碍都来自场景资源的 physics 段，本库不含任何特定机型。
;; 状态 S 是一个字典（可复制、可保存为检查点）；step 以固定步长 DT 推进。
;; =====================================================================

(def DT 0.01)

;; ---------------- 地形 ----------------
(defn smooth01 (x) (var t (clamp x 0 1)) (* t t (- 3 (* 2 t))))
(defn terrain-h (P x z)
  ;; 与显示设备使用同一组参数：基准高度 + 正弦起伏 + 平整区
  (var T P.terrain)
  (var h T.base)
  (each (w T.waves) (inc! h (* (nth w 0) (sin (+ (* (nth w 1) x) (* (nth w 2) z) (nth w 3))))))
  (each (f T.flats)
    (var dx (- x (nth f 0))) (var dz (- z (nth f 1)))
    (var d (sqrt (+ (* dx dx) (* dz dz))))
    (var k (- 1 (smooth01 (/ (- d (nth f 2)) (nth f 4)))))
    (when (> k 0) (set! h (+ (* h (- 1 k)) (* (nth f 3) k)))))
  h)

;; 地面（含停机坪顶面与建筑屋顶）
(defn ground-h (P x z)
  (var h (terrain-h P x z))
  (each (pd P.pads)
    (var dx (- x pd.x)) (var dz (- z pd.z))
    (when (< (+ (* dx dx) (* dz dz)) (* pd.r pd.r)) (set! h (max h pd.top))))
  h)

;; 本步机体附近的地面平面（中心高度与坡度），接触点用它近似，避免逐点求地形
(var GPX 0) (var GPZ 0) (var GH0 0) (var GX 0) (var GZ 0) (var OBS-NEAR false)
(defn ground-frame (P x z)
  (set! GPX x) (set! GPZ z)
  (set! GH0 (ground-h P x z))
  (var t0 (terrain-h P x z))
  (if (> GH0 (+ t0 0.05))
    (do (set! GX 0) (set! GZ 0))
    (do (set! GX (/ (- (terrain-h P (+ x 1) z) t0) 1)) (set! GZ (/ (- (terrain-h P x (+ z 1)) t0) 1))))
  (set! OBS-NEAR (or (> (len NEAR) 0)
                     (any? (fn (b) (and (< (abs (- x b.x)) (+ b.sx 9)) (< (abs (- z b.z)) (+ b.sz 9)))) P.boxes)
                     (any? (fn (c) (< (+ (abs (- x c.x)) (abs (- z c.z))) (+ c.r 12))) P.cyls))))
(defn local-ground (x z) (+ GH0 (* GX (- x GPX)) (* GZ (- z GPZ))))

;; 点是否在障碍内（建筑盒子、圆柱、树）；NEAR 是本步机体附近的树（每步计算一次）
(var NEAR [])
(defn near-trees (P x z)
  (var G P.treeGrid) (var out [])
  (when G
    (var cx (floor (/ x G.cell))) (var cz (floor (/ z G.cell)))
    (for (dx -1 2) (for (dz -1 2)
      (var cell (get G.cells (str (+ cx dx) "," (+ cz dz))))
      (when cell (each (i cell) (push! out (nth P.trees i)))))))
  out)
(defn obstacle-at (P x y z)
  (var hit nil)
  (when (< y (get-or P "obsTop" 40))
    (each (b P.boxes)
      (when (and (< (abs (- x b.x)) b.sx) (< (abs (- z b.z)) b.sz) (< y (+ b.y b.sy)) (> y (- b.y b.sy)))
        (set! hit (or b.name "建筑"))))
    (each (c P.cyls)
      (var dx (- x c.x)) (var dz (- z c.z))
      (when (and (< (+ (* dx dx) (* dz dz)) (* c.r c.r)) (> y c.base) (< y (+ c.base c.h))) (set! hit (or c.name "障碍"))))
    (each (tr NEAR)
      (var dx (- x (nth tr 0))) (var dz (- z (nth tr 2)))
      (var r (* 1.6 (nth tr 4)))
      (when (and (< (+ (* dx dx) (* dz dz)) (* r r)) (> y (nth tr 1)) (< y (+ (nth tr 1) (* 9 (nth tr 4)))))
        (set! hit "树木"))))
  hit)

;; ---------------- 四元数与向量 ----------------
(defn qrot (S x y z)
  ;; 机体坐标 -> 世界坐标
  (var w S.qw) (var a S.qx) (var b S.qy) (var c S.qz)
  (var tx (* 2 (- (* b z) (* c y)))) (var ty (* 2 (- (* c x) (* a z)))) (var tz (* 2 (- (* a y) (* b x))))
  [(+ x (* w tx) (- (* b tz) (* c ty))) (+ y (* w ty) (- (* c tx) (* a tz))) (+ z (* w tz) (- (* a ty) (* b tx)))])
(defn qrot-inv (S x y z)
  (var w S.qw) (var a (- S.qx)) (var b (- S.qy)) (var c (- S.qz))
  (var tx (* 2 (- (* b z) (* c y)))) (var ty (* 2 (- (* c x) (* a z)))) (var tz (* 2 (- (* a y) (* b x))))
  [(+ x (* w tx) (- (* b tz) (* c ty))) (+ y (* w ty) (- (* c tx) (* a tz))) (+ z (* w tz) (- (* a ty) (* b tx)))])
(defn quat-from-yaw (yaw) {:qw (cos (/ yaw 2)) :qx 0 :qy (sin (/ yaw 2)) :qz 0})
(defn heading-of (S)
  (var f (qrot S 1 0 0))
  (atan2 (- (nth f 2)) (nth f 0)))

;; ---------------- 初始状态 ----------------
(defn new-state (P init)
  (var yaw (or init.yaw 0))
  (var q (quat-from-yaw yaw))
  (var y0 (+ (ground-h P init.x init.z) (or init.lift 1.18)))
  {:t 0 :step 0 :px init.x :py y0 :pz init.z :vx 0 :vy 0 :vz 0
   :qw q.qw :qx q.qx :qy q.qy :qz q.qz :wx 0 :wy 0 :wz 0
   :rpm (or init.rpm 0) :throttle (or init.throttle 1) :c 0 :p 0 :r 0 :y 0
   :tail 1 :main 1 :vib 0 :crashed false :impact nil :landed nil :grounded true
   :debris [] :events [] :wind-x 0 :wind-z 0 :fault-warn nil :fault-at nil :rot 0 :trot 0 :hit nil})

;; ---------------- 一步 ----------------
(defn step (S P ctl)
  (var dt DT)
  (var g P.g)
  (var t (+ S.t dt))
  ;; 控制量（保持到下一次写入）
  (when ctl (put! S "c" (clamp ctl.c 0 1)) (put! S "p" (clamp ctl.p -1 1)) (put! S "r" (clamp ctl.r -1 1)) (put! S "y" (clamp ctl.y -1 1))
    (when (num? ctl.throttle) (put! S "throttle" ctl.throttle)))
  ;; 故障：先有征兆（振动、冒烟），到时尾桨失效
  (when (and S.fault-warn (>= t S.fault-warn) (nil? (get S "warned")))
    (put! S "warned" true) (push! S.events ["fault-warn" t]))
  (when (and S.fault-at (>= t S.fault-at) (> S.tail 0))
    (put! S "tail" 0) (push! S.events ["tail-fail" t]))
  ;; 旋翼转速
  (var target (if S.crashed 0 (* S.throttle S.main)))
  (put! S "rpm" (+ S.rpm (* (- target S.rpm) (/ dt (if S.crashed 0.5 P.rpmTau)))))
  (var w2 (* S.rpm S.rpm))
  (put! S "rot" (+ S.rot (* dt S.rpm 38)))
  (put! S "trot" (+ S.trot (* dt S.rpm S.tail 110)))
  ;; 机体轴
  (var up (qrot S 0 1 0))
  (var ub (qrot-inv S 0 1 0))
  ;; 每 5 步更新一次附近的树与地面平面（检查点间隔 50 步，跳转后结果与连续播放一致）
  (when (= (% S.step 5) 0) (set! NEAR (near-trees P S.px S.pz)) (ground-frame P S.px S.pz))
  (var gh (local-ground S.px S.pz))
  (var alt (- S.py gh))
  (var ge (* P.groundEffect (max 0 (- 1 (/ alt (* 1.5 P.rotorRadius))))))
  (var thrust (if S.crashed 0 (* P.thrustMax S.c w2 (+ 1 ge) S.main)))
  ;; 力（世界坐标，质量为 1）
  (var rx (- S.vx S.wind-x)) (var ry S.vy) (var rz (- S.vz S.wind-z))
  (var sp (sqrt (+ (* rx rx) (* ry ry) (* rz rz))))
  (var fx (- (* (nth up 0) thrust) (* P.drag sp rx)))
  (var fy (- (* (nth up 1) thrust) g (* P.dragV sp ry)))
  (var fz (- (* (nth up 2) thrust) (* P.drag sp rz)))
  ;; 力矩（机体坐标）：舵面 + 主旋翼反扭矩 + 不稳定翻转力矩 + 阵风 + 阻尼
  (var K P.torque)
  (var auth (* w2 (if S.crashed 0 1)))
  (var tx (+ (* K.roll S.r auth) (* P.instability (- (nth ub 2)))))
  (var tz (+ (* K.pitch S.p auth) (* P.instability (nth ub 0))))
  (var ty (- (* K.yaw S.y auth S.tail) (* K.mainReaction S.c auth (- 1 (* 0.82 S.tail)))))
  (var wind (sqrt (+ (* S.wind-x S.wind-x) (* S.wind-z S.wind-z))))
  (var gust (* 0.035 wind (+ (sin (* 1.7 t)) (* 0.6 (sin (+ (* 2.9 t) 1.3))))))
  (inc! tx gust) (inc! tz (* 0.7 gust))
  (when (get S "warned")
    (when (> S.tail 0) (inc! tx (* 0.25 (sin (* 31 t)))) (inc! tz (* 0.18 (sin (* 23 t)))) (inc! ty (* 0.3 (sin (* 17 t))))))
  (var D P.angDamp)
  (var ydamp (* (nth D 1) (+ (get-or P "tailYawDamp" 1) (* (- 1 (get-or P "tailYawDamp" 1)) S.tail))))
  (set! tx (- tx (* (nth D 0) S.wx))) (set! ty (- ty (* ydamp S.wy))) (set! tz (- tz (* (nth D 2) S.wz)))
  ;; 接触：起落架、旋翼桨尖与机体
  (var contact (contacts S P))
  (inc! fx (nth contact 0)) (inc! fy (nth contact 1)) (inc! fz (nth contact 2))
  (var tb (qrot-inv S (nth contact 3) (nth contact 4) (nth contact 5)))
  (inc! tx (nth tb 0)) (inc! ty (nth tb 1)) (inc! tz (nth tb 2))
  (put! S "grounded" (> (nth contact 6) 0))
  ;; 积分
  (var I P.inertia)
  (put! S "wx" (+ S.wx (* dt (/ tx (nth I 0)))))
  (put! S "wy" (+ S.wy (* dt (/ ty (nth I 1)))))
  (put! S "wz" (+ S.wz (* dt (/ tz (nth I 2)))))
  (put! S "vx" (+ S.vx (* fx dt))) (put! S "vy" (+ S.vy (* fy dt))) (put! S "vz" (+ S.vz (* fz dt)))
  (put! S "px" (+ S.px (* S.vx dt))) (put! S "py" (+ S.py (* S.vy dt))) (put! S "pz" (+ S.pz (* S.vz dt)))
  (integrate-q S S.wx S.wy S.wz dt)
  ;; 碰撞判定
  (when (not S.crashed) (check-crash S P alt))
  (when S.crashed (step-debris S P dt))
  (put! S "t" t) (put! S "step" (+ S.step 1))
  S)

(defn integrate-q (S wx wy wz dt)
  (var w S.qw) (var a S.qx) (var b S.qy) (var c S.qz)
  (var h (* 0.5 dt))
  (var nw (- w (* h (+ (* a wx) (* b wy) (* c wz)))))
  (var na (+ a (* h (+ (* w wx) (- (* b wz) (* c wy))))))
  (var nb (+ b (* h (+ (* w wy) (- (* c wx) (* a wz))))))
  (var nc (+ c (* h (+ (* w wz) (- (* a wy) (* b wx))))))
  (var n (sqrt (+ (* nw nw) (* na na) (* nb nb) (* nc nc))))
  (put! S "qw" (/ nw n)) (put! S "qx" (/ na n)) (put! S "qy" (/ nb n)) (put! S "qz" (/ nc n)))

(defn contacts (S P)
  ;; 返回 [Fx Fy Fz Tx Ty Tz 接触点数]（世界坐标）
  (var C P.contact)
  (var Fx 0) (var Fy 0) (var Fz 0) (var Tx 0) (var Ty 0) (var Tz 0) (var n 0)
  (var wW (qrot S S.wx S.wy S.wz))
  (var pts (if S.crashed P.wreckPoints P.skids))
  (each (lp pts)
    (var r (qrot S (nth lp 0) (nth lp 1) (nth lp 2)))
    (var x (+ S.px (nth r 0))) (var y (+ S.py (nth r 1))) (var z (+ S.pz (nth r 2)))
    (var gh (local-ground x z))
    (when (< y gh)
      (inc! n)
      (var d (- gh y))
      ;; 接触点速度 v + ω×r
      (var pvx (+ S.vx (- (* (nth wW 1) (nth r 2)) (* (nth wW 2) (nth r 1)))))
      (var pvy (+ S.vy (- (* (nth wW 2) (nth r 0)) (* (nth wW 0) (nth r 2)))))
      (var pvz (+ S.vz (- (* (nth wW 0) (nth r 1)) (* (nth wW 1) (nth r 0)))))
      (var fn (max 0 (- (* C.k d) (* C.c pvy))))
      (var tv (sqrt (+ (* pvx pvx) (* pvz pvz))))
      (var fr (if (> tv 0.001) (min (* C.mu fn) (* 60 tv)) 0))
      (var ffx (if (> tv 0.001) (- (* fr (/ pvx tv))) 0))
      (var ffz (if (> tv 0.001) (- (* fr (/ pvz tv))) 0))
      (inc! Fx ffx) (inc! Fy fn) (inc! Fz ffz)
      (inc! Tx (- (* (nth r 1) ffz) (* (nth r 2) fn)))
      (inc! Ty (- (* (nth r 2) ffx) (* (nth r 0) ffz)))
      (inc! Tz (- (* (nth r 0) fn) (* (nth r 1) ffx)))))
  [Fx Fy Fz Tx Ty Tz n])

(defn check-crash (S P alt)
  (var C P.contact)
  (var ub (qrot-inv S 0 1 0))
  (var speed (sqrt (+ (* S.vx S.vx) (* S.vy S.vy) (* S.vz S.vz))))
  (var why nil) (var hx S.px) (var hy S.py) (var hz S.pz)
  ;; 机体球与障碍/地面
  (each (sp P.bodySpheres)
    (when (nil? why)
      (var r (qrot S (nth sp 0) (nth sp 1) (nth sp 2)))
      (var x (+ S.px (nth r 0))) (var y (+ S.py (nth r 1))) (var z (+ S.pz (nth r 2)))
      (var ob (if OBS-NEAR (obstacle-at P x y z) nil))
      (cond (ob (set! why ob) (set! hx x) (set! hy y) (set! hz z))
            ((< (- y (nth sp 3)) (local-ground x z))
             (when (or (> speed C.crashSpeed) (< (nth ub 1) C.crashTilt)) (set! why "撞地") (set! hx x) (set! hy y) (set! hz z))))))
  ;; 旋翼桨尖
  (when (and (nil? why) (< alt (+ P.rotorRadius 1)) (= (% S.step 3) 0))
    (each (rp P.rotorRim)
      (when (nil? why)
        (var r (qrot S (nth rp 0) (nth rp 1) (nth rp 2)))
        (var x (+ S.px (nth r 0))) (var y (+ S.py (nth r 1))) (var z (+ S.pz (nth r 2)))
        (when (or (< y (local-ground x z)) (and OBS-NEAR (obstacle-at P x y z))) (set! why (if (< y (local-ground x z)) "旋翼触地" "旋翼撞上障碍")) (set! hx x) (set! hy y) (set! hz z)))))
  ;; 起落架硬着陆或倾覆
  (when (and (nil? why) S.grounded (or (< (nth ub 1) C.crashTilt) (< S.vy (- C.crashSpeed))))
    (set! why "硬着陆"))
  (when why (crash! S P why hx hy hz speed))
  (when (> alt 3) (put! S "airborne" true))
  ;; 降落在停机坪上（必须先离地）
  (when (and (nil? why) S.grounded S.airborne (< speed 0.6) (> (nth ub 1) 0.96))
    (each (pd P.pads)
      (var dx (- S.px pd.x)) (var dz (- S.pz pd.z))
      (when (and (< (+ (* dx dx) (* dz dz)) (* pd.r pd.r)) (!= S.landed pd.id) (> S.t 1))
        (put! S "landed" pd.id) (push! S.events ["landed" S.t pd.id])))))

(defn hash01 (a b)
  (var x (sin (+ (* a 12.9898) (* b 78.233))))
  (var y (* x 43758.5453))
  (- y (floor y)))

(defn crash! (S P why x y z speed)
  (put! S "crashed" true)
  (put! S "impact" {:t S.t :x x :y y :z z :speed speed :why why})
  (push! S.events ["impact" S.t x y z speed why])
  ;; 部件损坏与碎片：初速度来自机体当前运动，散布由撞击时刻与位置决定
  (var seed (+ (* S.t 7.31) (* x 0.13) (* z 0.17)))
  (var spin S.rot)
  (each-i (i d P.debris)
    (var lp (nth d "local"))
    (var a (+ spin (* i 1.57)))
    (var lx (nth lp 0)) (var ly (nth lp 1)) (var lz (nth lp 2))
    (when (get d "blade")
      ;; 桨叶跟随旋转角度：从桨毂沿当前方位飞出
      (set! lx (+ (nth lp 0) (* 2.6 (cos a)))) (set! lz (+ (nth lp 2) (* -2.6 (sin a)))))
    (var r (qrot S lx ly lz))
    (var h1 (hash01 seed i)) (var h2 (hash01 (+ seed 3.1) i)) (var h3 (hash01 (+ seed 5.7) i))
    (var out (or (get d "burst") 4))
    (var vx (+ (* S.vx 0.6) (* out (- h1 0.5) 2) (if (get d "blade") (* 9 (- (sin a))) 0)))
    (var vy (+ (* (abs S.vy) 0.3) (* out (+ 0.5 h2))))
    (var vz (+ (* S.vz 0.6) (* out (- h3 0.5) 2) (if (get d "blade") (* 9 (- (cos a))) 0)))
    (push! S.debris {:id d.id :px (+ S.px (nth r 0)) :py (+ S.py (nth r 1)) :pz (+ S.pz (nth r 2))
                     :vx vx :vy vy :vz vz
                     :qw S.qw :qx S.qx :qy S.qy :qz S.qz
                     :wx (* 8 (- h2 0.5)) :wy (* 10 (- h1 0.5)) :wz (* 8 (- h3 0.5))
                     :r (get d "r") :rest false :blade (get d "blade") :ang a}))
  (put! S "main" 0) (put! S "tail" 0)
  (put! S "vx" (* S.vx 0.35)) (put! S "vy" (* S.vy -0.15)) (put! S "vz" (* S.vz 0.35))
  (put! S "wx" (+ (* S.wx 0.4) 1.4)) (put! S "wz" (* S.wz 0.4)))

(defn step-debris (S P dt)
  (var g P.g)
  (each (d S.debris)
    (when (not d.rest)
      (put! d "vy" (- d.vy (* g dt)))
      (put! d "vx" (* d.vx (- 1 (* 0.15 dt)))) (put! d "vz" (* d.vz (- 1 (* 0.15 dt))))
      (put! d "px" (+ d.px (* d.vx dt))) (put! d "py" (+ d.py (* d.vy dt))) (put! d "pz" (+ d.pz (* d.vz dt)))
      (when (or (nil? d.gh) (= (% S.step 6) 0)) (put! d "gh" (ground-h P d.px d.pz)))
      (var gh (+ d.gh d.r))
      (when (< d.py gh)
        (put! d "py" gh)
        (put! d "vy" (* (abs d.vy) 0.28))
        (put! d "vx" (* d.vx 0.55)) (put! d "vz" (* d.vz 0.55))
        (put! d "wx" (* d.wx 0.6)) (put! d "wy" (* d.wy 0.6)) (put! d "wz" (* d.wz 0.6))
        (when (and (< (+ (abs d.vx) (abs d.vy) (abs d.vz)) 0.5) (< (+ (abs d.wx) (abs d.wy) (abs d.wz)) 0.6))
          (put! d "rest" true) (put! d "vx" 0) (put! d "vy" 0) (put! d "vz" 0)))
      (integrate-q-world d dt))))

(defn integrate-q-world (d dt)
  ;; 碎片的角速度在世界坐标：q' = 0.5 ω q
  (var w d.qw) (var a d.qx) (var b d.qy) (var c d.qz)
  (var ox d.wx) (var oy d.wy) (var oz d.wz) (var h (* 0.5 dt))
  (var nw (- w (* h (+ (* ox a) (* oy b) (* oz c)))))
  (var na (+ a (* h (+ (* ox w) (- (* oy c) (* oz b))))))
  (var nb (+ b (* h (+ (* oy w) (- (* oz a) (* ox c))))))
  (var nc (+ c (* h (+ (* oz w) (- (* ox b) (* oy a))))))
  (var n (sqrt (+ (* nw nw) (* na na) (* nb nb) (* nc nc))))
  (put! d "qw" (/ nw n)) (put! d "qx" (/ na n)) (put! d "qy" (/ nb n)) (put! d "qz" (/ nc n)))

;; 传感器读数（带时间戳），供飞控进程读取
(defn sensors (S P)
  (var ub (qrot-inv S 0 1 0))
  (var f (qrot S 1 0 0))
  {:t S.t :x S.px :y S.py :z S.pz :vx S.vx :vy S.vy :vz S.vz
   :alt (- S.py (ground-h P S.px S.pz)) :roll (asin (clamp (- (nth ub 2)) -1 1)) :pitch (asin (clamp (nth ub 0) -1 1))
   :heading (atan2 (- (nth f 2)) (nth f 0)) :p S.wx :q S.wz :r S.wy :rpm S.rpm :crashed S.crashed :grounded S.grounded
   :landed S.landed})
