;; =====================================================================
;; 图表工作台：从根系统电子表格建立实时数据连接，绘制分组柱状图或折线图
;; 进程分工：本进程负责界面、取值（extract）、坐标计算与绘图（draw-chart）；
;;          /Apps/charts/recv.nest 负责连接、接收与版本校验。两者通过消息协作。
;; 图表过渡使用本系统虚拟时间；投送窗口显示同一结果。
;; =====================================================================
(include "/System/lib/core.nest")
(include "/System/lib/ui.nest")
(include "/System/lib/app.nest")

(var INFO (ui-init))
(var SYSID INFO.id)
(var RECV nil)
(var SOURCES []) (var SRC nil) (var SRC-TITLE "") (var RANGE "A1:D4") (var LABEL-COL "A") (var SERIES ["D"])
(var TYPE "bar") (var CONN "未连接") (var VERSION 0) (var RECEIVED 0)
(var DATA nil) (var SHOWN nil) (var PREV nil) (var T0 -10) (def TRANS 0.6)
(var HOVER nil) (var SEL nil) (var MENU nil) (var NOTE "") (var HITS-MAIN []) (var HITS-PROJ [])
(var PROCESSED 0)
(def PAL ["#5eead4" "#a78bfa" "#f5b942" "#f472b6" "#60a5fa" "#fb923c"])

(defn col-index (letter) (- (char-code (upper letter) 0) 65))
(defn col-letter (i) (from-code (+ 65 i)))
(defn range-cols ()
  (var parts (split (upper (trim RANGE)) ":"))
  (var a (col-index (or (char-at (first parts) 0) "A"))) (var b (col-index (or (char-at (or (nth parts 1) (first parts)) 0) "A")))
  (if (and (>= a 0) (>= b a) (< b 26)) (map-list (fn (i) (col-letter i)) (range a (+ b 1))) []))

;; ---------------- 取值规则 ----------------
(defn extract (d)
  ;; 第一行为表头；标签列给出分类名，所选数值列各成一个系列
  (var vals d.values) (var cols (range-cols))
  (var li (index-of cols LABEL-COL))
  (var series [])
  (each (s SERIES)
    (var si (index-of cols s))
    (when (>= si 0)
      (var head (nth (first vals) si))
      (var pts [])
      (each-i (r row vals) (when (> r 0) (var v (nth row si)) (push! pts (if (num? v) v (or (to-num (to-str v)) 0)))))
      (push! series {:name (if (and (str? head) (!= head "")) head (str "列 " s)) :col s :values pts})))
  (var labels [])
  (each-i (r row vals) (when (> r 0) (push! labels (if (>= li 0) (to-str (nth row li)) (str r)))))
  {:labels labels :series series :title (or d.title "")})

(defn smooth (x) (* x x (- 3 (* 2 x))))
(defn trans-k () (smooth (clamp (/ (- (sys "now") T0) TRANS) 0 1)))
(defn lerp-at (si s i k)
  (var from (if (and PREV (< si (len PREV)) (< i (len (nth PREV si)))) (nth (nth PREV si) i) 0))
  (+ from (* k (- (nth s.values i) from))))
(defn current-values ()
  ;; 过渡中的插值结果（作为下一次过渡的起点）
  (if (nil? SHOWN) nil
    (do (var k (trans-k)) (var out [])
        (each-i (si s SHOWN.series) (push! out (map-list (fn (i) (lerp-at si s i k)) (range (len s.values)))))
        out)))

(defn processed! (d)
  ;; 处理一次数据版本：取值、计算并开始过渡
  (set! PREV (current-values))
  (set! SHOWN (extract d))
  (set! T0 (sys "now"))
  (inc! PROCESSED)
  (set! APP-TIMEOUT (/ 1 30))
  (dirty!))

;; ---------------- 消息 ----------------
(defn pick-source (s) (set! SRC s.doc) (set! SRC-TITLE s.title))
(defn on-msg (m)
  (case m.k
    ("data" (set! DATA m.data) (set! VERSION m.data.version) (set! SRC-TITLE (or m.data.title SRC-TITLE)) (processed! m.data))
    ("conn" (set! CONN m.state) (set! RECEIVED m.received) (when (> m.version VERSION) (set! VERSION m.version)) (dirty!))
    ("sources" (set! SOURCES m.sources)
               (when (and (nil? SRC) (> (len SOURCES) 0)) (pick-source (first SOURCES)))
               (dirty!))
    (else nil)))

;; ---------------- 输入 ----------------
(defn do-connect ()
  (if SRC
    (do (send RECV {:k "connect" :doc SRC :range (upper (trim RANGE))}) (set! CONN "连接中") (set! NOTE ""))
    (set! NOTE "请先选择数据源（根系统中已打开的工作簿）"))
  (dirty!))

(defn on-input (ev view)
  (set! UI-HITS (if (= view "proj") HITS-PROJ HITS-MAIN))
  (var id (ui-hit ev.x ev.y))
  (case ev.type
    ("down"
     (cond
       (MENU (when (and id (starts-with? id "src:"))
               (var s (find (fn (x) (= x.doc (substr id 4))) SOURCES)) (when s (pick-source s)))
             (when (and id (starts-with? id "target:")) (sys "project" APP-WID (substr id 7) 680 440) (set! NOTE (str "已请求投送到 " (substr id 7))))
             (set! MENU nil) (dirty!))
       ((nil? id) (when SEL (set! SEL nil) (dirty!)))
       ((= id "source") (send RECV {:k "sources"}) (set! MENU {:kind "src"}) (dirty!))
       ((starts-with? id "label:") (set! LABEL-COL (substr id 6)) (remove-item! SERIES LABEL-COL) (when (= (len SERIES) 0) (push! SERIES (last (range-cols)))) (when DATA (processed! DATA)) (dirty!))
       ((starts-with? id "series:") (var c (substr id 7))
                                    (if (contains? SERIES c) (when (> (len SERIES) 1) (remove-item! SERIES c)) (push! SERIES c))
                                    (when DATA (processed! DATA)) (dirty!))
       ((= id "connect") (do-connect))
       ((= id "disconnect") (send RECV {:k "disconnect"}) (dirty!))
       ((= id "type") (set! TYPE (if (= TYPE "bar") "line" "bar")) (dirty!))
       ((= id "project") (set! MENU {:kind "project"}) (dirty!))
       ((starts-with? id "pt:") (set! SEL (if (= SEL (substr id 3)) nil (substr id 3))) (dirty!))
       (else nil)))
    ("move" (var h (if (and id (starts-with? id "pt:")) (substr id 3) nil)) (when (!= h HOVER) (set! HOVER h) (dirty!)))
    ("leave" (set! HOVER nil) (dirty!))
    (else nil))
  (set! UI-HITS HITS-MAIN))

(defn on-text (ev view) (when (= ev.field "range") (set! RANGE (apply-text-edit RANGE ev)) (dirty!)))
(defn on-key (ev view)
  (cond ((and (= ev.field "range") (= ev.key "Enter")) (do-connect))
        ((= ev.key "Escape") (set! MENU nil) (dirty!))
        ((and (not ev.inField) (= (lower ev.key) "t")) (set! TYPE (if (= TYPE "bar") "line" "bar")) (dirty!))
        (else nil)))

;; ---------------- 绘图规则 ----------------
(defn nice-max (v)
  (var m (max v 1)) (var p 1)
  (while (<= (* p 10) m) (set! p (* p 10)))
  (var f (/ m p))
  (* p (cond ((<= f 1) 1) ((<= f 2) 2) ((<= f 5) 5) (else 10))))
(defn fmt-num (v) (if (= v (floor v)) (to-str v) (fmt v 2)))

(defn draw-chart (x y w h)
  (when (nil? SHOWN)
    (return [(text x (+ y (/ h 2) -20) w 40 (if (= CONN "已连接") "等待数据…" "选择数据源与区域后点“连接”") {:size 13 :color C-DIM :align "center"})]))
  (var kids [])
  (var k (trans-k))
  (var ser SHOWN.series) (var labels SHOWN.labels)
  (var vals [])
  (each-i (si s ser) (push! vals (map-list (fn (i) (lerp-at si s i k)) (range (len s.values)))))
  (var mx 0) (each (s ser) (each (v s.values) (set! mx (max mx v))))
  (each (vs vals) (each (v vs) (set! mx (max mx v))))
  (var top (nice-max mx))
  (var px (+ x 60)) (var py (+ y 34)) (var pw (- w 82)) (var ph (- h 86))
  (var svg [])
  ;; 网格与坐标轴
  (for (i 0 6)
    (var gy (+ py (* ph (- 1 (/ i 5)))))
    (push! svg {:e "line" :x1 px :y1 gy :x2 (+ px pw) :y2 gy :stroke (if (= i 0) "#ffffff66" "#ffffff14") :sw 1})
    (push! svg {:e "text" :x (- px 8) :y (+ gy 4) :text (fmt-num (* top (/ i 5))) :size 11 :fill C-DIM :anchor "end"}))
  (push! svg {:e "line" :x1 px :y1 py :x2 px :y2 (+ py ph) :stroke "#ffffff66" :sw 1})
  (var n (len labels)) (var gw (/ pw (max 1 n)))
  (each-i (i lb labels)
    (push! svg {:e "text" :x (+ px (* gw (+ i 0.5))) :y (+ py ph 18) :text lb :size 12 :fill C-TEXT :anchor "middle"}))
  (push! svg {:e "text" :x (+ px (/ pw 2)) :y (+ py ph 40) :text (str "分类（列 " LABEL-COL "）") :size 10.5 :fill C-FAINT :anchor "middle"})
  (push! svg {:e "text" :x (- px 44) :y (+ py (/ ph 2)) :text "数值" :size 10.5 :fill C-FAINT :anchor "middle" :rot -90})
  (var ns (len ser))
  (each-i (si s ser)
    (var color (nth PAL (% si (len PAL))))
    (var vs (nth vals si))
    (if (= TYPE "bar")
      (do (var bw (/ (* gw 0.7) (max 1 ns)))
          (each-i (i v vs)
            (var bx (+ px (* gw i) (* gw 0.15) (* bw si))) (var bh (* ph (/ v top)))
            (var id (str si "," i)) (var hot (or (= HOVER id) (= SEL id)))
            (push! svg {:e "rect" :x bx :y (- (+ py ph) bh) :w (- bw 3) :h bh :r 3 :fill color :op (if hot 1 0.82) :stroke (if hot "#ffffff" nil) :sw 1.5})
            (push! svg {:e "text" :x (+ bx (/ bw 2) -1) :y (- (+ py ph) bh 6) :text (fmt-num (nth s.values i)) :size 11.5 :fill (if hot "#ffffff" C-TEXT) :anchor "middle" :weight (if hot 700 400)})
            (hit! (str "pt:" id) bx (- (+ py ph) bh) bw (max bh 8))))
      (do (var pts [])
          (each-i (i v vs) (push! pts (str (+ px (* gw (+ i 0.5))) "," (- (+ py ph) (* ph (/ v top))))))
          (push! svg {:e "poly" :pts pts :stroke color :sw 2.5})
          (each-i (i v vs)
            (var cx (+ px (* gw (+ i 0.5)))) (var cy (- (+ py ph) (* ph (/ v top))))
            (var id (str si "," i)) (var hot (or (= HOVER id) (= SEL id)))
            (push! svg {:e "circle" :cx cx :cy cy :r (if hot 6.5 4.5) :fill color :stroke "#0b1020" :sw 2})
            (push! svg {:e "text" :x cx :y (- cy 11) :text (fmt-num (nth s.values i)) :size 11.5 :fill (if hot "#ffffff" C-TEXT) :anchor "middle" :weight (if hot 700 400)})
            (hit! (str "pt:" id) (- cx 11) (- cy 11) 22 22)))))
  ;; 图例
  (each-i (si s ser)
    (var lx (+ px (* si 150)))
    (push! svg {:e "rect" :x lx :y (- py 26) :w 12 :h 12 :r 3 :fill (nth PAL (% si (len PAL)))})
    (push! svg {:e "text" :x (+ lx 18) :y (- py 16) :text (str s.name "（列 " s.col "）") :size 11.5 :fill C-TEXT}))
  (push! kids {:t "svg" :x 0 :y 0 :w (+ x w) :h (+ y h) :vb [(+ x w) (+ y h)] :kids svg :tid "chart-canvas" :label "图表" :k "svg"})
  ;; 悬停/选中提示
  (var hp (or HOVER SEL))
  (when hp
    (var ij (split hp ",")) (var si (to-num (first ij))) (var i (to-num (nth ij 1)))
    (when (and (< si (len ser)) (< i (len labels)))
      (var s (nth ser si))
      (push! kids (group (+ px 10) (+ py 6) 220 44 [(box 0 0 220 44 {:fill "#0b1020ee" :r 8 :stroke (nth PAL (% si (len PAL)))})
                                                   (text 10 4 200 18 (str (nth labels i) " · " s.name) {:size 11.5 :weight 600 :color C-TEXT})
                                                   (text 10 22 200 18 (str "值 " (fmt-num (nth s.values i)) (if (= SEL hp) "（已选中）" "")) {:size 11 :color C-DIM})]
                         {:tid "chart-tooltip" :k "tip"}))))
  kids)

;; ---------------- 界面 ----------------
(defn draw (W H which)
  (ui-begin)
  (var nodes [(box 0 0 W H {:fill C-BG})])
  (var y 8) (var x 10)
  (push! nodes (label x y 50 28 "数据源" {}))
  (push! nodes (button "source" (+ x 50) y 170 28 (if SRC SRC-TITLE "选择工作簿…") {:tid "chart-source" :icon "sheet" :attrs {"value" (or SRC "")} :label (str "数据源 " SRC-TITLE)}))
  (inc! x 228)
  (push! nodes (label x y 34 28 "区域" {}))
  (push! nodes (field "range" (+ x 34) y 84 28 RANGE {:tid "chart-range" :label "区域" :mono true}))
  (inc! x 126)
  (push! nodes (button "connect" x y 64 28 "连接" {:primary (not (= CONN "已连接")) :icon "link" :tid "chart-connect"}))
  (push! nodes (button "disconnect" (+ x 68) y 64 28 "断开" {:icon "unlink" :tid "chart-disconnect" :disabled (not (contains? ["已连接" "连接中"] CONN))}))
  (inc! x 140)
  (push! nodes (button "type" x y 86 28 (if (= TYPE "bar") "柱状图" "折线图") {:icon (if (= TYPE "bar") "bar" "line") :tid "chart-type" :attrs {"value" TYPE} :label "切换图表类型"}))
  (inc! x 92)
  (when (= which "main") (push! nodes (button "project" x y 64 28 "投送" {:icon "projection" :tid "window-project" :label "投送到祖先桌面"})))
  ;; 第二行：标签列与数值列
  (set! y 42) (set! x 10)
  (var cols (range-cols))
  (push! nodes (label x y 50 24 "标签列" {}))
  (inc! x 50)
  (each (c cols) (push! nodes (button (str "label:" c) x y 26 24 c {:active (= LABEL-COL c) :tid "chart-label-column" :attrs {"value" c} :label (str "标签列 " c)})) (inc! x 28))
  (inc! x 14)
  (push! nodes (label x y 50 24 "数值列" {}))
  (inc! x 50)
  (each (c cols) (when (!= c LABEL-COL) (push! nodes (button (str "series:" c) x y 26 24 c {:active (contains? SERIES c) :tid "chart-series" :attrs {"value" c "selected" (contains? SERIES c)} :label (str "数值列 " c)})) (inc! x 28)))
  (var cc (case CONN ("已连接" C-OK) ("连接中" "#93c5fd") ("未连接" C-DIM) ("已断开" C-DIM) ("已恢复，待重新连接" C-WARN) (else C-DANGER)))
  (push! nodes (chip (+ x 14) (+ y 3) CONN cc))
  (push! nodes (text (+ x 14) (+ y 3) (- W x 30) 18 (str "版本 " VERSION "  ·  已处理 " PROCESSED) {:size 11 :color C-DIM :align "right" :tid "chart-status"
                                                                                                   :attrs {"connection" CONN "version" VERSION}}))
  (push! nodes (hline 0 74 W))
  ;; 图表
  (push! nodes (text 12 80 (- W 24) 22 (str (if SHOWN SHOWN.title SRC-TITLE) "  " (upper RANGE) (if (= TYPE "bar") " · 分组柱状图" " · 折线图")) {:size 13 :weight 700 :color C-TEXT :tid "chart-title"}))
  (each (n (draw-chart 0 100 W (- H 104))) (push! nodes n))
  (when (!= NOTE "") (push! nodes (text 12 (- H 20) (- W 24) 18 NOTE {:size 10.5 :color C-WARN})))
  (when (and MENU (= which "main")) (push! nodes (draw-menu W H)))
  nodes)

(defn draw-menu (W H)
  (var items [])
  (if (= MENU.kind "project")
    (each (a (ancestors-list)) (push! items [(str "target:" a) (str "投送到 " a (if (= a "outer") "（根桌面）" "")) {:tid "project-target" :attrs {"target-system-id" a}}]))
    (if (= (len SOURCES) 0)
      (push! items ["none" "没有已打开的工作簿（请先在根系统电子表格中打开）" {}])
      (each (s SOURCES) (push! items [(str "src:" s.doc) (str s.title (if s.path (str "  " s.path) "")) {:tid "chart-source-item" :attrs {"value" s.doc} :label s.title}]))))
  (var mw 360) (var mh (+ 38 (* 30 (len items)))) (var x 60) (var y 40)
  (var kids [(box 0 0 mw mh {:fill "#121a2ef8" :r 10 :stroke (str ACCENT "66") :shadow 3})
             (text 12 8 (- mw 24) 22 (if (= MENU.kind "project") "选择目标桌面（祖先系统）" "选择已打开的工作簿") {:size 12 :weight 700 :color C-TEXT})])
  (each-i (i it items)
    (hit! (nth it 0) (+ x 6) (+ y 34 (* i 30)) (- mw 12) 28)
    (push! kids (group 6 (+ 34 (* i 30)) (- mw 12) 28 [(box 0 0 (- mw 12) 28 {:fill (if (= UI-HOVER (nth it 0)) (str ACCENT "38") "#ffffff08") :r 6})
                                                     (text 10 0 (- mw 30) 28 (nth it 1) {:size 11.5 :color C-TEXT :valign "middle"})]
                       (nth it 2))))
  (group x y mw mh kids {:k "menu" :tid (if (= MENU.kind "project") "project-menu" "chart-source-menu")}))

(defn meta ()
  {:kind "charts" :sourceTitle SRC-TITLE :source SRC :range (upper RANGE) :chartType TYPE :connectionState CONN :version VERSION
   :labelColumn LABEL-COL :series SERIES :processed PROCESSED :projected (not (nil? PROJ))})

(defn render ()
  (when PROJ
    (var pn (draw PROJ.w PROJ.h "proj"))
    (set! HITS-PROJ UI-HITS)
    (sys "display" (str APP-WID "@proj") {:w PROJ.w :h PROJ.h :nodes pn :bg C-BG} (meta)))
  (var nodes (draw APP-W APP-H "main"))
  (set! HITS-MAIN UI-HITS)
  (app-display nodes (meta))
  (when (>= (trans-k) 1) (set! APP-TIMEOUT nil)))

(app-open {:app "charts" :title "图表工作台" :w 720 :h 460 :icon "charts"})
(set! RECV (sys "spawn" "/Apps/charts/recv.nest" {:ui (sys "self")}))
(send RECV {:k "sources"})
(app-run {:render render :input on-input :key on-key :text on-text :msg on-msg
          :tick (fn () (dirty!))
          :restored (fn (mode) (dirty!))})
