;; =====================================================================
;; 三维场景播放器（界面进程）
;; 协作进程：时序 timeline、飞行场景 scene、环境特效 fx（排演时另有飞控程序）。
;; 本进程负责窗口、控件、命中判断与投送视图；三维画面由 scene/fx 进程经显示接口提交。
;; 场景资源格式见操作说明“场景资源格式”；同一播放器可打开任何合法的 .scene / .rec 文件。
;; =====================================================================
(include "/System/lib/core.nest")
(include "/System/lib/ui.nest")
(include "/System/lib/app.nest")

(var INFO (ui-init))
(var SYSID INFO.id)
(var PATH (or (get ARGS "path") "/Demo/helicopter-24.scene"))
(var TL nil) (var SCENE nil) (var FX nil)
(var POS 0) (var DUR 15) (var RATE 1) (var PLAYING false) (var LOOP false) (var ENDED false)
(var NAME "") (var KIND "record") (var CAN-REH false) (var ST {}) (var PICKED nil) (var ERR nil) (var NOTE "")
(var CAMMODE "show") (var REH false) (var FC "/Programs/flight/autopilot.nest") (var FCS [])
(var EDITS {"wind" "4,90" "heading" "45" "fault" "1.5" "save" "/Records/排演-1.rec" "seek" ""})
(var PRESS nil) (var SEEKING nil) (var MENU nil) (var LAST-RENDER -1) (var HITS-MAIN []) (var HITS-PROJ [])
(var PANEL true)
(def BAR-H 66) (def SIDE-W 248)
(def CAM-NAMES {"show" "演出镜头" "follow" "跟随镜头" "orbit" "自由环绕"})

(defn view-sid (v) (if (= v "proj") (str APP-WID "@proj#view") (str APP-WID "#view")))
(defn views () (if PROJ [(view-sid "main") (view-sid "proj")] [(view-sid "main")]))

(defn start-procs ()
  (var me (sys "self"))
  (set! FX (sys "spawn" "/Apps/player/fx.nest" {:ui me}))
  (set! SCENE (sys "spawn" "/Apps/player/scene.nest" {:ui me :fx FX :view (view-sid "main") :path PATH}))
  (set! TL (sys "spawn" "/Apps/player/timeline.nest" {:ui me :scene SCENE})))

(defn tl! (m) (send TL m) (dirty!))
(defn sc! (m) (send SCENE m))

(defn state-name ()
  (cond (PLAYING "playing") (ENDED "ended") ((<= POS 0) "stopped") (else "paused")))
(defn state-text ()
  (case (state-name) ("playing" "播放中") ("ended" "已到结尾") ("stopped" "已停止") (else "已暂停")))

(defn list-fcs ()
  (set! FCS (try (map-list (fn (e) e.path) (filter (fn (e) (ends-with? e.name ".nest")) (sys "list" "/Programs/flight"))) (catch e [FC]))))

;; ---------------- 消息 ----------------
(defn on-msg (m)
  (case m.k
    ("tl" (var ch (or (!= PLAYING m.playing) (!= ENDED m.ended) (!= RATE m.rate)))
          (set! POS m.pos) (set! PLAYING m.playing) (set! RATE m.rate) (set! LOOP m.loop) (set! DUR m.dur) (set! ENDED m.ended)
          (when (or ch (not PLAYING) (> (abs (- POS LAST-RENDER)) 0.09) (< POS LAST-RENDER)) (dirty!)))
    ("loaded" (set! NAME m.name) (set! KIND m.kind) (set! CAN-REH m.rehearsal) (set! ERR nil) (set! PATH m.path)
              (send TL {:k "dur" :dur m.duration}) (send TL {:k "reset" :t 0}) (set! PICKED nil)
              (sys "win-title" APP-WID (str "三维播放器 — " (basename m.path))) (dirty!))
    ("scene-error" (set! ERR m.error) (dirty!))
    ("status" (set! ST m) (dirty!))
    ("picked" (set! PICKED m) (dirty!))
    ("rehearsal" (set! REH m.on) (when (has? m "duration") (send TL {:k "dur" :dur m.duration}))
                 (when m.on (send TL {:k "play"}) (set! NOTE (str "排演开始：飞控 " (basename m.fc))))
                 (when (not m.on) (set! NOTE "排演已结束，可跳转回放"))
                 (dirty!))
    ("input-ack" (set! NOTE (str "已输入 " (case m.kind ("wind" "风") ("heading" "目标航向") ("target" "目标点") ("fault" "故障") (else m.kind)) "（t=" (fmt m.t 2) "）")) (dirty!))
    ("saved" (set! NOTE (if m.error (str "保存失败：" m.error) (str "记录已保存：" m.path))) (when (not m.error) (sys "notify" "排演记录已保存" m.path)) (dirty!))
    ("file-pick" nil)
    (else nil)))

;; ---------------- 输入 ----------------
(defn layout (W H)
  (var side (if (and PANEL CAN-REH (> W 640)) SIDE-W 0))
  {:vx 0 :vy 0 :vw (- W side) :vh (- H BAR-H) :side side :W W :H H})

(defn on-input (ev view)
  (var L (if (= view "proj") (layout PROJ.w PROJ.h) (layout APP-W APP-H)))
  (set! UI-HITS (if (= view "proj") HITS-PROJ HITS-MAIN))
  (case ev.type
    ("down"
     (var id (ui-hit ev.x ev.y))
     (cond
       (MENU (when (and id (starts-with? id "target:")) (sys "project" APP-WID (substr id 7) 720 470) (set! NOTE (str "已请求投送到 " (substr id 7))))
             (set! MENU nil) (dirty!))
       ((= id "seek") (set! SEEKING {:view view}) (seek-at ev L))
       ((= id "view") (set! PRESS {:x ev.x :y ev.y :moved false :view view :L L}))
       (id (on-button id))
       (else nil)))
    ("move"
     (cond (SEEKING (seek-at ev L))
           (PRESS (var dx (- ev.x PRESS.x)) (var dy (- ev.y PRESS.y))
                  (when (or PRESS.moved (> (+ (abs dx) (abs dy)) 4))
                    (put! PRESS "moved" true)
                    (sc! {:k "cam" :dyaw (* 0.35 dx) :dpitch (* 0.25 dy)})
                    (set! CAMMODE "orbit")
                    (put! PRESS "x" ev.x) (put! PRESS "y" ev.y)))
           (else nil)))
    ("up"
     (when (and PRESS (not PRESS.moved))
       (sc! {:k "pick" :x (- ev.x L.vx) :y (- ev.y L.vy) :w L.vw :h L.vh}))
     (when (or PRESS SEEKING) (dirty!))
     (set! PRESS nil) (set! SEEKING nil))
    ("wheel" (when (= (ui-hit ev.x ev.y) "view") (sc! {:k "cam" :zoom (if (> ev.dy 0) 1.12 0.89)}) (set! CAMMODE "orbit") (dirty!)))
    (else nil))
  (set! UI-HITS HITS-MAIN))

(defn seek-at (ev L)
  (var x0 14) (var w (- L.W 28))
  (var f (clamp (/ (- ev.x x0) w) 0 1))
  (send TL {:k "seek" :t (* f DUR)})
  (set! POS (* f DUR)) (dirty!))

(defn on-button (id)
  (var parts (split id ":")) (var a (first parts)) (var x (nth parts 1))
  (case a
    ("play" (tl! {:k "play"}))
    ("pause" (tl! {:k "pause"}))
    ("stop" (tl! {:k "stop"}))
    ("step" (tl! {:k "step"}))
    ("replay" (tl! {:k "replay"}))
    ("loop" (tl! {:k "loop" :on (not LOOP)}) (set! LOOP (not LOOP)))
    ("rate" (tl! {:k "rate" :rate (to-num x)}) (set! RATE (to-num x)))
    ("cam" (set! CAMMODE (case CAMMODE ("show" "follow") ("follow" "orbit") (else "show"))) (sc! {:k "cam" :mode CAMMODE}) (dirty!))
    ("open" (set! MENU {:kind "open" :files (open-candidates)}) (dirty!))
    ("openfile" (sc! {:k "open" :path (substr id 9)}) (set! MENU nil) (set! REH false) (dirty!))
    ("project" (set! MENU {:kind "project"}) (dirty!))
    ("unproject" (sys "unproject" APP-WID) (set! PROJ nil) (sc! {:k "views" :views (views)}) (dirty!))
    ("panel" (set! PANEL (not PANEL)) (dirty!))
    ("reh-start" (sc! {:k "rehearse" :from-start true :fc FC}) (set! NOTE "正在从头开始排演…"))
    ("reh-cont" (sc! {:k "rehearse" :from-start false :fc FC}) (set! NOTE (str "从 " (fmt POS 2) " 秒处续演…")))
    ("reh-stop" (sc! {:k "stop-rehearsal"}))
    ("fc" (list-fcs) (var i (index-of FCS FC)) (set! FC (nth FCS (% (+ i 1) (max 1 (len FCS))))) (when (nil? FC) (set! FC "/Programs/flight/autopilot.nest")) (dirty!))
    ("fcedit" (sys "spawn" "/Apps/editor.nest" {:path FC} {:kind "app" :detached true}))
    ("wind" (var w (map-list (fn (s) (or (to-num (trim s)) 0)) (split (get EDITS "wind") ",")))
            (var sp (nth w 0)) (var dir (* (or (nth w 1) 0) 0.01745329))
            (sc! {:k "input" :kind "wind" :v [(* sp (cos dir)) (* sp (- (sin dir)))]}))
    ("heading" (sc! {:k "input" :kind "heading" :v (* (or (to-num (get EDITS "heading")) 0) 0.01745329)}))
    ("fault" (sc! {:k "input" :kind "fault" :v (or (to-num (get EDITS "fault")) 1)}))
    ("mission" (sc! {:k "input" :kind "target" :v [150 -64]}))
    ("save" (sc! {:k "save" :path (get EDITS "save")}))
    ("seekgo" (var t (to-num (get EDITS "seek"))) (when t (tl! {:k "seek" :t t})))
    (else nil)))

(defn open-candidates ()
  (var out [])
  (each (d ["/Demo" "/Records" "/Documents" "/Downloads" "/Desktop"])
    (try (each (e (sys "list" d)) (when (or (ends-with? e.name ".scene") (ends-with? e.name ".rec")) (push! out e.path))) (catch e nil)))
  out)

(defn on-key (ev view)
  (cond
    (ev.inField (when (= ev.key "Enter")
                  (case ev.field ("wind" (on-button "wind")) ("heading" (on-button "heading")) ("fault" (on-button "fault")) ("save" (on-button "save")) ("seek" (on-button "seekgo")) (else nil))))
    ((= ev.key " ") (tl! {:k "toggle"}))
    ((= ev.key "ArrowRight") (tl! {:k "step"}))
    ((= ev.key "ArrowLeft") (tl! {:k "step-back"}))
    ((= ev.key "Home") (tl! {:k "stop"}))
    ((= (lower ev.key) "l") (on-button "loop"))
    ((= (lower ev.key) "c") (on-button "cam"))
    ((= ev.key "Escape") (set! MENU nil) (dirty!))
    (else nil)))

(defn on-text (ev view) (put! EDITS ev.field (apply-text-edit (get-or EDITS ev.field "") ev)))

;; ---------------- 绘制 ----------------
(defn ctl-btn (id x y w label ic tid o)
  (button id x y w 30 label (merge {:icon ic :tid tid :label (or (get o "label") label)} (or o {}))))

(defn draw (W H which)
  (ui-begin)
  (var L (layout W H))
  (var nodes [(box 0 0 W H {:fill "#06080f"})])
  ;; 三维视图
  (hit! "view" L.vx L.vy L.vw L.vh)
  (push! nodes {:t "view3d" :x L.vx :y L.vy :w L.vw :h L.vh :scene (view-sid which) :tid "player-view" :label "三维视图" :k (str "v-" which) :cursor "grab"})
  ;; 顶部信息条
  (push! nodes (box 0 0 L.vw 30 {:grad ["#000000aa" "#00000000" 180]}))
  (push! nodes (text 12 6 (- L.vw 200) 20 (str NAME (if (= KIND "keys") "（关键帧）" "")) {:size 12 :weight 600 :color "#f1f4fb" :shadow true}))
  (push! nodes (text (- L.vw 290) 6 90 20 "60 帧/秒" {:size 10 :color "#cbd5e1" :align "right" :shadow true}))
  (push! nodes (chip (- L.vw 190) 7 (if REH "排演中" (if (ends-with? PATH ".rec") "记录回放" (if (= KIND "keys") "关键帧" "默认演出"))) (if REH "#f87171" ACCENT)))
  (push! nodes (chip (- L.vw 110) 7 (get-or CAM-NAMES CAMMODE CAMMODE) "#93c5fd"))
  (when ERR (push! nodes (group 20 40 (- L.vw 40) 60 [(box 0 0 (- L.vw 40) 60 {:fill "#3b0d14e8" :r 8 :stroke "#f8717199"})
                                                     (text 14 8 (- L.vw 70) 44 (str "场景错误：" ERR) {:size 12 :color "#fecaca" :wrap true})] {:tid "player-error"})))
  (when (get ST "crashed")
    (var im (get ST "impact"))
    (push! nodes (text 12 34 400 18 (str "撞击 t=" (fmt (get im "t") 2) "s · " (get im "why") " · " (fmt (get im "speed") 1) " m/s") {:size 11 :color "#fca5a5" :shadow true})))
  (when (get ST "landed") (push! nodes (text 12 34 400 18 (str "已降落在停机坪 " (get ST "landed")) {:size 11 :color "#86efac" :shadow true})))
  ;; 点选结果
  (when PICKED
    (push! nodes (group 12 (- L.vh 58) 300 46 [(box 0 0 300 46 {:fill "#0b1020d8" :r 8 :stroke (str ACCENT "66")})
                                                (text 10 4 280 20 (str "部件：" PICKED.label) {:size 12 :weight 600 :color C-TEXT})
                                                (text 10 24 280 18 (str "状态：" PICKED.state) {:size 11 :color C-DIM})]
                       {:tid "player-selection" :label (str PICKED.label " " PICKED.state)})))
  ;; 控制栏
  (var by (- H BAR-H))
  (push! nodes (box 0 by W BAR-H {:fill "#0d1324f4"}))
  (push! nodes (hline 0 by W))
  (var sx 14) (var sw (- W 28)) (var frac (if (> DUR 0) (clamp (/ POS DUR) 0 1) 0))
  (hit! "seek" (- sx 4) (+ by 4) (+ sw 8) 20)
  (push! nodes (group sx (+ by 8) sw 12 [(box 0 3 sw 6 {:fill "#ffffff1f" :r 3})
                                         (box 0 3 (* sw frac) 6 {:fill ACCENT :r 3})
                                         (box (- (* sw frac) 6) 0 12 12 {:fill "#ffffff" :r 6 :shadow 1})]
                     {:tid "player-seek" :label "进度条" :attrs {"value" (fmt POS 3) "max" (fmt DUR 3)} :cursor "pointer" :role "slider"}))
  (var y (+ by 30)) (var x 10)
  (if PLAYING
    (push! nodes (ctl-btn "pause" x y 34 "" "pause" "player-pause" {:label "暂停"}))
    (push! nodes (ctl-btn "play" x y 34 "" "play" "player-play" {:label (if (> POS 0) "继续" "播放") :primary true})))
  (inc! x 38)
  (push! nodes (ctl-btn "stop" x y 34 "" "stop" "player-stop" {:label "停止并回到开头"})) (inc! x 38)
  (push! nodes (ctl-btn "step" x y 34 "" "step" "player-step" {:label "逐帧前进（1/60 秒）"})) (inc! x 38)
  (push! nodes (ctl-btn "replay" x y 34 "" "restart" "player-replay" {:label "重播"})) (inc! x 38)
  (push! nodes (ctl-btn "loop" x y 34 "" "loop" "player-loop" {:label (if LOOP "循环：开" "循环：关") :active LOOP})) (inc! x 42)
  (push! nodes (text x y 150 30 (str (fmt-time POS) " / " (fmt-time DUR)) {:size 12 :font "mono" :color C-TEXT :valign "middle" :tid "player-time"
                                                                             :label (str (fmt POS 2) " / " (fmt DUR 2) " 秒")
                                                                             :attrs {"position" (fmt POS 3) "duration" (fmt DUR 3) "state" (state-name)}}))
  (inc! x 150)
  (push! nodes (text x y 56 30 (state-text) {:size 11 :color C-DIM :valign "middle"}))
  (inc! x 56)
  (when (> W 560)
    (each (r [0.25 0.5 1 2])
      (push! nodes (button (str "rate:" r) x (+ y 3) 38 24 (str r "×") {:active (= RATE r) :tid "player-rate" :attrs {"value" r} :label (str "速率 " r "×")}))
      (inc! x 40)))
  (inc! x 4)
  (push! nodes (ctl-btn "cam" x y 34 "" "camera" "player-camera" {:label (str "切换镜头（当前：" (get-or CAM-NAMES CAMMODE CAMMODE) "）")})) (inc! x 38)
  (when (= which "main")
    (push! nodes (ctl-btn "open" x y 34 "" "open" "player-open" {:label "打开场景或记录"})) (inc! x 38)
    (push! nodes (ctl-btn "project" x y 34 "" "projection" "window-project" {:label "投送到祖先桌面"})) (inc! x 38)
    (when PROJ (push! nodes (ctl-btn "unproject" x y 34 "" "close" "window-unproject" {:label "取消投送"})) (inc! x 38))
    (when CAN-REH (push! nodes (ctl-btn "panel" x y 34 "" "flag" "player-panel" {:label "排演面板" :active PANEL}))))
  ;; 排演面板
  (when (> L.side 0) (each (n (draw-panel L)) (push! nodes n)))
  (when (and MENU (= which "main")) (push! nodes (draw-menu L)))
  nodes)

(defn draw-panel (L)
  (var x (- L.W L.side)) (var w L.side) (var out [])
  (ui-offset x 0)
  (var kids [(box 0 0 w L.vh {:fill "#0b1020f2"}) (vline 0 0 L.vh)
             (text 14 10 (- w 28) 20 "飞行排演" {:size 14 :weight 700 :color C-TEXT})
             (text 14 32 (- w 28) 34 "直升机靠飞控进程保持飞行；预算、调度与时间速率影响控制周期。" {:size 10.5 :color C-DIM :wrap true})])
  (var y 66)
  (push! kids (button "reh-start" 14 y (- w 28) 30 "从头开始排演" {:primary (not REH) :icon "run" :tid "rehearsal-start"})) (inc! y 34)
  (push! kids (button "reh-cont" 14 y (/ (- w 32) 2) 28 "从此处续演" {:tid "rehearsal-continue"}))
  (push! kids (button "reh-stop" (+ 18 (/ (- w 32) 2)) y (/ (- w 32) 2) 28 "结束排演" {:tid "rehearsal-stop" :disabled (not REH)})) (inc! y 36)
  (push! kids (label 14 y 60 26 "飞控程序" {}))
  (push! kids (button "fc" 74 y (- w 122) 26 (basename FC) {:tid "rehearsal-controller" :label (str "飞控程序 " FC) :attrs {"value" FC}}))
  (push! kids (button "fcedit" (- w 44) y 30 26 "" {:icon "editor" :tid "rehearsal-controller-edit" :label "编辑飞控程序"})) (inc! y 34)
  (push! kids (label 14 y 70 28 "风 速,方向°" {}))
  (push! kids (field "wind" 84 y (- w 140) 28 (get EDITS "wind") {:tid "rehearsal-wind" :label "风：速度,方向（度）"}))
  (push! kids (button "wind" (- w 50) y 36 28 "设" {:tid "rehearsal-wind-apply"})) (inc! y 34)
  (push! kids (label 14 y 70 28 "目标航向°" {}))
  (push! kids (field "heading" 84 y (- w 140) 28 (get EDITS "heading") {:tid "rehearsal-heading" :label "目标航向（度）"}))
  (push! kids (button "heading" (- w 50) y 36 28 "设" {:tid "rehearsal-heading-apply"})) (inc! y 34)
  (push! kids (label 14 y 70 28 "故障 s后" {}))
  (push! kids (field "fault" 84 y (- w 140) 28 (get EDITS "fault") {:tid "rehearsal-fault-delay" :label "故障触发延迟（秒）"}))
  (push! kids (button "fault" (- w 50) y 36 28 "触发" {:danger true :tid "rehearsal-fault"})) (inc! y 34)
  (push! kids (button "mission" 14 y (- w 28) 26 "任务：飞往停机坪 B 并降落" {:tid "rehearsal-mission"})) (inc! y 32)
  (push! kids (field "save" 14 y (- w 80) 28 (get EDITS "save") {:tid "rehearsal-save-path" :label "保存路径"}))
  (push! kids (button "save" (- w 62) y 48 28 "保存" {:tid "rehearsal-save" :primary REH})) (inc! y 36)
  (push! kids (hline 14 y (- w 28))) (inc! y 8)
  (each (r [["离地高度" (str (get-or ST "alt" "-") " m")] ["水平速度" (str (get-or ST "speed" "-") " m/s")] ["旋翼转速" (get-or ST "rpm" "-")]
            ["尾桨" (if (= (get ST "tail") 0) "失效" (if (get ST "warned") "异常" "正常"))]])
    (push! kids (text 14 y 90 20 (nth r 0) {:size 11 :color C-DIM}))
    (push! kids (text 100 y (- w 114) 20 (nth r 1) {:size 11 :color C-TEXT :align "right" :font "mono"}))
    (inc! y 20))
  (inc! y 6)
  (push! kids (text 14 y (- w 28) 54 NOTE {:size 10.5 :color ACCENT :wrap true :tid "rehearsal-note"}))
  (when (> (- L.vh y) 100) (push! kids (text 14 (- L.vh 36) (- w 28) 32 "提示：排演中点击地面可设为目标点；拖动视图环绕，滚轮缩放。" {:size 10 :color C-FAINT :wrap true})))
  (ui-offset (- x) 0)
  [(group x 0 w L.vh kids {:k "panel" :tid "rehearsal-panel"})])

(defn draw-menu (L)
  (var items [])
  (if (= MENU.kind "project")
    (each (a (ancestors-list)) (push! items [(str "target:" a) (str "投送到 " a (if (= a "outer") "（根桌面）" "")) a]))
    (each (f (take MENU.files 12)) (push! items [(str "openfile:" f) f nil])))
  (var mw 300) (var mh (+ 40 (* 30 (len items)))) (var x (max 10 (- L.W mw 20))) (var y (max 10 (- L.H BAR-H mh 6)))
  (var kids [(box 0 0 mw mh {:fill "#121a2ef8" :r 10 :stroke (str ACCENT "66") :shadow 3})
             (text 12 8 (- mw 24) 22 (if (= MENU.kind "project") "选择目标桌面（祖先系统）" "打开场景或排演记录") {:size 12 :weight 700 :color C-TEXT})])
  (each-i (i it items)
    (hit! (nth it 0) (+ x 6) (+ y 34 (* i 30)) (- mw 12) 28)
    (push! kids (group 6 (+ 34 (* i 30)) (- mw 12) 28 [(box 0 0 (- mw 12) 28 {:fill (if (= UI-HOVER (nth it 0)) (str ACCENT "38") "#ffffff08") :r 6})
                                                     (text 10 0 (- mw 30) 28 (nth it 1) {:size 11.5 :color C-TEXT :valign "middle" :font (if (nth it 2) "ui" "mono")})]
                       (if (nth it 2) {:tid "project-target" :attrs {"target-system-id" (nth it 2)} :label (nth it 1)} {:tid "player-open-item" :attrs {"file-path" (nth it 1)}}))))
  (group x y mw mh kids {:k "menu" :tid (if (= MENU.kind "project") "project-menu" "player-open-menu")}))

(defn meta ()
  {:kind "player" :state (state-name) :position POS :duration DUR :rate RATE :scene PATH :frameTime (get-or ST "t" POS)
   :loop LOOP :mode (if REH "rehearsal" KIND) :camera CAMMODE :projected (not (nil? PROJ))})

(defn render ()
  (set! LAST-RENDER POS)
  (when PROJ
    (var pn (draw PROJ.w PROJ.h "proj"))
    (set! HITS-PROJ UI-HITS)
    (sys "display" (str APP-WID "@proj") {:w PROJ.w :h PROJ.h :nodes pn :bg "#06080f"} (meta)))
  (var nodes (draw APP-W APP-H "main"))
  (set! HITS-MAIN UI-HITS)
  (app-display nodes (meta)))

(app-open {:app "player" :title "三维播放器" :w 760 :h 500 :icon "player"})
(list-fcs)
(start-procs)
(app-run {:render render :input on-input :key on-key :text on-text :msg on-msg
          :proj (fn (on) (sc! {:k "views" :views (views)}) (dirty!))
          :proj-resize (fn () (dirty!))
          :restored (fn (mode) (sc! {:k "views" :views (views)}) (set! NOTE (if (= mode "fork") "已从快照分叉" "已从快照恢复")) (dirty!))})
