;; =====================================================================
;; 子系统文本与程序编辑器
;; 新建、编辑、保存并启动 Nest 程序；可打开直属子系统的内核源文件和本系统的飞控程序；
;; 编辑 /System/compiler.nest 后可“编译编译器”，此后启动的程序使用新编译器。
;; =====================================================================
(include "/System/lib/core.nest")
(include "/System/lib/ui.nest")
(include "/System/lib/app.nest")

(var INFO (ui-init))
(var SYSID INFO.id)
(var PATH nil) (var TEXT "") (var REV 1) (var DIRTY-DOC false) (var READONLY (get ARGS "readonly"))
(var OUT []) (var WATCH []) (var DIALOG nil) (var PICK nil)
(def TOP 44) (def OUT-H 110)

(defn out! (s cls) (push! OUT [s (or cls "")]) (when (> (len OUT) 80) (shift! OUT)) (dirty!))

(defn load (p)
  (var s (sys "read" p))
  (if (nil? s)
    (out! (str "文件不存在：" p) "err")
    (do (set! PATH p) (set! TEXT s) (inc! REV) (set! DIRTY-DOC false)
        (out! (str "已打开 " p "（" (len s) " 字符）") "dim")))
  (title!))

(defn title! () (sys "win-title" APP-WID (str (if DIRTY-DOC "● " "") (if PATH (basename PATH) "未命名") " — 编辑器")) (dirty!))

(defn save (as)
  (if (or (nil? PATH) as)
    (set! DIALOG {:kind "saveas" :value (or PATH "/Documents/新程序.nest")})
    (try (sys "write" PATH TEXT) (set! DIRTY-DOC false) (out! (str "已保存 " PATH) "ok")
         (when (starts-with? PATH "/System/Kernels/") (out! "提示：在本系统桌面的系统窗口或进程管理器中“重启”该子系统即可生效" "dim"))
      (catch e (out! (str "保存失败：" (to-str e)) "err"))))
  (title!))

(defn run-prog ()
  (when DIRTY-DOC (save false))
  (try (var pid (sys "spawn" PATH nil {:detached true}))
       (out! (str "▶ 启动 " PATH "（进程 " pid "）") "ok")
       (push! WATCH {:pid pid :seen 0})
    (catch e (out! (str "启动失败：" (to-str e)) "err"))))

(defn compile-check ()
  (when DIRTY-DOC (save false))
  (out! (str "编译 " PATH " …（由本系统的编译器程序执行）") "dim")
  (var r (sys "compile" PATH))
  (if (get r "ok") (out! "编译成功" "ok") (out! (str "编译错误（第 " (get r "line") " 行）：" (get r "error")) "err")))

(defn install-compiler ()
  (when DIRTY-DOC (save false))
  (out! "用当前编译器编译 /System/compiler.nest …" "dim")
  (var r (sys "install-compiler"))
  (if (get r "ok")
    (out! "新编译器已安装：此后启动的程序都由它编译（旧版本在 /System/bin/compiler.prev.nx）" "ok")
    (out! (str "新编译器编译失败（第 " (get r "line") " 行）：" (get r "error")) "err")))

(defn poll-watch ()
  ;; 显示由本编辑器启动的进程的新输出
  (when (> (len WATCH) 0)
    (var ps (sys "ps"))
    (each (w WATCH)
      (var p (find (fn (x) (= x.pid w.pid)) ps))
      (if (nil? p)
        (put! w "over" true)
        (do (var lines p.out)
            (var start (+ (index-of lines (get-or w "lastline" "")) 1))
            (for (i start (len lines)) (out! (str "[" w.pid "] " (nth lines i)) ""))
            (when (> (len lines) 0) (put! w "lastline" (last lines)))
            (when (or (= p.state "done") (= p.state "error"))
              (out! (if (= p.state "error") (str "进程 " w.pid " 异常：" p.error) (str "进程 " w.pid " 已结束")) (if (= p.state "error") "err" "dim"))
              (put! w "over" true)))))
    (set! WATCH (filter (fn (w) (not w.over)) WATCH))))

(defn open-picker ()
  (var files [])
  (each (d ["/Programs" "/Programs/examples" "/Programs/flight" "/Documents" "/System" "/System/Kernels" "/Apps" "/Records" "/Demo"])
    (try (each (e (sys "list" d)) (when (= e.type "file") (push! files e.path))) (catch e nil)))
  (set! PICK {:files files :scroll 0})
  (dirty!))

(defn kernel-items ()
  (var out [["/System/kernel.nest" "内核模板 kernel.nest"] ["/System/compiler.nest" "编译器 compiler.nest"] ["/System/wm.nest" "窗口管理程序 wm.nest"]
            ["/Programs/flight/autopilot.nest" "飞控程序 autopilot.nest"]])
  (each (c (sys "children")) (push! out [c.kernel (str c.id " 的内核")]))
  out)

;; ---------------- 输入 ----------------
(defn on-input (ev view)
  (when (!= ev.type "down") (return nil))
  (var id (ui-hit ev.x ev.y))
  (when DIALOG
    (cond ((= id "dlg-ok")
           (var p (trim DIALOG.value))
           (set! DIALOG nil)
           (when (!= p "") (set! PATH (if (starts-with? p "/") p (str "/Documents/" p))) (save false)))
          ((= id "dlg-cancel") (set! DIALOG nil))
          ((= id "cf:save") (var k DIALOG.then) (set! DIALOG nil) (save false) (k))
          ((= id "cf:discard") (var k DIALOG.then) (set! DIALOG nil) (set! DIRTY-DOC false) (k))
          ((= id "cf:cancel") (set! DIALOG nil))
          (else nil))
    (dirty!) (return nil))
  (when PICK
    (cond ((and id (starts-with? id "pick:")) (var p (substr id 5)) (set! PICK nil) (guard (fn () (load p))))
          ((= id "pick-close") (set! PICK nil))
          (else nil))
    (dirty!) (return nil))
  (case id
    ("tb:new" (guard (fn () (set! PATH nil) (set! TEXT "") (inc! REV) (set! DIRTY-DOC false) (title!))))
    ("tb:open" (open-picker))
    ("tb:save" (save false))
    ("tb:saveas" (save true))
    ("tb:run" (run-prog))
    ("tb:compile" (compile-check))
    ("tb:install" (install-compiler))
    (else (when (and id (starts-with? id "k:")) (var p (substr id 2)) (guard (fn () (load p)))))))

(defn guard (k)
  (if DIRTY-DOC (set! DIALOG {:kind "confirm" :then k}) (k))
  (dirty!))

(defn on-key (ev view)
  (cond ((and (mods-ctrl? ev) (= (lower ev.key) "s")) (save false))
        ((and DIALOG (= ev.key "Escape")) (set! DIALOG nil) (dirty!))
        ((and DIALOG (= ev.key "Enter") (= DIALOG.kind "saveas")) (var p (trim DIALOG.value)) (set! DIALOG nil) (when (!= p "") (set! PATH (if (starts-with? p "/") p (str "/Documents/" p))) (save false)))
        ((and PICK (= ev.key "Escape")) (set! PICK nil) (dirty!))
        (else nil)))

(defn on-text (ev view)
  (cond ((= ev.field "editor-text")
         (when (not READONLY)
           (set! TEXT (apply-text-edit TEXT ev))
           (when (not DIRTY-DOC) (set! DIRTY-DOC true) (title!))))
        ((and DIALOG (= ev.field "dlg-field")) (put! DIALOG "value" (apply-text-edit DIALOG.value ev)) (dirty!))))

(defn on-close ()
  (if DIRTY-DOC (set! DIALOG {:kind "confirm" :then (fn () (sys "exit" nil))}) (sys "exit" nil))
  (dirty!))

;; ---------------- 绘制 ----------------
(defn render ()
  (ui-begin)
  (var W APP-W) (var H APP-H)
  (var nodes [(box 0 0 W H {:fill C-BG}) (box 0 0 W TOP {:fill "#ffffff06"}) (hline 0 (- TOP 1) W)])
  (var x 8)
  (each (b [["tb:new" "newfile" "新建" "editor-new"] ["tb:open" "open" "打开" "editor-open"] ["tb:save" "save" "保存" "editor-save"] ["tb:saveas" "" "另存为" "editor-save-as"]])
    (var w (if (= (nth b 1) "") 60 (+ 30 (text-w (nth b 2) 12))))
    (push! nodes (button (nth b 0) x 8 w 28 (nth b 2) {:icon (if (= (nth b 1) "") nil (nth b 1)) :tid (nth b 3)}))
    (inc! x (+ w 6)))
  (when (and PATH (ends-with? PATH ".nest"))
    (push! nodes (button "tb:run" x 8 66 28 "运行" {:icon "run" :tid "editor-run"})) (inc! x 72)
    (push! nodes (button "tb:compile" x 8 66 28 "编译" {:icon "kernel" :tid "editor-compile"})) (inc! x 72))
  (when (= PATH "/System/compiler.nest")
    (push! nodes (button "tb:install" x 8 100 28 "编译编译器" {:primary true :tid "editor-install-compiler"})) (inc! x 106))
  (push! nodes (text (+ x 6) 8 (- W x 16) 28 (str (or PATH "未命名") (if DIRTY-DOC " •" "") (if READONLY "（只读）" ""))
                     {:size 12 :color (if DIRTY-DOC C-WARN C-DIM) :valign "middle" :align "right" :tid "editor-filename" :label "文件名"}))
  ;; 第二行：内核与飞控快速打开
  (var kx 8) (var ky (+ TOP 4))
  (push! nodes (label kx ky 64 22 "快速打开" {:size 11}))
  (inc! kx 64)
  (each (k (kernel-items))
    (var w (+ 16 (text-w (nth k 1) 11)))
    (when (< (+ kx w) W)
      (push! nodes (button (str "k:" (nth k 0)) kx ky w 22 (nth k 1) {:tid (if (starts-with? (nth k 0) "/System/Kernels/") "editor-open-kernel" "editor-quick") :attrs {"file-path" (nth k 0)}}))
      (inc! kx (+ w 4))))
  (var ty (+ TOP 30)) (var th (- H ty OUT-H 2))
  (push! nodes (field "editor-text" 6 ty (- W 12) th TEXT {:multi true :mono true :size 13 :rev REV :tid "editor-text" :label "编辑区" :readonly READONLY}))
  ;; 输出
  (var oy (- H OUT-H))
  (push! nodes (box 0 oy W OUT-H {:fill "#00000040"}))
  (push! nodes (hline 0 oy W))
  (var lines (slice OUT (max 0 (- (len OUT) 6))))
  (each-i (i l lines)
    (push! nodes (text 10 (+ oy 6 (* i 17)) (- W 20) 17 (first l) {:size 11.5 :font "mono" :color (case (nth l 1) ("ok" "#86efac") ("err" "#fca5a5") ("dim" C-DIM) (else C-TEXT))})))
  (when PICK (push! nodes (draw-picker)))
  (when DIALOG (push! nodes (draw-dialog)))
  (app-display nodes {:kind "editor" :path PATH :dirty DIRTY-DOC}))

(defn draw-picker ()
  (var pw (min 460 (- APP-W 30))) (var ph (min 360 (- APP-H 30))) (var x (/ (- APP-W pw) 2)) (var y (/ (- APP-H ph) 2))
  (var kids [(box 0 0 pw ph {:fill "#161d33fa" :r 10 :stroke (str ACCENT "77") :shadow 3})
             (text 14 10 300 22 "打开文件" {:size 14 :weight 700 :color C-TEXT})])
  (hit! "pick-close" (+ x pw -40) (+ y 8) 30 26)
  (push! kids (group (- pw 40) 8 30 26 [(icon 7 5 16 "close" {:color C-DIM})] {:tid "dialog-cancel" :label "关闭"}))
  (each-i (i p (slice PICK.files 0 (floor (/ (- ph 50) 24))))
    (var id (str "pick:" p))
    (hit! id (+ x 10) (+ y 40 (* i 24)) (- pw 20) 22)
    (push! kids (group 10 (+ 40 (* i 24)) (- pw 20) 22 [(box 0 0 (- pw 20) 22 {:fill (if (= UI-HOVER id) (str ACCENT "33") "#00000000") :r 5})
                                                       (text 8 0 (- pw 36) 22 p {:size 11.5 :color C-TEXT :valign "middle" :font "mono"})]
                       {:tid "editor-open-item" :attrs {"file-path" p}})))
  (group 0 0 APP-W APP-H [(box 0 0 APP-W APP-H {:fill "#00000055"}) (group x y pw ph kids {})] {:k "pick"}))

(defn draw-dialog ()
  (var dw (min 400 (- APP-W 30))) (var dh 140) (var x (/ (- APP-W dw) 2)) (var y (/ (- APP-H dh) 2))
  (ui-offset x y)
  (var kids [(box 0 0 dw dh {:fill "#161d33fa" :r 10 :stroke (str ACCENT "77") :shadow 3})])
  (if (= DIALOG.kind "saveas")
    (do (push! kids (text 16 12 300 22 "保存为" {:size 14 :weight 700 :color C-TEXT}))
        (push! kids (field "dlg-field" 16 44 (- dw 32) 30 DIALOG.value {:tid "editor-saveas-input" :mono true}))
        (push! kids (button "dlg-ok" (- dw 170) (- dh 44) 74 30 "保存" {:primary true :tid "dialog-confirm"}))
        (push! kids (button "dlg-cancel" (- dw 88) (- dh 44) 74 30 "取消" {:tid "dialog-cancel"})))
    (do (push! kids (text 16 12 (- dw 32) 22 "保存修改？" {:size 14 :weight 700 :color C-TEXT}))
        (push! kids (text 16 40 (- dw 32) 40 (str (or PATH "未命名") " 有未保存的修改。") {:size 12 :color C-DIM :wrap true}))
        (push! kids (button "cf:save" 16 (- dh 44) 74 30 "保存" {:primary true :tid "dialog-confirm"}))
        (push! kids (button "cf:discard" 98 (- dh 44) 74 30 "放弃" {:tid "dialog-extra"}))
        (push! kids (button "cf:cancel" (- dw 90) (- dh 44) 74 30 "取消" {:tid "dialog-cancel"}))))
  (ui-offset (- x) (- y))
  (group 0 0 APP-W APP-H [(box 0 0 APP-W APP-H {:fill "#00000055"}) (group x y dw dh kids {})] {:k "dlg" :tid "dialog"}))

(app-open {:app "editor" :title "编辑器" :w 680 :h 460 :icon "editor"})
(if (get ARGS "path") (load (get ARGS "path")) (title!))
(set! APP-TIMEOUT 0.5)
(app-run {:render render :input on-input :key on-key :text on-text :close on-close
          :tick (fn () (poll-watch))
          :after (fn () nil)})
