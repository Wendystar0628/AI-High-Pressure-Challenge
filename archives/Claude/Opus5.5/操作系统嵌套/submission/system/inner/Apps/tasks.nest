;; =====================================================================
;; 子系统进程管理器：操作本系统自己的进程表与直属子系统
;; 进程：状态、本步工作量、额度、内核自身/内部（承载进程）、内存、剩余工作、消息与错误；
;;       挂起、继续、结束、调整额度。
;; 子系统：新建、暂停、继续、单步、调速、重启、快照、恢复、分叉、关闭、拨付上限与配额。
;; 配额：本系统总预算、内存与存储配额、新子系统拨付上限。
;; =====================================================================
(include "/System/lib/core.nest")
(include "/System/lib/ui.nest")
(include "/System/lib/app.nest")

(var INFO (ui-init))
(var SYSID INFO.id)
(var TAB (or (get ARGS "tab") "procs"))
(var PS []) (var KIDS []) (var SI INFO) (var SNAPS [])
(var SEL nil) (var EDITS {}) (var MSG "") (var SCROLL 0)
(var HI-SNAP (get ARGS "snapshot"))
(def TOP 40)

(defn refresh ()
  (set! PS (sys "ps"))
  (set! KIDS (sys "children"))
  (set! SI (sys "sysinfo"))
  (set! SNAPS (try (filter (fn (e) (ends-with? e.name ".snap")) (sys "list" "/Snapshots")) (catch e [])))
  (dirty!))

(defn note (s) (set! MSG s) (dirty!))
(defn edit-val (id dflt) (var v (get EDITS id)) (if (nil? v) (to-str dflt) v))
(defn num-of (id dflt) (var n (to-num (edit-val id dflt))) (if (nil? n) dflt n))
(defn act (label f)
  (try (var r (f)) (note (str label "：完成" (if (str? r) (str " " r) "")))
    (catch e (note (str label "失败：" (to-str e)))))
  (refresh))

(def KIND {"user" "程序" "app" "应用" "wm" "窗口管理" "host" "子系统承载" "service" "系统服务"})
(def ST {"ready" "就绪" "waiting" "等待" "suspended" "挂起" "done" "结束" "error" "异常" "loading" "载入中"
         "running" "运行中" "paused" "已暂停" "held" "随祖先暂停" "booting" "启动中" "kernel-error" "内核错误" "stopped" "已停止"})
(defn st-color (s) (case s (("ready" "running") C-OK) ("waiting" "#93c5fd") (("suspended" "paused" "held") C-WARN) (("error" "kernel-error") C-DANGER) (else C-FAINT)))

;; ---------------- 输入 ----------------
(defn on-input (ev view)
  (case ev.type
    ("wheel" (set! SCROLL (max 0 (+ SCROLL ev.dy))) (dirty!))
    ("down" (on-down (ui-hit ev.x ev.y)))
    (else nil)))

(defn on-down (id)
  (when (nil? id) (return nil))
  (var parts (split id "|"))
  (var a (first parts)) (var x (nth parts 1))
  (case a
    ("tab" (set! TAB x) (set! SCROLL 0) (dirty!))
    ("row" (set! SEL (to-num x)) (dirty!))
    ("suspend" (act "挂起" (fn () (sys "proc" SEL "suspend"))))
    ("resume" (act "继续" (fn () (sys "proc" SEL "resume"))))
    ("kill" (act "结束" (fn () (sys "proc" SEL "kill"))))
    ("quota" (act "设置额度" (fn () (sys "proc" SEL "quota" (num-of "quota" 0)))))
    ("new" (act "新建子系统" (fn () (sys "child" "new" nil nil))))
    (("pause" "resume-c" "step" "restart" "snapshot" "close" "stop")
     (var op (if (= a "resume-c") "resume" a))
     (act (case op ("pause" "暂停") ("resume" "继续") ("step" "单步") ("restart" "重启") ("snapshot" "快照") ("close" "关闭") (else "停止"))
          (fn () (sys "child" op x nil))))
    ("rate" (act "调速" (fn () (sys "child" "rate" x (to-num (nth parts 2))))))
    ("grant" (act "设置拨付" (fn () (sys "child" "config" x {:cap (num-of (str "grant-" x) 0) :budget (num-of (str "budget-" x) 0)
                                                               :mem (num-of (str "mem-" x) 0) :storage (num-of (str "sto-" x) 0)}))))
    ("kernel" (act "打开内核源文件" (fn () (sys "spawn" "/Apps/editor.nest" {:path x} {:kind "app" :detached true}))))
    ("restore" (act "恢复快照" (fn () (sys "child" "restore" x nil))))
    ("fork" (act "分叉" (fn () (sys "child" "fork" x nil))))
    ("conf" (act "更新配置" (fn () (sys "sysconf" x (num-of (str "conf-" x) 0)))))
    (else nil)))

(defn on-text (ev view) (put! EDITS ev.field (apply-text-edit (edit-val ev.field "") ev)))
(defn on-key (ev view)
  (when (and (= ev.key "Enter") ev.field)
    (var f ev.field)
    (cond ((= f "quota") (on-down "quota"))
          ((starts-with? f "conf-") (on-down (str "conf|" (substr f 5))))
          ((or (starts-with? f "grant-") (starts-with? f "budget-") (starts-with? f "mem-") (starts-with? f "sto-"))
           (on-down (str "grant|" (substr f (+ (index-of f "-") 1)))))
          (else nil))))

;; ---------------- 绘制 ----------------
(defn cell (x y w s o) (text x y w 22 s (merge {:size 11 :color C-TEXT :valign "middle"} (or o {}))))

(defn draw-procs (nodes y0)
  (var W APP-W) (var y y0)
  (var info (get SI "step-info"))
  (push! nodes (text 12 y (- W 24) 20 (str "本步预算 " (fmt-units info.budget) " · 实际使用 " (fmt-units info.used) "（内核自身 " (fmt-units info.kernel) "，进程 " (fmt-units info.procs) "）· 虚拟时间 " (fmt SI.time 1) " s")
                     {:size 11 :color C-DIM}))
  (inc! y 24)
  (var cols [["进程" 150] ["PID" 40] ["类型" 70] ["状态" 92] ["本步" 56] ["额度" 56] ["内核·内部" 96] ["内存" 70] ["剩余工作" 110] ["消息/错误" 300]])
  (var x 12)
  (each (c cols) (push! nodes (cell x y (nth c 1) (nth c 0) {:color C-DIM})) (inc! x (nth c 1)))
  (inc! y 24)
  (push! nodes (hline 12 (- y 2) (- W 24)))
  (var rows (filter (fn (p) (not (and (= p.kind "service") (= p.state "done")))) PS))
  (each (p rows)
    (when (< y (- APP-H 90))
      (var id (str "row|" p.pid)) (var sel (= SEL p.pid))
      (hit! id 8 y (- W 16) 24)
      (var rem (cond ((> p.pending 0) (str "未付完 " (fmt-units p.pending)))
                     (p.progress (str (nth p.progress 0) "/" (nth p.progress 1)))
                     (p.demand "待执行")
                     ((> p.qlen 0) (str "队列 " p.qlen))
                     (else "")))
      (var st (str (get-or ST p.state p.state) (if (and (= p.state "waiting") p.wait) (str "·" (case p.wait ("tick" "下一步") ("recv" "消息") ("sleep" "计时") (else p.wait))) "")))
      (var ki (if p.child (find (fn (c) (= c.id p.child)) KIDS) nil))
      (var vals [p.name (to-str p.pid) (get-or KIND p.kind p.kind) st (fmt-units p.last) (fmt-units p.quota)
                 (if ki (str (fmt-units ki.own) "·" (fmt-units ki.inner)) (if (> p.inner 0) (str (fmt-units p.own) "·" (fmt-units p.inner)) ""))
                 (fmt-bytes p.mem) rem (or p.error (if (> (len p.out) 0) (last p.out) ""))])
      (var kids [(box 0 0 (- W 16) 24 {:fill (cond (sel (str ACCENT "2a")) ((= UI-HOVER id) "#ffffff0b") (else "#00000000")) :r 5})])
      (var cx 4)
      (each-i (i c cols)
        (push! kids (cell cx 1 (- (nth c 1) 4) (nth vals i) {:color (cond ((= i 3) (st-color p.state)) ((and (= i 9) p.error) C-DANGER) (else C-TEXT))}))
        (inc! cx (nth c 1)))
      (push! nodes (group 8 y (- W 16) 24 kids {:tid "tasks-row" :attrs {"pid" p.pid "target-system-id" p.child} :label p.name :k (str "p" p.pid)}))
      (inc! y 25)))
  ;; 操作栏
  (var by (- APP-H 80))
  (push! nodes (hline 0 (- by 6) W))
  (var sp (find (fn (p) (= p.pid SEL)) PS))
  (push! nodes (label 12 by 220 28 (if sp (str "已选：" sp.name "（" sp.pid "）") "选择一个进程以操作") {}))
  (var bx 230)
  (each (b [["suspend" "挂起" "tasks-suspend" "pause"] ["resume" "继续" "tasks-resume" "play"] ["kill" "结束" "tasks-kill" "stop"]])
    (push! nodes (button (str (nth b 0) "|") bx by 70 28 (nth b 1) {:tid (nth b 2) :icon (nth b 3) :disabled (nil? sp)}))
    (inc! bx 76))
  (push! nodes (label bx by 54 28 "额度/步" {}))
  (push! nodes (field "quota" (+ bx 56) by 90 28 (edit-val "quota" (if sp sp.quota "")) {:tid "tasks-quota" :label "进程额度"}))
  (push! nodes (button "quota|" (+ bx 152) by 60 28 "设置" {:tid "tasks-set-quota" :disabled (nil? sp)}))
  (when (and sp (> (len sp.out) 0))
    (push! nodes (text 12 (+ by 32) (- W 24) 36 (join (slice sp.out (max 0 (- (len sp.out) 2))) "   ") {:size 10.5 :font "mono" :color C-DIM :wrap true}))))

(defn draw-children (nodes y0)
  (var W APP-W) (var y y0)
  (push! nodes (button "new|" 12 y 130 28 "新建子系统" {:primary true :icon "system" :tid "system-new"}))
  (push! nodes (label 152 y (- W 170) 28 "暂停/单步作用于整棵子树；单步 = 本系统逻辑时间 1/60 秒" {:size 11}))
  (inc! y 38)
  (when (= (len KIDS) 0) (push! nodes (label 12 y 400 24 "还没有直属子系统" {})) (inc! y 30))
  (each (c KIDS)
    (var attrs {"target-system-id" c.id})
    (push! nodes (panel 8 y (- W 16) 112 {}))
    (push! nodes (chip 18 (+ y 8) (str "L" (+ DEPTH 1)) (nth LEVEL-COLORS (% DEPTH (len LEVEL-COLORS)))))
    (push! nodes (text 58 (+ y 6) 240 22 (str c.id " · " c.name) {:size 13 :weight 700 :color C-TEXT}))
    (push! nodes (chip 300 (+ y 8) (get-or ST c.state c.state) (st-color c.state)))
    (push! nodes (text 400 (+ y 6) (- W 420) 22 (str "本步 " (fmt-units c.last) "（内核 " (fmt-units c.own) " · 内部 " (fmt-units c.inner) "） 内存 " (fmt-bytes c.memUsed) " 磁盘 " (fmt-bytes c.disk) " 后代 " (len c.subtree))
                       {:size 11 :color C-DIM}))
    (var bx 18) (var by (+ y 34))
    (var btns [(if (= c.state "paused") ["resume-c" "继续" "system-resume" "play"] ["pause" "暂停" "system-pause" "pause"])
               ["step" "单步" "system-step" "step"] ["restart" "重启" "system-restart" "restart"] ["snapshot" "快照" "system-snapshot" "camera"]
               ["kernel" "内核源文件" "kernel-open" "kernel"] ["close" "关闭" "system-close" "close"]])
    (each (b btns)
      (var w (+ 34 (text-w (nth b 1) 12)))
      (push! nodes (button (str (nth b 0) "|" (if (= (nth b 0) "kernel") c.kernel c.id)) bx by w 26 (nth b 1) {:tid (nth b 2) :icon (nth b 3) :attrs attrs}))
      (inc! bx (+ w 4)))
    (each (r [0.25 0.5 1 2 4])
      (push! nodes (button (str "rate|" c.id "|" r) bx by 40 26 (str r "×") {:active (= c.rate r) :tid "system-rate" :attrs (merge attrs {"value" r})}))
      (inc! bx 42))
    (var fy (+ y 70)) (var fx 18)
    (each (f [["grant-" "拨付上限" c.cap "tasks-grant"] ["budget-" "总预算" c.budget "tasks-child-budget"] ["mem-" "内存" c.mem "tasks-child-memory"] ["sto-" "存储" c.storage "tasks-child-storage"]])
      (push! nodes (label fx fy 56 28 (nth f 1) {}))
      (push! nodes (field (str (nth f 0) c.id) (+ fx 56) fy 100 28 (edit-val (str (nth f 0) c.id) (nth f 2)) {:tid (nth f 3) :attrs attrs :label (str c.id " " (nth f 1))}))
      (inc! fx 166))
    (push! nodes (button (str "grant|" c.id) fx fy 60 28 "应用" {:primary true :tid "tasks-child-apply" :attrs attrs}))
    (inc! y 120))
  ;; 快照
  (inc! y 6)
  (push! nodes (text 12 y 300 22 "子树快照（/Snapshots）" {:size 13 :weight 700 :color C-TEXT}))
  (inc! y 26)
  (when (= (len SNAPS) 0) (push! nodes (label 12 y 400 22 "还没有快照" {})))
  (each (s SNAPS)
    (when (< y (- APP-H 30))
      (push! nodes (group 8 y (- W 16) 28 [(box 0 0 (- W 16) 28 {:fill (if (= HI-SNAP s.path) (str ACCENT "22") "#ffffff08") :r 6})
                                           (icon 8 6 16 "snapshot" {})
                                           (text 30 0 300 28 s.path {:size 11.5 :color C-TEXT :valign "middle" :font "mono"})
                                           (text 330 0 100 28 (fmt-bytes s.size) {:size 11 :color C-DIM :valign "middle"})] {}))
      (push! nodes (button (str "restore|" s.path) (- W 210) (+ y 2) 96 24 "恢复到原实例" {:tid "snapshot-restore" :attrs {"file-path" s.path}}))
      (push! nodes (button (str "fork|" s.path) (- W 110) (+ y 2) 90 24 "分叉新子树" {:tid "snapshot-fork" :attrs {"file-path" s.path}}))
      (inc! y 32))))

(defn draw-conf (nodes y0)
  (var y y0) (var conf SI.conf)
  (push! nodes (text 12 y (- APP-W 24) 40 "计量：一条 Nest 指令 = 1 单位；复制、拼接、解析、文件与显示提交按数据规模计费。本系统每步可用预算 = min(父系统实际拨付, 本系统总预算)。" {:size 11 :color C-DIM :wrap true}))
  (inc! y 46)
  (each (f [["budget" "本系统总预算（单位/步）" "tasks-budget"] ["mem" "内存配额（字节）" "tasks-memory"] ["storage" "存储配额（字节）" "tasks-storage"]
            ["child-cap" "新子系统默认拨付上限" "tasks-child-cap"] ["proc-quota" "新进程默认额度" "tasks-proc-quota"]])
    (push! nodes (label 12 y 190 28 (nth f 1) {:color C-TEXT}))
    (push! nodes (field (str "conf-" (nth f 0)) 206 y 150 28 (edit-val (str "conf-" (nth f 0)) (get conf (nth f 0))) {:tid (nth f 2) :label (nth f 1)}))
    (push! nodes (button (str "conf|" (nth f 0)) 362 y 60 28 "应用" {:tid (str (nth f 2) "-apply")}))
    (inc! y 36))
  (var info (get SI "step-info"))
  (inc! y 6)
  (push! nodes (text 12 y (- APP-W 24) 60 (str "父系统本步拨付 " (fmt-units info.budget) "；实际使用 " (fmt-units info.used) "；存储已用 " (fmt-bytes SI.storage) " / " (fmt-bytes conf.storage)
                                               "；内核内存 " (fmt-bytes SI.mem) "；进程数 " SI.procs) {:size 11.5 :color C-TEXT :wrap true})))

(defn render ()
  (ui-begin)
  (var W APP-W)
  (var nodes [(box 0 0 W APP-H {:fill C-BG}) (box 0 0 W TOP {:fill "#ffffff06"}) (hline 0 (- TOP 1) W)])
  (var x 10)
  (each (t [["procs" "进程"] ["kids" "子系统与快照"] ["conf" "预算与配额"]])
    (var w (+ 30 (text-w (nth t 1) 12)))
    (push! nodes (button (str "tab|" (first t)) x 6 w 28 (nth t 1) {:active (= TAB (first t)) :tid (str "tasks-tab-" (first t))}))
    (inc! x (+ w 6)))
  (push! nodes (text (+ x 10) 6 (- W x 20) 28 (str SYSID " · 第 " DEPTH " 层 · " MSG) {:size 11 :color C-DIM :valign "middle" :align "right"}))
  (case TAB
    ("procs" (draw-procs nodes (+ TOP 8)))
    ("kids" (draw-children nodes (+ TOP 10)))
    (else (draw-conf nodes (+ TOP 10))))
  (app-display nodes {:kind "tasks" :tab TAB}))

(app-open {:app "tasks" :title "进程管理器" :w 820 :h 470 :icon "tasks"})
(refresh)
(set! APP-TIMEOUT 0.6)
(app-run {:render render :input on-input :key on-key :text on-text
          :tick (fn () (refresh))
          :msg (fn (m) (when (= m.k "args") (set! TAB (or m.tab TAB)) (dirty!)))})
