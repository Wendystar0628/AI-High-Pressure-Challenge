// ============================================================================
// 预置示例程序 4：持续计算程序 (/Programs/spin.nos)
// 说明：在死循环中持续进行数值运算，绝不调用 sleep 或 yield 主动让出执行权！
// 用于检验内核时间片抢占调度、多进程公平竞争以及高负载对飞控周期的实际影响。
// ============================================================================

fn main() {
  let rounds = 0;
  let acc = 1.0;
  while (true) {
    let k = 0;
    while (k < 250) {
      acc = acc * 1.000001 + 0.0001;
      if (acc > 10000.0) { acc = 1.0; }
      k += 1;
    }
    rounds += 1;
    if (rounds % 8 == 0) {
      syscall("report_result", "持续抢占计算中 · 已完成批次=" + str(rounds) + " · 校验值=" + str(round(acc * 100) / 100));
    }
  }
}
