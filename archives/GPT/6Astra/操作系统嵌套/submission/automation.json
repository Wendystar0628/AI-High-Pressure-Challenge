{
  "version": 1,
  "launch": {
    "command": "npm",
    "args": [
      "start",
      "--",
      "--data-dir",
      "{dataDir}",
      "--width",
      "{width}",
      "--height",
      "{height}",
      "--remote-debugging-port={port}"
    ],
    "cwd": "."
  },
  "mainWindow": {
    "title": "栖境 NEST OS"
  },
  "automation": {
    "type": "CDP",
    "port": 19106,
    "context": "main renderer; native Electron webview guest contexts for external sites"
  },
  "fixtures": {
    "outer": {
      "workbook": "/Demo/sample.sheet",
      "chartRange": "A1:D4",
      "helicopter": "/Demo/helicopter-24.scene",
      "documents": "/Documents",
      "kernel": "/System/{systemId}.kernel.nest",
      "compiler": "/System/compiler.nest",
      "controller": "/Programs/flight-control.nest"
    },
    "inner": {
      "helicopter": "/Demo/helicopter-24.scene",
      "documents": "/Documents",
      "compiler": "/System/compiler.nest",
      "controller": "/Programs/flight-control.nest",
      "programs": "/Programs",
      "windowManager": "/System/window-manager.nest",
      "playerProgram": "/System/player.nest",
      "sceneProgram": "/System/flight-scene.nest",
      "effectsProgram": "/System/effects.nest",
      "chartProgram": "/System/charts.nest",
      "receiverProgram": "/System/data-receiver.nest",
      "fileManager": "/System/files.nest",
      "snapshotProgram": "/System/snapshot.nest"
    }
  }
}
